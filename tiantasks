  const lvl = {high: 3, med: 2, low: 1}[p];
  const bar = (x, h, n) => `<rect x="${x}" y="${14 - h}" width="3" height="${h}" rx="1" fill="currentColor" opacity="${n <= lvl ? 1 : .22}"/>`;
  return `<svg class="pi pi-${p}" viewBox="0 0 16 16" role="img" aria-label="Priority ${p}"><title>${p}</title>${bar(1.5, 5, 1)}${bar(6.5, 8.5, 2)}${bar(11.5, 12, 3)}</svg>`;
