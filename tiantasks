async function modalSave(ch) {
  if (!M || !M.item) return;
  try { M.item = await api('PATCH', `/api/items/${M.item.ref}`, ch, true); }
  catch (err) { toast(err.message, 'err'); }
  await loadModal();
  refresh(true);
}

async function uploadToTicket(files) {
  files = imagesFrom(files);
  if (!M || !M.item || !files.length) return;
  const id = M.item.id;
  M.uploading += files.length; renderModal();
  let ok = 0;
  for (const f of files) {
    try { await uploadImage(id, f); ok++; }
    catch (err) { toast(err.message, 'err'); }
    finally { if (M) M.uploading--; }
  }
  if (ok) toast(ok === 1 ? 'Screenshot attached' : `${ok} screenshots attached`);
  await loadModal();
  refresh(true);
}

async function copyText(text, msg) {
  try { await navigator.clipboard.writeText(text); }
  catch {
    const t = document.createElement('textarea');
    t.value = text; t.style.position = 'fixed'; t.style.opacity = '0';
    tkt.append(t); t.select(); document.execCommand('copy'); t.remove();
  }
  toast(msg || 'Copied');
}

tkt.addEventListener('click', async e => {
  if (e.target.closest('a')) return;
  const el = e.target.closest('[data-t], [data-act]');
  if (!el || !M) return;
  const act = el.dataset.t || el.dataset.act;
  const it = M.item;
  if (act === 'close') return tkt.close();
  if (!it) return;
  const id = it.id;
  if (act === 'editDesc') { M.editDesc = true; return renderModal(); }
  if (act === 'cancelDesc') { M.editDesc = false; return renderModal(); }
  if (act === 'saveDesc') { const v = $('#tkt [data-tf=body]').value; M.editDesc = false; return modalSave({body: v}); }
  if (act === 'status') {
    const st = el.dataset.status;
    if (st !== it.status) return modalSave({status: st, ...(st === 'doing' && !it.assignee ? {assignee: S.me} : {})});
    return;
  }
  if (act === 'resolve') return modalSave({status: 'done', note: $('#tkt [data-tf=resolve]').value});
  if (act === 'pick') { pickTarget = 'tkt'; return $('#filePick').click(); }
  if (act === 'zoom') { $('#lightbox img').src = el.dataset.src; $('#lightbox img').alt = el.title; return $('#lightbox').showModal(); }
  if (act === 'delShot') {
    if (!confirm('Remove this screenshot?')) return;
    await api('DELETE', `/api/attachments/${el.dataset.att}`);
    await loadModal(); return refresh(true);
  }
  if (act === 'sendFlag') {
    const ta = $('#tkt [data-tf=flag]'); const text = ta.value.trim();
    if (!text) return ta.focus();
    try { await sendFlag('ref:' + it.ref, text, $('#tkt [data-tf=urgent]').checked); }
    catch (err) { return toast(err.message, 'err'); }
    await loadModal(); return refresh(true);
  }
  if (act === 'copyLink') return copyText(`${location.origin}${location.pathname}#${view}/${it.ref}`, 'Link copied');
  if (act === 'copyPrompt') return copyText(agentPrompt(it), 'Prompt copied. Paste it into Claude Code.');
  if (act === 'toAgent') {   // copy first: Safari only allows clipboard writes inside the click itself
    copyText(agentPrompt(it), `Assigned to ${myAgent()} · prompt copied`);
    return modalSave({assignee: myAgent()});
  }
  if (act === 'delete') {
    if (!confirm(`Delete ${it.ref} “${it.title}”? This can't be undone.`)) return;
    await api('DELETE', `/api/items/${it.ref}`);
    tkt.close(); toast(`Deleted ${it.ref}`); return refresh(true);
  }
  if (act === 'comment') {
    const t = $('#tkt [data-tf=comment]'); const v = t.value.trim();
    if (!v) { t.focus(); return; }
    await api('POST', `/api/items/${it.ref}/comment`, {text: v});
    M.draft = '';
    await loadModal(); return refresh(true);
  }
  // comment threads (the same threads the queues used to show inline)
  if (act === 'fold') { const c = +el.dataset.cid; openThreads.has(c) ? openThreads.delete(c) : openThreads.add(c); return renderModal(); }
  if (act === 'reply') { replyingTo.set(id, +el.dataset.cid); openThreads.add(+el.dataset.cid); focusReply = true; return renderModal(); }
  if (act === 'cancelReply') { replyingTo.delete(id); return renderModal(); }
  if (act === 'sendReply') {
    const v = $('#tkt [data-f=reply]').value.trim(); if (!v) return;
    await api('POST', `/api/items/${it.ref}/comment`, {text: v, parent_id: +el.dataset.cid});
    replyingTo.delete(id); openThreads.add(+el.dataset.cid);
    await loadModal(); return refresh(true);
  }
  if (act === 'delComment') {
    if (!confirm('Delete this comment for everyone? Replies to it stay.')) return;
    await api('DELETE', `/api/comments/${el.dataset.cid}`);
    await loadModal(); return refresh(true);
  }
});

tkt.addEventListener('keydown', e => {
  const t = e.target, f = t.dataset && t.dataset.tf;
  if (f === 'title' && e.key === 'Enter') { e.preventDefault(); t.blur(); }
  else if (f === 'title' && e.key === 'Escape') { e.preventDefault(); t.value = M.item.title; t.blur(); }
  else if (f === 'body' && e.key === 'Escape') { e.preventDefault(); M.editDesc = false; renderModal(); }
  else if (f === 'body' && e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); $('#tkt [data-t=saveDesc]').click(); }
  else if (f === 'comment' && e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); $('#tkt [data-t=comment]').click(); }
  else if (f === 'resolve' && e.key === 'Enter') { e.preventDefault(); $('#tkt [data-t=resolve]').click(); }
  else if (t.matches('.md[data-t=editDesc]') && e.key === 'Enter') { e.preventDefault(); M.editDesc = true; renderModal(); }
});
tkt.addEventListener('input', e => {
  const f = e.target.dataset.tf;
  if (f === 'title') autosize(e.target);
  if (f === 'comment' && M) M.draft = e.target.value;
});
tkt.addEventListener('focusout', e => {
  const t = e.target;
  if (!M || !M.item || t.dataset.tf !== 'title') return;
  if (t.value.trim() && t.value.trim() !== M.item.title) modalSave({title: t.value});
  else t.value = M.item.title;
});
tkt.addEventListener('change', e => {
  const t = e.target, f = t.dataset.tf;
  if (!M || !M.item) return;
  if (f === 'assignee') modalSave({assignee: t.value});
  if (f === 'priority') modalSave({priority: t.value});
  if (f === 'project' && t.value.trim()) modalSave({project: t.value.trim()});
  if (f === 'tags') modalSave({tags: t.value});
  if (f === 'initiative') modalSave({fields: {initiative: t.value.trim()}});
  if (f === 'note') modalSave({note: t.value});
});
let dragDepth = 0;
const hasFiles = e => e.dataTransfer && [...e.dataTransfer.types].includes('Files');
tkt.addEventListener('dragenter', e => { if (hasFiles(e)) { dragDepth++; $('#mwrap').classList.add('dropping'); } });
tkt.addEventListener('dragleave', () => { if (--dragDepth <= 0) { dragDepth = 0; $('#mwrap').classList.remove('dropping'); } });
tkt.addEventListener('dragover', e => { if (hasFiles(e)) e.preventDefault(); });
tkt.addEventListener('drop', e => {
  dragDepth = 0; $('#mwrap').classList.remove('dropping');
  if (!hasFiles(e)) return;
  e.preventDefault();
  uploadToTicket(e.dataTransfer.files);
});

// ---------------------------------------------------------------- team: people, agents, initiatives
const OFFLINE_AFTER = 10 * 60 * 1000;   // an agent nobody has heard from in 10 minutes is offline
const agentOf = n => (S.agents || []).find(a => a.name === n);
const since = iso => iso ? Date.now() - new Date(iso).getTime() : Infinity;
function agentState(a) {
  if (!a) return '';
  if (since(a.last_seen) > OFFLINE_AFTER) return 'offline';
  return a.state || 'idle';
}
const stateDot = a => { const st = agentState(a); return `<span class="sdot s-${st}" title="${st}"></span>`; };
const personName = n => n ? n[0].toUpperCase() + n.slice(1) : '';
const initOf = slug => (S.initiatives || []).find(i => i.slug === slug);
const initTitle = slug => (initOf(slug) || {}).title || slug;
const cpsFor = (key, val) => (S.checkpoints || []).filter(c => c[key] === val);   // newest first
const openFlag = f => ['sent', 'delivered', 'failed', 'escalated'].includes(f.status);
const needsMe = () => (S.flags || []).filter(f => f.to_name === S.me && openFlag(f));
// "master-courtapp-eval-flows · Oliver's" — who an agent is and whose account it runs on.
function whoTag(name) {
  const a = agentOf(name);
  if (!a || !a.principal || a.principal === name) return `<b>${esc(name)}</b>`;
  return `<b>${esc(name)}</b> <span class="help">(${esc(personName(a.principal))}'s)</span>`;
}
function linkOut(url) {
  return /^https?:\/\//.test(url || '') ? ` <a href="${esc(url)}" target="_blank" rel="noopener">${esc(url.replace(/^https?:\/\//, '').slice(0, 40))}</a>` : '';
}
let flagOpen = null;   // name of the agent or initiative whose flag box is open on the team page

function flagBox(key) {
  return `<div class="flagbox" data-flagbox="${esc(key)}">
    <textarea data-flagtext placeholder="Change of plan, correction, question… it goes straight into the chat"></textarea>
    <div class="bar2"><label class="chk"><input type="checkbox" data-flagurgent> Urgent (also tell their person)</label><span class="grow"></span>
      <button data-flagcancel>Cancel</button><button class="primary" data-flagsend>Send flag</button></div></div>`;
}

function agentCard(a) {
  const st = agentState(a);
  const cp = a.initiative ? cpsFor('initiative', a.initiative)[0] : null;
  const waiting = (S.flags || []).filter(f => f.to_name === a.name && openFlag(f)).length;
  return `<article class="acard s-${st}">
    <div class="ac-top">${stateDot(a)}<span class="ac-name" title="${esc(a.name)}">${esc(a.name)}</span>${a.kind ? `<span class="akind">${esc(a.kind)}</span>` : ''}
      <span class="grow"></span><span class="help" title="last heard from">${ago(a.last_seen)}</span></div>
    ${a.initiative ? `<div><span class="ichip">${esc(initTitle(a.initiative))}</span></div>` : ''}
    ${a.doing ? `<div class="ac-doing">${esc(a.doing)}</div>` : ''}
    ${cp ? `<div class="ac-cp">${esc(cp.text)}${linkOut(cp.link)} <span class="help">· ${ago(cp.at)}</span></div>` : ''}
    ${flagOpen === 'agent:' + a.name ? flagBox('agent:' + a.name) : `<div class="ac-foot">
      ${waiting ? `<span class="kc-flag">${waiting} flag${waiting > 1 ? 's' : ''} waiting</span>` : ''}<span class="grow"></span>
      <button data-flagopen="agent:${esc(a.name)}">Flag</button></div>`}
  </article>`;
}

function initCard(i) {
  const cps = cpsFor('initiative', i.slug);
  const a = agentOf(i.owner);
  const tix = S.items.filter(t => (t.fields || {}).initiative === i.slug && t.status !== 'done');
  return `<article class="icard">
    <div class="ic-top"><h3>${esc(i.title)}</h3><span class="help">${esc(i.project)}</span><span class="grow"></span>
      ${i.status !== 'active' ? `<span class="akind">${esc(i.status)}</span>` : ''}</div>
    <div class="owner">${i.owner ? `${a ? stateDot(a) : ''} Run by ${whoTag(i.owner)} · ${a ? agentState(a) : 'not reporting'}` : 'No chat runs this yet'}</div>
    ${i.summary ? `<div class="ac-doing">${esc(i.summary)}</div>` : ''}
    ${cps[0] ? `<div class="ac-cp">${esc(cps[0].text)}${linkOut(cps[0].link)} <span class="help">· ${ago(cps[0].at)}</span></div>` : '<div class="help">No milestones yet.</div>'}
    ${cps.length > 1 ? `<ol class="steps">${cps.slice(1, 5).map(c => `<li class="${c.source === 'auto' ? 'auto' : ''}">${esc(c.text)} · ${ago(c.at)}</li>`).join('')}</ol>` : ''}
    ${tix.length ? `<div class="ic-tix">${tix.slice(0, 12).map(t => `<a href="#" class="xref" data-ref="${t.ref}" title="${esc(t.title)}">${t.ref}</a>`).join('')}</div>` : ''}
    ${flagOpen === 'init:' + i.slug ? flagBox('init:' + i.slug) : `<div class="ac-foot"><span class="grow"></span>${i.owner ? `<button data-flagopen="init:${esc(i.slug)}">Flag</button>` : ''}</div>`}
  </article>`;
}

function renderTeam() {
  const needs = needsMe();
  let html = '';
  if (needs.length) {
    html += `<div class="team-h"><h2>Needs you <span class="alert views">${needs.length}</span></h2></div><div class="needs">${needs.map(f => `
      <div class="need" data-need="${f.id}">
        <div class="need-h">${avatar(f.from_actor)} ${whoTag(f.from_actor)} ${f.kind === 'ask' ? 'asks' : 'flagged'}
          ${f.ref ? `<a href="#" class="xref" data-ref="${f.ref}">${f.ref}</a>` : ''}${f.initiative ? `<span class="ichip">${esc(initTitle(f.initiative))}</span>` : ''}
          <span>· ${ago(f.created_at)}</span>${f.urgent ? '<span class="urgent">urgent</span>' : ''}</div>
        <div class="md">${md(f.text)}</div>
        <div class="need-a"><input data-answer="${f.id}" placeholder="Answer: goes straight back into ${esc(f.from_actor)}"><button class="primary" data-answersend="${f.id}">Send</button><button data-needdone="${f.id}" title="Mark handled without answering">Done</button></div>
      </div>`).join('')}</div>`;
  }
  const agents = S.agents || [];
  const byPerson = new Map((S.people || [S.me]).map(p => [p, []]));
  agents.forEach(a => { const p = a.principal || '?'; if (!byPerson.has(p)) byPerson.set(p, []); byPerson.get(p).push(a); });
  const order = {working: 0, waiting: 1, idle: 2, offline: 3};
  for (const [person, list] of byPerson) {
    const sorted = list.filter(a => agentState(a) !== 'offline').sort((x, y) => order[agentState(x)] - order[agentState(y)] || x.name.localeCompare(y.name));
    // Auditors/assistants shadow a master; they fold away so the masters stay readable.
    const live = sorted.filter(a => a.kind !== 'assistant');
    const helpers = sorted.filter(a => a.kind === 'assistant');
    const gone = list.filter(a => agentState(a) === 'offline');
    const working = live.filter(a => agentState(a) === 'working').length;
    html += `<div class="team-h"><h2>${avatar(person, true)} ${esc(personName(person))}</h2><span class="count">${live.length} chat${live.length === 1 ? '' : 's'} live${working ? ` · ${working} working` : ''}</span></div>`;
    html += live.length ? `<div class="agents">${live.map(agentCard).join('')}</div>`
      : `<div class="empty-team">No chats reporting for ${esc(personName(person))}.${person === S.me ? ' Chats appear here once the box adapter runs, or when one uses <code>tt</code>.' : ''}</div>`;
    if (helpers.length) html += `<details class="offline"><summary>${helpers.length} assistant${helpers.length === 1 ? '' : 's'} (auditors)</summary><div class="agents" style="margin-top:8px">${helpers.map(agentCard).join('')}</div></details>`;
    if (gone.length) html += `<details class="offline"><summary>${gone.length} offline</summary><div class="agents" style="margin-top:8px">${gone.map(agentCard).join('')}</div></details>`;
  }
  const inits = (S.initiatives || []).filter(i => i.status !== 'done' && (!project || i.project === project));
  html += `<div class="team-h"><h2>Initiatives</h2><span class="count">${inits.length}</span></div>`;
  html += inits.length ? `<div class="inits">${inits.map(initCard).join('')}</div>` : '<div class="empty-team">No initiatives yet.</div>';
  $('#team').innerHTML = html;
}

async function sendFlag(key, text, urgent) {
  const [kind, name] = [key.slice(0, key.indexOf(':')), key.slice(key.indexOf(':') + 1)];
  const body = kind === 'agent' ? {to: name, text, urgent} : kind === 'init' ? {initiative: name, text, urgent} : {ref: name, text, urgent};
  const f = await api('POST', '/api/flags', body, true);
  toast(`Flag sent to ${f.to_name}`);
  return f;
}

$('#vTeam').addEventListener('click', async e => {
  const t = e.target;
  const open = t.closest('[data-flagopen]');
  if (open) { flagOpen = open.dataset.flagopen; renderTeam(); const ta = $('#vTeam [data-flagtext]'); if (ta) ta.focus(); return; }
  if (t.closest('[data-flagcancel]')) { flagOpen = null; return renderTeam(); }
  if (t.closest('[data-flagsend]')) {
    const box = t.closest('[data-flagbox]');
    const text = $('[data-flagtext]', box).value.trim();
    if (!text) return $('[data-flagtext]', box).focus();
    try { await sendFlag(box.dataset.flagbox, text, $('[data-flagurgent]', box).checked); flagOpen = null; }
    catch (err) { return toast(err.message, 'err'); }
    return refresh(true);
  }
  const ans = t.closest('[data-answersend]');
  if (ans) {
    const f = S.flags.find(x => x.id === +ans.dataset.answersend);
    const input = $(`#vTeam [data-answer="${f.id}"]`);
    const text = input.value.trim();
    if (!text) return input.focus();
    try {
      await api('POST', '/api/flags', {to: f.from_actor, text, ref: f.ref, initiative: f.initiative}, true);
      await api('PATCH', `/api/flags/${f.id}`, {status: 'acked', note: text}, true);
      toast(`Answer sent to ${f.from_actor}`);
    } catch (err) { return toast(err.message, 'err'); }
    return refresh(true);
  }
  const done = t.closest('[data-needdone]');
  if (done) {
    try { await api('PATCH', `/api/flags/${done.dataset.needdone}`, {status: 'acked'}, true); } catch (err) { return toast(err.message, 'err'); }
    return refresh(true);
  }
});
$('#vTeam').addEventListener('keydown', e => {
  if (e.key === 'Enter' && e.target.dataset.answer !== undefined) { e.preventDefault(); $(`#vTeam [data-answersend="${e.target.dataset.answer}"]`).click(); }
  if (e.key === 'Enter' && (e.metaKey || e.ctrlKey) && e.target.dataset.flagtext !== undefined) { e.preventDefault(); e.target.closest('[data-flagbox]').querySelector('[data-flagsend]').click(); }
  if (e.key === 'Escape' && e.target.dataset.flagtext !== undefined) { flagOpen = null; renderTeam(); }
});

// ---- the ticket modal's progress card and flags
function progressHTML(it) {
  const cps = M.checkpoints || [];
  const a = agentOf(it.assignee);
  const slug = (it.fields || {}).initiative;
  if (!cps.length && !a && !slug) return '';
  return `<div class="pcard">
    <div class="owner">${it.assignee ? `${a ? stateDot(a) : ''}${whoTag(it.assignee)}${a ? ` · ${agentState(a)} · heard from ${ago(a.last_seen)}` : ''}` : 'Nobody has this yet'}
      ${slug ? `<span class="grow"></span><span class="ichip">${esc(initTitle(slug))}</span>` : ''}</div>
    ${a && a.doing ? `<div class="ac-doing">${esc(a.doing)}</div>` : ''}
    ${cps[0] ? `<div class="pc-latest">${esc(cps[0].text)}${linkOut(cps[0].link)} <span class="help">· ${ago(cps[0].at)} · ${esc(cps[0].actor)}</span></div>`
      : '<div class="pc-latest none">No milestones posted yet.</div>'}
    ${cps.length > 1 ? `<ol class="steps">${cps.slice(1, 6).map(c => `<li class="${c.source === 'auto' ? 'auto' : ''}">${esc(c.text)} · ${ago(c.at)}</li>`).join('')}</ol>` : ''}
  </div>`;
}

function receipt(f) {
  const steps = [['sent', f.created_at], ['delivered', f.delivered_at], ['acknowledged', f.acked_at]];
  const bad = f.status === 'failed' ? '<span class="bad">not delivered</span>' : f.status === 'escalated' ? '<span class="bad">escalated to their person</span>' : '';
  return `<div class="rcpt">${steps.map(([l, t]) => `<span class="${t ? 'on' : ''}" title="${t ? esc(fullDate(t)) : ''}">${l}</span>`).join(' → ')}${bad ? ' · ' + bad : ''}${f.status === 'closed' ? ' · closed' : ''}</div>`;
}

function flagsHTML(it) {
  const list = M.flags || [];
  const owner = it.assignee || (initOf((it.fields || {}).initiative) || {}).owner || '';
  return `<div class="prop full"><span class="lbl">Flag ${owner ? esc(owner) : 'the owner'}</span>
    <div class="flagbox"><textarea data-tf="flag" rows="2" placeholder="${owner ? 'Goes straight into their chat. They acknowledge it here.' : 'Assign this (or put it in an initiative) so a flag has somewhere to go.'}"></textarea>
      <div class="bar2"><label class="chk"><input type="checkbox" data-tf="urgent"> Urgent</label><span class="grow"></span><button data-t="sendFlag">Send flag</button></div></div>
    ${list.length ? `<div class="flags-l">${list.map(f => `<div class="fl">
      <div class="fl-t">${f.kind === 'ask' ? '❓ ' : ''}${esc(f.text)}</div>
      <div class="help">F-${f.id} · ${esc(f.from_actor)} → ${esc(f.to_name)}${f.urgent ? ' · <span class="urgent">urgent</span>' : ''}</div>
      ${receipt(f)}${f.note ? `<div class="fl-note">${esc(f.note)}</div>` : ''}</div>`).join('')}</div>` : ''}
  </div>`;
}

// ---- theme: Auto (follows the system) → Dark → Light
const THEMES = [['auto', '◐', 'Theme: auto (follows your system)'], ['dark', '☾', 'Theme: dark'], ['light', '☀', 'Theme: light']];
function showTheme() {
  const cur = document.documentElement.dataset.theme || 'auto';
  const [, icon, label] = THEMES.find(t => t[0] === cur);
  $('#themeBtn').textContent = icon; $('#themeBtn').title = label + ' · click to change';
}
$('#themeBtn').addEventListener('click', () => {
  const cur = document.documentElement.dataset.theme || 'auto';
  const next = THEMES[(THEMES.findIndex(t => t[0] === cur) + 1) % THEMES.length][0];
  if (next === 'auto') delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = next;
  saved.set('theme', next === 'auto' ? '' : next);
  showTheme();
});
showTheme();

setInterval(tick, 4000);
setInterval(() => { if (S && !document.hidden && !typing()) render(); }, 60000);  // keep "5m ago" fresh
document.addEventListener('visibilitychange', tick);
(async () => { await tick(); route(); })();
</script>
</body>
</html>
"""

