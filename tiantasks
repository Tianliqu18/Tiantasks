VERSION = "2.3.0"
DEFAULT_DB = Path.home() / ".tiantasks" / "tiantasks.db"
CONFIG = Path.home() / ".tiantasks" / "config.json"
DEFAULT_PORT = int(os.environ.get("TIANTASKS_PORT", 7777))
PRIORITIES = ("crit", "high", "med", "low")
PRANK = {p: i for i, p in enumerate(PRIORITIES)}
STATUSES = ("open", "doing", "done")
MAX_ATTACHMENT = 1_500_000  # a D1 row tops out at 2MB; the page shrinks screenshots to fit
INLINE_TYPES = {"image/png", "image/jpeg", "image/gif", "image/webp"}

SCHEMA = """
CREATE TABLE IF NOT EXISTS items (
  id          INTEGER PRIMARY KEY,
  kind        TEXT NOT NULL CHECK (kind IN ('task', 'issue')),
  num         INTEGER NOT NULL,
  project     TEXT NOT NULL,
  title       TEXT NOT NULL,
  body        TEXT NOT NULL DEFAULT '',
  status      TEXT NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'doing', 'done')),
  priority    TEXT NOT NULL DEFAULT '',
  tags        TEXT NOT NULL DEFAULT '[]',
  assignee    TEXT NOT NULL DEFAULT '',
  note        TEXT NOT NULL DEFAULT '',
  created_by  TEXT NOT NULL DEFAULT '',
  created_at  TEXT NOT NULL,
  updated_at  TEXT NOT NULL,
  resolved_at TEXT,
  UNIQUE (kind, num)
);
CREATE TABLE IF NOT EXISTS events (
  id      INTEGER PRIMARY KEY,
  item_id INTEGER NOT NULL,
  ref     TEXT NOT NULL,
  title   TEXT NOT NULL,
  project TEXT NOT NULL,
  at      TEXT NOT NULL,
  actor   TEXT NOT NULL,
  action  TEXT NOT NULL,
  detail  TEXT NOT NULL DEFAULT ''
);
CREATE INDEX IF NOT EXISTS events_item ON events (item_id);
CREATE TABLE IF NOT EXISTS attachments (
  id         INTEGER PRIMARY KEY AUTOINCREMENT,
  item_id    INTEGER NOT NULL,
  name       TEXT NOT NULL,
  mime       TEXT NOT NULL,
  size       INTEGER NOT NULL,
  data       BLOB NOT NULL,
  created_by TEXT NOT NULL DEFAULT '',
  created_at TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS attachments_item ON attachments (item_id);
"""

# Items come back with counts the board shows on cards: files, the first image (cover), comments.
ITEM_SELECT = """SELECT items.*,
  (SELECT COUNT(*) FROM attachments a WHERE a.item_id = items.id) AS files,
  (SELECT MIN(a.id) FROM attachments a WHERE a.item_id = items.id AND a.mime LIKE 'image/%') AS cover,
  (SELECT COUNT(*) FROM events e WHERE e.item_id = items.id AND e.action = 'commented') AS comments
FROM items"""
ATT_COLS = "id, item_id, name, mime, size, created_by, created_at"


class TTError(Exception):
    def __init__(self, msg, status=400):
        super().__init__(msg)
        self.status = status


def now_iso():
    return dt.datetime.now().isoformat(timespec="seconds")


def sort_key(it):
    return (0 if it["status"] == "doing" else 1, PRANK.get(it["priority"], 9), it["created_at"])


def parse_ref(ref):
    if isinstance(ref, int) or str(ref).isdigit():
        return None, int(ref)
    m = re.fullmatch(r"#?([TtIi])-?(\d+)", str(ref).strip())
    if not m:
        raise TTError(f"'{ref}' is not a valid id (expected something like T-3 or I-12)")
    return ("task" if m.group(1).upper() == "T" else "issue"), int(m.group(2))


def clean_tags(tags):
    if isinstance(tags, str):
        tags = re.split(r"[,\s]+", tags)
    return [t.lstrip("#").strip() for t in tags if t and t.lstrip("#").strip()]


# ---------------------------------------------------------------- store

class Store:
    def __init__(self, path=None):
        self.path = Path(path or os.environ.get("TIANTASKS_DB") or DEFAULT_DB).expanduser()
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.db = sqlite3.connect(self.path, timeout=15, isolation_level=None,
                                  check_same_thread=False)
        self.db.row_factory = sqlite3.Row
        self.db.execute("PRAGMA journal_mode=WAL")
        self.db.executescript(SCHEMA)

    def close(self):
        self.db.close()

    @contextmanager
    def tx(self):
        self.db.execute("BEGIN IMMEDIATE")
        try:
            yield
        except BaseException:
            self.db.execute("ROLLBACK")
            raise
        self.db.execute("COMMIT")

    @staticmethod
    def _row(r):
        d = dict(r)
        d["tags"] = json.loads(d["tags"])
        d["ref"] = f"{'T' if d['kind'] == 'task' else 'I'}-{d['num']}"
        return d

    def get(self, ref):
        kind, num = parse_ref(ref)
        if kind is None:
            r = self.db.execute(ITEM_SELECT + " WHERE items.id=?", (num,)).fetchone()
        else:
            r = self.db.execute(ITEM_SELECT + " WHERE kind=? AND num=?", (kind, num)).fetchone()
        if not r:
            raise TTError(f"no item {ref}", 404)
        return self._row(r)

    def _log(self, item, actor, action, detail=""):
        self.db.execute(
            "INSERT INTO events (item_id, ref, title, project, at, actor, action, detail)"
            " VALUES (?,?,?,?,?,?,?,?)",
            (item["id"], item["ref"], item["title"], item["project"], now_iso(), actor, action, detail))

    def create(self, kind, title, project, actor, body="", priority="", tags=(), assignee=""):
        title = " ".join(str(title).split())
        if not title:
            raise TTError("title cannot be empty")
        if kind not in ("task", "issue"):
            raise TTError("kind must be task or issue")
        if priority and priority not in PRIORITIES:
            raise TTError(f"priority must be one of {', '.join(PRIORITIES)}")
        now = now_iso()
        with self.tx():
            num = self.db.execute("SELECT COALESCE(MAX(num), 0) + 1 FROM items WHERE kind=?",
                                  (kind,)).fetchone()[0]
            cur = self.db.execute(
                "INSERT INTO items (kind, num, project, title, body, priority, tags, assignee,"
                " created_by, created_at, updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                (kind, num, project or "general", title, body or "", priority or "",
                 json.dumps(clean_tags(tags)), assignee or "", actor, now, now))
            item = self.get(cur.lastrowid)
            self._log(item, actor, "opened", f"for {assignee}" if assignee else "")
        return item

    def update(self, ref, actor, **ch):
        with self.tx():
            it = self.get(ref)
            sets, events = {}, []
            status = ch.get("status")
            note = ch.get("note")
            if status and status != it["status"]:
                if status not in STATUSES:
                    raise TTError(f"status must be one of {', '.join(STATUSES)}")
                sets["status"] = status
                if status == "done":
                    sets["resolved_at"] = now_iso()
                    sets["note"] = (note or "").strip()
                    events.append(("resolved", sets["note"]))
                    note = None
                elif it["status"] == "done":
                    sets["resolved_at"], sets["note"] = None, ""
                    events.append(("reopened", ""))
                    if status == "doing":
                        events.append(("started", ""))
                else:
                    events.append(("started" if status == "doing" else "paused", ""))
            if note is not None and note.strip() != it["note"]:
                sets["note"] = note.strip()
                events.append(("noted", note.strip()))
            if "assignee" in ch and (ch["assignee"] or "") != it["assignee"]:
                sets["assignee"] = ch["assignee"] or ""
                events.append(("assigned", f"to {ch['assignee']}" if ch["assignee"] else "to nobody"))
            if "priority" in ch and (ch["priority"] or "") != it["priority"]:
                p = ch["priority"] or ""
                if p and p not in PRIORITIES:
                    raise TTError(f"priority must be one of {', '.join(PRIORITIES)}")
                sets["priority"] = p
                events.append(("reprioritized", p or "none"))
            if "title" in ch and ch["title"] and " ".join(ch["title"].split()) != it["title"]:
                sets["title"] = " ".join(ch["title"].split())
                events.append(("renamed", f"from “{it['title']}”"))
            if "body" in ch and (ch["body"] or "") != it["body"]:
                sets["body"] = ch["body"] or ""
                events.append(("edited", "description"))
            if "tags" in ch and clean_tags(ch["tags"]) != it["tags"]:
                sets["tags"] = json.dumps(clean_tags(ch["tags"]))
                events.append(("tagged", ", ".join(clean_tags(ch["tags"])) or "none"))
            if "project" in ch and ch["project"] and ch["project"] != it["project"]:
                sets["project"] = ch["project"]
                events.append(("moved", f"to {ch['project']}"))
            if not sets:
                return it
            sets["updated_at"] = now_iso()
            cols = ", ".join(f"{k}=?" for k in sets)
            self.db.execute(f"UPDATE items SET {cols} WHERE id=?", (*sets.values(), it["id"]))
            it = self.get(it["id"])
            for action, detail in events:
                self._log(it, actor, action, detail)
        return it

    def comment(self, ref, actor, text):
        if not text.strip():
            raise TTError("comment cannot be empty")
        with self.tx():
            it = self.get(ref)
            self._log(it, actor, "commented", text.strip())
        return it

    def delete(self, ref, actor):
        with self.tx():
            it = self.get(ref)
            self.db.execute("DELETE FROM items WHERE id=?", (it["id"],))
            self.db.execute("DELETE FROM attachments WHERE item_id=?", (it["id"],))
            self._log(it, actor, "deleted")
        return it

    @staticmethod
    def _att(r):
        d = dict(r)
        d.pop("data", None)
        d["url"] = f"/api/attachments/{d['id']}"
        return d

    def attach(self, ref, actor, name, mime, data):
        if not data:
            raise TTError("attachment is empty")
        if len(data) > MAX_ATTACHMENT:
            raise TTError(f"attachment is {len(data) // 1024} KB; the limit is {MAX_ATTACHMENT // 1024} KB", 413)
        name = Path(str(name or "")).name.strip()[:120] or "file"
        if not re.fullmatch(r"[\w.+-]+/[\w.+-]+", mime or ""):
            mime = "application/octet-stream"
        with self.tx():
            it = self.get(ref)
            cur = self.db.execute(
                "INSERT INTO attachments (item_id, name, mime, size, data, created_by, created_at)"
                " VALUES (?,?,?,?,?,?,?)", (it["id"], name, mime, len(data), data, actor, now_iso()))
            self.db.execute("UPDATE items SET updated_at=? WHERE id=?", (now_iso(), it["id"]))
            self._log(it, actor, "attached", f"{name} (#{cur.lastrowid})")
            return self._att(self.db.execute(f"SELECT {ATT_COLS} FROM attachments WHERE id=?",
                                             (cur.lastrowid,)).fetchone())

    def attachments(self, ref):
        it = self.get(ref)
        return [self._att(r) for r in self.db.execute(
            f"SELECT {ATT_COLS} FROM attachments WHERE item_id=? ORDER BY id", (it["id"],))]

    def attachment(self, att_id):
        r = self.db.execute("SELECT * FROM attachments WHERE id=?", (int(att_id),)).fetchone()
        if not r:
            raise TTError(f"no attachment #{att_id}", 404)
        return dict(r)

    def detach(self, att_id, actor):
        with self.tx():
            a = self.attachment(att_id)
            it = self.get(a["item_id"])
            self.db.execute("DELETE FROM attachments WHERE id=?", (a["id"],))
            self._log(it, actor, "detached", f"{a['name']} (#{a['id']})")
        return self._att(a)

    def list(self, project=None, statuses=None, kind=None, assignee=None, grep=None):
        sql, args = ITEM_SELECT + " WHERE 1=1", []
        if project:
            sql += " AND project=?"; args.append(project)
        if statuses:
            sql += f" AND status IN ({','.join('?' * len(statuses))})"; args += list(statuses)
        if kind:
            sql += " AND kind=?"; args.append(kind)
        if assignee is not None:
            sql += " AND assignee=?"; args.append(assignee)
        if grep:
            sql += " AND (title LIKE ? OR body LIKE ? OR note LIKE ?)"; args += [f"%{grep}%"] * 3
        items = [self._row(r) for r in self.db.execute(sql, args)]
        return sorted(items, key=sort_key)

    def events(self, limit=40, project=None, item_id=None):
        sql, args = "SELECT * FROM events WHERE 1=1", []
        if project:
            sql += " AND project=?"; args.append(project)
        if item_id:
            sql += " AND item_id=?"; args.append(item_id)
        sql += " ORDER BY id DESC LIMIT ?"; args.append(limit)
        return [dict(r) for r in self.db.execute(sql, args)]

    def version(self):
        return self.db.execute("SELECT COALESCE(MAX(id), 0) FROM events").fetchone()[0]

    def projects(self):
        rows = self.db.execute(
            "SELECT project, SUM(status != 'done') AS open, COUNT(*) AS total FROM items"
            " GROUP BY project ORDER BY project")
        return [dict(r) for r in rows]

    def assignees(self):
        return [r[0] for r in self.db.execute(
            "SELECT DISTINCT assignee FROM items WHERE assignee != '' ORDER BY assignee")]


# ---------------------------------------------------------------- remote board

def load_config():
    """Return {url, token} for a shared board, or None to use the local database."""
    if os.environ.get("TIANTASKS_URL"):
        return {"url": os.environ["TIANTASKS_URL"], "token": os.environ.get("TIANTASKS_TOKEN", "")}
    try:
        cfg = json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return None
    return cfg if cfg.get("url") else None


def ssl_context():
    # python.org builds of Python on macOS ship without CA certificates, so also trust the
    # system bundle; otherwise every HTTPS call fails with CERTIFICATE_VERIFY_FAILED.
    ctx = ssl.create_default_context()
    for bundle in ("/etc/ssl/cert.pem", "/opt/homebrew/etc/ca-certificates/cert.pem"):
        if os.path.exists(bundle):
            ctx.load_verify_locations(bundle)
    return ctx


class RemoteStore:
    """Same interface as Store, backed by a shared board's HTTP API."""

    def __init__(self, url, token):
        self.url, self.token, self._me = url.rstrip("/"), token, None
        self.path = self.url

    def _req(self, method, path, body=None, params=None, raw=False):
        if params:
            path += "?" + urlencode({k: v for k, v in params.items() if v is not None})
        # Cloudflare's bot check blocks Python's default User-Agent (error 1010), so name ourselves.
        headers = {"Authorization": f"Bearer {self.token}", "X-Tiantasks": "1",
                   "Content-Type": "application/json", "User-Agent": f"tiantasks-cli/{VERSION}"}
        if os.environ.get("CLAUDECODE"):
            headers["X-Tiantasks-Agent"] = "claude"
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.url + path, data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=60, context=ssl_context()) as r:
                if raw:
                    return {"data": r.read(), "mime": r.headers.get_content_type()}
                return json.load(r)
        except urllib.error.HTTPError as e:
            try:
                msg = json.load(e).get("error")
            except Exception:
                msg = None
            if e.code == 401:
                msg = "the shared board rejected your token; run `tt login` again"
            raise TTError(msg or f"{self.url} returned HTTP {e.code}", e.code)
        except urllib.error.URLError as e:
            raise TTError(f"can't reach {self.url}: {e.reason}")

    def _item(self, ref):
        return f"/api/items/{quote(str(ref).strip().lstrip('#'))}"

    def me(self):
        if self._me is None:
            self._me = self._req("GET", "/api/me")
        return self._me

    def get(self, ref):
        return self._req("GET", self._item(ref))

    def create(self, kind, title, project, actor, body="", priority="", tags=(), assignee=""):
        return self._req("POST", "/api/items", {
            "kind": kind, "title": title, "project": project, "body": body,
            "priority": priority, "tags": list(tags), "assignee": assignee})

    def update(self, ref, actor, **ch):
        return self._req("PATCH", self._item(ref), ch)

    def comment(self, ref, actor, text):
        return self._req("POST", self._item(ref) + "/comment", {"text": text})

    def delete(self, ref, actor):
        return self._req("DELETE", self._item(ref))

    def attach(self, ref, actor, name, mime, data):
        return self._req("POST", self._item(ref) + "/attachments", {
            "name": name, "mime": mime, "data": base64.b64encode(data).decode()})

    def attachments(self, ref):
        return self._req("GET", self._item(ref) + "/attachments")

    def attachment(self, att_id):
        return self._req("GET", f"/api/attachments/{int(att_id)}", raw=True)

    def list(self, project=None, statuses=None, kind=None, assignee=None, grep=None):
        return self._req("GET", "/api/items", params={
            "project": project, "status": ",".join(statuses) if statuses else None,
            "kind": kind, "assignee": assignee, "grep": grep})

    def events(self, limit=40, project=None, item_id=None):
        return self._req("GET", "/api/events",
                         params={"limit": limit, "project": project, "item_id": item_id})

    def projects(self):
        return self._req("GET", "/api/projects")

    def close(self):
        pass


# ---------------------------------------------------------------- context

def current_actor(args=None):
    store = getattr(args, "store", None)
    if isinstance(store, RemoteStore):
        return store.me()["actor"]  # the server decides who you are from your token
    if args is not None and getattr(args, "actor", None):
        return args.actor
    if os.environ.get("TIANTASKS_ACTOR"):
        return os.environ["TIANTASKS_ACTOR"]
    if os.environ.get("CLAUDECODE"):
        return "claude"
    return getpass.getuser()


def current_project(args=None):
    if args is not None and getattr(args, "project", None):
        return args.project
    if os.environ.get("TIANTASKS_PROJECT"):
        return os.environ["TIANTASKS_PROJECT"]
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return Path(r.stdout.strip()).name if r.returncode == 0 else Path.cwd().name


# ---------------------------------------------------------------- terminal output

COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def _c(code):
    return lambda s: f"\033[{code}m{s}\033[0m" if COLOR else s


dim, bold, green, red, yellow, cyan, strike = map(_c, ("2", "1", "32", "31", "33", "36", "9"))
PRIO_COLOR = {"crit": red, "high": red, "med": yellow, "low": dim}


def die(msg, code=1):
    print(red(f"tiantasks: {msg}"), file=sys.stderr)
    sys.exit(code)


def show_ts(s):
    """Timestamps from a hosted board are UTC ('...Z'); show them in local time."""
    if s and s.endswith("Z"):
        s = (dt.datetime.fromisoformat(s[:-1] + "+00:00").astimezone()
             .replace(tzinfo=None).isoformat(timespec="seconds"))
    return (s or "").replace("T", " ")


def fmt(it, show_project=False):
    box = {"done": green("[x]"), "doing": yellow("[~]"), "open": "[ ]"}[it["status"]]
    ref = (red if it["kind"] == "issue" else cyan)(it["ref"].ljust(5))
    title = strike(dim(it["title"])) if it["status"] == "done" else it["title"]
    extras = []
    if it["status"] == "doing":
        extras.append(yellow("in progress"))
    if it["priority"]:
        extras.append(PRIO_COLOR[it["priority"]](it["priority"]))
    if it["assignee"]:
        extras.append(cyan("@" + it["assignee"]))
    extras += [dim("#" + t) for t in it["tags"]]
    if show_project:
        extras.append(dim(f"[{it['project']}]"))
    if it["status"] == "done":
        extras.append(dim(f"resolved {show_ts(it['resolved_at'])[:10]}" + (f": {it['note']}" if it["note"] else "")))
    return f"{box} {ref} {title}" + ("  " + " ".join(extras) if extras else "")


def emit(args, item, verb, color=green):
    if getattr(args, "json", False):
        print(json.dumps(item, indent=2))
    else:
        print(f"{color(verb)} {fmt(item)}")


# ---------------------------------------------------------------- commands

def cmd_add(args, kind=None):
    kind = kind or ("issue" if args.issue else "task")
    assignee = args.to
    if assignee == "me":
        assignee = current_actor(args)
    it = args.store.create(kind, " ".join(args.text), current_project(args), current_actor(args),
                           body=args.desc or "", priority=args.priority or "",
                           tags=args.tag or [], assignee=assignee or "")
    for path in args.file or []:
        attach_file(args, it["ref"], path)
    if args.file:
        it = args.store.get(it["ref"])
    emit(args, it, "added")


def attach_file(args, ref, path):
    p = Path(path).expanduser()
    try:
        data = p.read_bytes()
    except OSError as e:
        raise TTError(f"can't read {path}: {e.strerror}")
    mime = mimetypes.guess_type(p.name)[0] or "application/octet-stream"
    return args.store.attach(ref, current_actor(args), p.name, mime, data)


def human_size(n):
    return f"{n} B" if n < 1024 else f"{n / 1024:.0f} KB" if n < 1024 ** 2 else f"{n / 1024 ** 2:.1f} MB"


def cmd_attach(args):
    for path in args.files:
        a = attach_file(args, args.id, path)
        if getattr(args, "json", False):
            print(json.dumps(a, indent=2))
            continue
        info = dim("(#%s, %s)" % (a["id"], human_size(a["size"])))
        print(f"{cyan('attached')} {a['name']} {info} to {args.id.upper()}")


def cmd_files(args):
    files = args.store.attachments(args.id)
    if args.save:
        out = Path(args.save).expanduser()
        out.mkdir(parents=True, exist_ok=True)
        for a in files:
            dest = out / f"{a['id']}-{a['name']}"
            dest.write_bytes(args.store.attachment(a["id"])["data"])
            a["path"] = str(dest)
    if args.json:
        print(json.dumps(files, indent=2))
        return
    if not files:
        print(dim(f"no files on {args.id.upper()}"))
    for a in files:
        where = a.get("path") or dim(a["mime"])
        print(f"#{a['id']:<4} {a['name']}  {dim(human_size(a['size']))}  {where}")


def cmd_resolve(args):
    for ref in args.ids:
        it = args.store.update(ref, current_actor(args), status="done", note=args.message or "")
        emit(args, it, "resolved")


def cmd_status(status, verb, color):
    def run(args):
        for ref in args.ids:
            ch = {"status": status}
            if status == "doing" and not args.store.get(ref)["assignee"]:
                ch["assignee"] = current_actor(args)
            emit(args, args.store.update(ref, current_actor(args), **ch), verb, color)
    return run


def cmd_assign(args):
    who = "" if args.who in ("nobody", "none", "-") else args.who
    if who == "me":
        who = current_actor(args)
    for ref in args.ids:
        emit(args, args.store.update(ref, current_actor(args), assignee=who), "assigned", cyan)


def cmd_edit(args):
    ch = {}
    if args.text:
        ch["title"] = " ".join(args.text)
    if args.priority is not None:
        ch["priority"] = "" if args.priority == "none" else args.priority
    if args.desc is not None:
        ch["body"] = args.desc
    if args.tag or args.untag:
        tags = args.store.get(args.id)["tags"]
        tags += [t for t in clean_tags(args.tag or []) if t not in tags]
        ch["tags"] = [t for t in tags if t not in clean_tags(args.untag or [])]
    if args.move:
        ch["project"] = args.move
    if not ch:
