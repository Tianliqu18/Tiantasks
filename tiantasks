"""
BUMP_SQL = "INSERT INTO changes (id, n) VALUES (1, 1) ON CONFLICT (id) DO UPDATE SET n = n + 1"
# Comments used to be stored only as 'commented' events; copy them into the comments table once.
LEGACY_COMMENTS_SQL = """
INSERT OR IGNORE INTO comments (item_id, ref, author, body, created_at, legacy_event_id)
  SELECT item_id, ref, actor, detail, at, id FROM events WHERE action = 'commented';
"""
# Comment events use these actions; history views hide them because comments have their own list.
COMMENT_ACTIONS = ("commented", "added a comment", "replied", "deleted a comment")


NEXT_NUM_SQL = """
SELECT COALESCE(MAX(n), 0) + 1 FROM (
  SELECT MAX(num) AS n FROM items WHERE kind = ?1
  UNION ALL
  SELECT MAX(CAST(substr(ref, 3) AS INTEGER)) FROM events WHERE substr(ref, 1, 1) = ?2
)"""


class TTError(Exception):
    def __init__(self, msg, status=400):
        super().__init__(msg)
        self.status = status


def now_iso():
    return dt.datetime.now().isoformat(timespec="seconds")


def sort_key(it):
    return (0 if it["status"] == "doing" else 1, PRANK.get(it["priority"], 9), it["created_at"])


def parse_ref(ref):
    if isinstance(ref, int) or str(ref).isdigit():
        return None, int(ref)
    m = re.fullmatch(r"#?([TtIi])-?(\d+)", str(ref).strip())
    if not m:
        raise TTError(f"'{ref}' is not a valid id (expected something like T-3 or I-12)")
    return ("task" if m.group(1).upper() == "T" else "issue"), int(m.group(2))


def clean_filename(name):
    name = re.sub(r"[^\w.\- ]+", "_", Path(str(name or "")).name).strip(" ._")
    return name[:100] or "screenshot"


def human_size(n):
    return f"{n / 1_000_000:.1f} MB" if n >= 1_000_000 else f"{max(1, round(n / 1000))} KB"


def clean_tags(tags):
    if isinstance(tags, str):
        tags = re.split(r"[,\s]+", tags)
    return [t.lstrip("#").strip() for t in tags if t and t.lstrip("#").strip()]


# ---------------------------------------------------------------- store

class Store:
    def __init__(self, path=None):
        self.path = Path(path or os.environ.get("TIANTASKS_DB") or DEFAULT_DB).expanduser()
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.db = sqlite3.connect(self.path, timeout=15, isolation_level=None,
                                  check_same_thread=False)
        self.db.row_factory = sqlite3.Row
        self.db.execute("PRAGMA journal_mode=WAL")
        self.db.executescript(SCHEMA)
        if self.db.execute("PRAGMA user_version").fetchone()[0] < 1:
            self.db.executescript(LEGACY_COMMENTS_SQL + "PRAGMA user_version = 1;")

    def close(self):
        self.db.close()

    @contextmanager
    def tx(self):
        self.db.execute("BEGIN IMMEDIATE")
        try:
            yield
        except BaseException:
            self.db.execute("ROLLBACK")
            raise
        self.db.execute("COMMIT")

    @staticmethod
    def _row(r):
        d = dict(r)
        d["tags"] = json.loads(d["tags"])
        d["ref"] = f"{'T' if d['kind'] == 'task' else 'I'}-{d['num']}"
        return d

    def get(self, ref):
        kind, num = parse_ref(ref)
        if kind is None:
            r = self.db.execute("SELECT * FROM items WHERE id=?", (num,)).fetchone()
        else:
            r = self.db.execute("SELECT * FROM items WHERE kind=? AND num=?", (kind, num)).fetchone()
        if not r:
            raise TTError(f"no item {ref}", 404)
        item = self._row(r)
        item["attachments"] = self._attachment_meta(item["id"]).get(item["id"], [])
        item["fields"] = self._fields(item["id"]).get(item["id"], {})
        return item

    def _fields(self, item_id=None):
        rows = self.db.execute("SELECT item_id, key, value FROM item_fields" +
                               (" WHERE item_id=?" if item_id else ""), (item_id,) if item_id else ())
        out = {}
        for r in rows:
            out.setdefault(r["item_id"], {})[r["key"]] = r["value"]
        return out

    def _attachment_meta(self, item_id=None):
        sql = "SELECT id, item_id, name, mime, size FROM attachments"
        rows = self.db.execute(sql + (" WHERE item_id=?" if item_id else "") + " ORDER BY id",
                               (item_id,) if item_id else ())
        meta = {}
        for r in rows:
            meta.setdefault(r["item_id"], []).append(
                {"id": r["id"], "name": r["name"], "mime": r["mime"], "size": r["size"]})
        return meta

    def attach(self, ref, actor, name, mime, data):
        if mime not in IMAGE_TYPES:
            raise TTError("only PNG, JPEG, WebP or GIF images can be attached", 415)
        if not data:
            raise TTError("the image is empty")
        if len(data) > MAX_ATTACHMENT:
            raise TTError(f"the image is {human_size(len(data))}; the limit is {human_size(MAX_ATTACHMENT)}", 413)
        name = clean_filename(name)
        with self.tx():
            it = self.get(ref)
            cur = self.db.execute(
                "INSERT INTO attachments (item_id, name, mime, size, data, created_by, created_at)"
                " VALUES (?,?,?,?,?,?,?)", (it["id"], name, mime, len(data), data, actor, now_iso()))
            self._log(it, actor, "attached", name)
        return {"id": cur.lastrowid, "name": name, "mime": mime, "size": len(data)}

    def attachment(self, att_id):
        r = self.db.execute("SELECT * FROM attachments WHERE id=?", (att_id,)).fetchone()
        if not r:
            raise TTError("no such attachment", 404)
        return dict(r)

    def attachments(self, ref):
        it = self.get(ref)
        return [{**a, "url": f"/api/attachments/{a['id']}"} for a in it["attachments"]]

    def attachment_bytes(self, att_id):
        return bytes(self.attachment(int(att_id))["data"])

    def delete_attachment(self, att_id, actor):
        with self.tx():
            a = self.attachment(att_id)
            it = self.get(a["item_id"])
            self.db.execute("DELETE FROM attachments WHERE id=?", (att_id,))
            self._log(it, actor, "removed screenshot", a["name"])
        return {"ok": True}

    def _log(self, item, actor, action, detail=""):
        self.db.execute(
            "INSERT INTO events (item_id, ref, title, project, at, actor, action, detail)"
            " VALUES (?,?,?,?,?,?,?,?)",
            (item["id"], item["ref"], item["title"], item["project"], now_iso(), actor, action, detail))

    def create(self, kind, title, project, actor, body="", priority="", tags=(), assignee=""):
        title = " ".join(str(title).split())
        if not title:
            raise TTError("title cannot be empty")
        if kind not in ("task", "issue"):
            raise TTError("kind must be task or issue")
        if priority and priority not in PRIORITIES:
            raise TTError(f"priority must be one of {', '.join(PRIORITIES)}")
        now = now_iso()
        with self.tx():
            # Count deleted items too (they live on in events), so a number is never reused.
            num = self.db.execute(NEXT_NUM_SQL, (kind, "T" if kind == "task" else "I")).fetchone()[0]
            cur = self.db.execute(
                "INSERT INTO items (kind, num, project, title, body, priority, tags, assignee,"
                " created_by, created_at, updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                (kind, num, project or "general", title, body or "", priority or "",
                 json.dumps(clean_tags(tags)), assignee or "", actor, now, now))
            item = self.get(cur.lastrowid)
            self._log(item, actor, "opened", f"for {assignee}" if assignee else "")
        return item

    def update(self, ref, actor, **ch):
        if_status, if_assignee = ch.pop("if_status", None), ch.pop("if_assignee", None)
        fields = ch.pop("fields", None)
        if fields:
            self.set_fields(ref, actor, fields)
        with self.tx():
            it = self.get(ref)
            # Optional guards so two agents can't claim the same item.
            if if_status is not None and it["status"] != if_status:
                raise TTError(f"{it['ref']} is already {it['status']}" +
                              (f" ({it['assignee']})" if it["assignee"] else ""), 409)
            if if_assignee is not None and it["assignee"] != if_assignee:
                raise TTError(f"{it['ref']} was just assigned to {it['assignee'] or 'nobody'}", 409)
            sets, events = {}, []
            status = ch.get("status")
            note = ch.get("note")
            if status and status != it["status"]:
                if status not in STATUSES:
                    raise TTError(f"status must be one of {', '.join(STATUSES)}")
                sets["status"] = status
                if status == "done":
                    sets["resolved_at"] = now_iso()
                    sets["note"] = (note or "").strip()
                    events.append(("resolved", sets["note"]))
                    note = None
                elif it["status"] == "done":
                    sets["resolved_at"], sets["note"] = None, ""
                    events.append(("reopened", ""))
                    if status == "doing":
                        events.append(("started", ""))
                else:
                    events.append(("started" if status == "doing" else "paused", ""))
            if note is not None and note.strip() != it["note"]:
                sets["note"] = note.strip()
                events.append(("noted", note.strip()))
            if "assignee" in ch and (ch["assignee"] or "") != it["assignee"]:
                sets["assignee"] = ch["assignee"] or ""
                events.append(("assigned", f"to {ch['assignee']}" if ch["assignee"] else "to nobody"))
            if "priority" in ch and (ch["priority"] or "") != it["priority"]:
                p = ch["priority"] or ""
                if p and p not in PRIORITIES:
                    raise TTError(f"priority must be one of {', '.join(PRIORITIES)}")
                sets["priority"] = p
                events.append(("reprioritized", p or "none"))
            if "title" in ch and ch["title"] and " ".join(ch["title"].split()) != it["title"]:
                sets["title"] = " ".join(ch["title"].split())
                events.append(("renamed", f"from “{it['title']}”"))
            if "body" in ch and (ch["body"] or "") != it["body"]:
                sets["body"] = ch["body"] or ""
                events.append(("edited", "description"))
            if "tags" in ch and clean_tags(ch["tags"]) != it["tags"]:
                sets["tags"] = json.dumps(clean_tags(ch["tags"]))
                events.append(("tagged", ", ".join(clean_tags(ch["tags"])) or "none"))
            if "project" in ch and ch["project"] and ch["project"] != it["project"]:
                sets["project"] = ch["project"]
                events.append(("moved", f"to {ch['project']}"))
            if not sets:
                return it
            sets["updated_at"] = now_iso()
            cols = ", ".join(f"{k}=?" for k in sets)
            self.db.execute(f"UPDATE items SET {cols} WHERE id=?", (*sets.values(), it["id"]))
            it = self.get(it["id"])
            for action, detail in events:
                self._log(it, actor, action, detail)
        return it

    @staticmethod
    def _comment_row(r):
        deleted = bool(r["deleted_at"])
        return {"id": r["id"], "parent_id": r["parent_id"], "author": r["author"],
                "body": "" if deleted else r["body"], "at": r["created_at"], "deleted": deleted}

    def comments(self, ref):
        """All comments on an item, oldest first. Replies carry parent_id (threads are one level)."""
        it = self.get(ref)
        rows = self.db.execute("SELECT * FROM comments WHERE ref=? ORDER BY id", (it["ref"],))
        return [self._comment_row(r) for r in rows]

    def comment(self, ref, actor, text, parent_id=None):
        text = (text or "").strip()
        if not text:
            raise TTError("comment cannot be empty")
        with self.tx():
            it = self.get(ref)
            if parent_id:
                p = self.db.execute("SELECT id, parent_id, author FROM comments WHERE id=? AND ref=?",
                                    (int(parent_id), it["ref"])).fetchone()
                if not p:
                    raise TTError(f"no comment {parent_id} on {it['ref']}", 404)
                parent_id = p["parent_id"] or p["id"]  # replying to a reply joins the same thread
            cur = self.db.execute(
                "INSERT INTO comments (item_id, ref, parent_id, author, body, created_at) VALUES (?,?,?,?,?,?)",
                (it["id"], it["ref"], parent_id or None, actor, text, now_iso()))
            self._log(it, actor, "replied" if parent_id else "added a comment", text)
            row = self.db.execute("SELECT * FROM comments WHERE id=?", (cur.lastrowid,)).fetchone()
        return self._comment_row(row)

    def delete_comment(self, cid, actor, is_admin):
        if not is_admin:
            raise TTError("only an admin can delete comments", 403)
        with self.tx():
            r = self.db.execute("SELECT * FROM comments WHERE id=?", (int(cid),)).fetchone()
            if not r or r["deleted_at"]:
                raise TTError(f"no comment {cid}", 404)
            it = self.get(r["ref"])
            # Soft delete, so replies to it still make sense ("comment deleted" stays in the thread).
            self.db.execute("UPDATE comments SET deleted_at=?, deleted_by=?, body='' WHERE id=?",
                            (now_iso(), actor, r["id"]))
            self._log(it, actor, "deleted a comment", f"by {r['author']}")
        return {"ok": True}

    def delete(self, ref, actor):
        with self.tx():
            it = self.get(ref)
            self.db.execute("DELETE FROM items WHERE id=?", (it["id"],))
            self.db.execute("DELETE FROM attachments WHERE item_id=?", (it["id"],))
            self.db.execute("DELETE FROM comments WHERE ref=?", (it["ref"],))
            self.db.execute("DELETE FROM item_fields WHERE item_id=?", (it["id"],))
            self._log(it, actor, "deleted")
        return it

    def list(self, project=None, statuses=None, kind=None, assignee=None, grep=None):
        sql, args = "SELECT * FROM items WHERE 1=1", []
        if project:
            sql += " AND project=?"; args.append(project)
        if statuses:
            sql += f" AND status IN ({','.join('?' * len(statuses))})"; args += list(statuses)
        if kind:
            sql += " AND kind=?"; args.append(kind)
        if assignee is not None:
            sql += " AND assignee=?"; args.append(assignee)
        if grep:
            sql += " AND (title LIKE ? OR body LIKE ? OR note LIKE ?)"; args += [f"%{grep}%"] * 3
        items = [self._row(r) for r in self.db.execute(sql, args)]
        meta, fields = self._attachment_meta(), self._fields()
        for it in items:
            it["attachments"] = meta.get(it["id"], [])
            it["fields"] = fields.get(it["id"], {})
        return sorted(items, key=sort_key)

    def events(self, limit=40, project=None, item_id=None, ref=None):
        sql, args = "SELECT * FROM events WHERE 1=1", []
        if item_id and not ref:
            ref = self.get(item_id)["ref"]  # history follows the T-/I- number, which is never reused
        if project:
            sql += " AND project=?"; args.append(project)
        if ref:
            sql += " AND ref=?"; args.append(ref)
        sql += " ORDER BY id DESC LIMIT ?"; args.append(limit)
        return [dict(r) for r in self.db.execute(sql, args)]

    def version(self):
        return self.db.execute("SELECT (SELECT COALESCE(MAX(id), 0) FROM events) + "
                               "(SELECT COALESCE(MAX(n), 0) FROM changes)").fetchone()[0]

    def _bump(self):
        self.db.execute(BUMP_SQL)

    # ---- fields
    def set_fields(self, ref, actor, fields):
        """Set item fields; an empty value removes one. Returns the item."""
        with self.tx():
            it = self.get(ref)
            for key, value in fields.items():
                key, value = str(key).strip().lower(), str(value or "").strip()
                if not re.fullmatch(r"[a-z][a-z0-9_]{0,30}", key):
                    raise TTError(f"field names use lowercase letters, numbers and _ (got {key!r})")
                if value == it["fields"].get(key, ""):
                    continue
                if value:
                    self.db.execute("INSERT INTO item_fields (item_id, key, value) VALUES (?,?,?) "
                                    "ON CONFLICT (item_id, key) DO UPDATE SET value=excluded.value",
                                    (it["id"], key, value[:500]))
                    self._log(it, actor, "set field", f"{key}: {value[:200]}")
                else:
                    self.db.execute("DELETE FROM item_fields WHERE item_id=? AND key=?", (it["id"], key))
                    self._log(it, actor, "cleared field", key)
        return self.get(ref)

    # ---- agents
    def touch_agent(self, name, principal):
        """Record that an agent just acted and return its name on this board. Two people's chats
        can share a name (everyone has a 'concierge'); the second person's becomes name-<person>."""
        row = self.db.execute("SELECT principal FROM agents WHERE name=?", (name,)).fetchone()
        if row and row["principal"] and principal and row["principal"] != principal:
            name = f"{name}-{principal}"[:64]
            row = self.db.execute("SELECT principal FROM agents WHERE name=?", (name,)).fetchone()
            if row and row["principal"] and row["principal"] != principal:
                raise TTError(f"agent '{name}' works for {row['principal']}, not {principal}", 403)
        t = now_iso()
        self.db.execute("INSERT INTO agents (name, principal, first_seen, last_seen) VALUES (?,?,?,?) "
                        "ON CONFLICT (name) DO UPDATE SET last_seen=excluded.last_seen, "
                        "principal=CASE WHEN agents.principal = '' THEN excluded.principal ELSE agents.principal END",
                        (name, principal or "", t, t))
        return name

    def report_agent(self, name, principal, info):
        """An agent's own status report (or its adapter's): kind, host, project, initiative, state, doing."""
        name = str(name).strip().lower()
        if not AGENT_NAME.fullmatch(name):
            raise TTError("agent names use lowercase letters, numbers, - _ .")
        state = info.get("state")
        if state is not None and state not in AGENT_STATES:
            raise TTError(f"state must be one of {', '.join(AGENT_STATES)}")
        with self.tx():
            name = self.touch_agent(name, principal)
            cur = dict(self.db.execute("SELECT * FROM agents WHERE name=?", (name,)).fetchone())
            sets = {k: str(info[k])[:300] for k in ("kind", "host", "project", "initiative", "state", "doing")
                    if k in info and info[k] is not None and str(info[k])[:300] != cur[k]}
            if "state" in sets:
                sets["state_since"] = now_iso()
            if sets:
                cols = ", ".join(f"{k}=?" for k in sets)
                self.db.execute(f"UPDATE agents SET {cols} WHERE name=?", (*sets.values(), name))
                self._bump()
        return self.agent(name)

    def agent(self, name):
        r = self.db.execute("SELECT * FROM agents WHERE name=?", (name,)).fetchone()
        if not r:
            raise TTError(f"no agent {name}", 404)
        return dict(r)

    def agents(self):
        return [dict(r) for r in self.db.execute("SELECT * FROM agents ORDER BY principal, name")]

    def remove_agent(self, name, user):
        with self.tx():
            a = self.agent(name)
            if a["principal"] and a["principal"] != user:
                raise TTError(f"{name} works for {a['principal']}; only they can remove it", 403)
            self.db.execute("DELETE FROM agents WHERE name=?", (name,))
            self._bump()
        return {"ok": True}

    def remove_initiative(self, slug, user):
        with self.tx():
            i = self.initiative(slug)
            if i["principal"] and i["principal"] != user:
                raise TTError(f"{slug} belongs to {i['principal']}; only they can remove it", 403)
            self.db.execute("DELETE FROM initiatives WHERE slug=?", (slug,))
            self._bump()
        return {"ok": True}

    def principal_of(self, name):
        """Who an agent works for; a person is their own principal."""
        r = self.db.execute("SELECT principal FROM agents WHERE name=?", (name,)).fetchone()
        return (r["principal"] if r else "") or name

    # ---- initiatives
    def initiatives(self):
        return [dict(r) for r in self.db.execute("SELECT * FROM initiatives ORDER BY project, slug")]

    def initiative(self, slug):
        r = self.db.execute("SELECT * FROM initiatives WHERE slug=?", (slug,)).fetchone()
        if not r:
            raise TTError(f"no initiative {slug}", 404)
        return dict(r)

    def put_initiative(self, slug, principal, info):
        slug = str(slug).strip().lower()
        if not INITIATIVE_SLUG.fullmatch(slug):
            raise TTError("initiative ids look like project/name (lowercase letters, numbers, - _ .)")
        if info.get("status") not in (None, "active", "paused", "done"):
            raise TTError("status must be active, paused or done")
        t = now_iso()
        with self.tx():
            cur = self.db.execute("SELECT * FROM initiatives WHERE slug=?", (slug,)).fetchone()
            if not cur:
                title = " ".join(str(info.get("title") or slug.split("/")[-1]).split())
                self.db.execute(
                    "INSERT INTO initiatives (slug, project, title, summary, status, owner, principal, link,"
                    " created_at, updated_at) VALUES (?,?,?,?,?,?,?,?,?,?)",
                    (slug, info.get("project") or slug.split("/")[0], title, info.get("summary") or "",
                     info.get("status") or "active", info.get("owner") or "",
                     info.get("principal") or principal or "", info.get("link") or "", t, t))
                self._bump()
            else:
                sets = {k: str(info[k]) for k in ("project", "title", "summary", "status", "owner", "principal", "link")
                        if k in info and info[k] is not None and str(info[k]) != cur[k]}
                if sets:
                    sets["updated_at"] = t
                    cols = ", ".join(f"{k}=?" for k in sets)
                    self.db.execute(f"UPDATE initiatives SET {cols} WHERE slug=?", (*sets.values(), slug))
                    self._bump()
        return self.initiative(slug)

    # ---- checkpoints
    def checkpoint(self, actor, principal, text, ref="", initiative="", link="", attachment=None, source="agent"):
        text = " ".join(str(text or "").split())
        if not text:
            raise TTError("a checkpoint needs some text")
        if source not in ("agent", "auto", "person"):
            raise TTError("source must be agent, auto or person")
        with self.tx():
            it = self.get(ref) if ref else None
            if it and not initiative:
                initiative = it["fields"].get("initiative", "")
            if not it and not initiative:
                raise TTError("say which item or initiative this checkpoint is about")
            cur = self.db.execute(
                "INSERT INTO checkpoints (ref, initiative, actor, principal, text, link, attachment, source, at)"
                " VALUES (?,?,?,?,?,?,?,?,?)",
                (it["ref"] if it else "", initiative or "", actor, principal or "", text[:500],
                 str(link or "")[:500], attachment, source, now_iso()))
            if it:
                self._log(it, actor, "checkpoint", text[:500])
            self._bump()
            return dict(self.db.execute("SELECT * FROM checkpoints WHERE id=?", (cur.lastrowid,)).fetchone())

    def checkpoints(self, ref=None, initiative=None, limit=100):
        sql, args = "SELECT * FROM checkpoints WHERE 1=1", []
        if ref:
            sql += " AND ref=?"; args.append(self.get(ref)["ref"])
        if initiative:
            sql += " AND initiative=?"; args.append(initiative)
        sql += " ORDER BY id DESC LIMIT ?"; args.append(min(int(limit or 100), 500))
        return [dict(r) for r in self.db.execute(sql, args)]

    # ---- flags and asks
    def _flag_target(self, ref, initiative, kind, principal):
        """Who a flag goes to when nobody says: the item's assignee, else the initiative's owner."""
        if kind == "ask":
            return principal
        it = self.get(ref) if ref else None
        if it and it["assignee"]:
            return it["assignee"]
        slug = initiative or (it["fields"].get("initiative") if it else "")
        if slug:
            r = self.db.execute("SELECT owner, principal FROM initiatives WHERE slug=?", (slug,)).fetchone()
            if r and (r["owner"] or r["principal"]):
                return r["owner"] or r["principal"]
        raise TTError("nobody owns that yet; say who it's for (--to NAME)")

    def flag(self, actor, principal, text, ref="", initiative="", to="", urgent=False, kind="flag"):
        text = str(text or "").strip()
        if not text:
            raise TTError("a flag needs some text")
        if kind not in ("flag", "ask"):
            raise TTError("kind must be flag or ask")
        with self.tx():
            it = self.get(ref) if ref else None
            if it and not initiative:
                initiative = it["fields"].get("initiative", "")
            to = str(to or "").strip().lower() or self._flag_target(ref, initiative, kind, principal)
            cur = self.db.execute(
                "INSERT INTO flags (kind, ref, initiative, to_name, from_actor, from_principal, text, urgent,"
                " created_at) VALUES (?,?,?,?,?,?,?,?,?)",
                (kind, it["ref"] if it else "", initiative or "", to, actor, principal or "", text[:2000],
                 1 if urgent else 0, now_iso()))
            if it:
                self._log(it, actor, "asked" if kind == "ask" else "flagged", f"{to}: {text[:300]}")
            self._bump()
            return self._flag(cur.lastrowid)

    def _flag(self, fid):
        r = self.db.execute("SELECT * FROM flags WHERE id=?", (int(fid),)).fetchone()
        if not r:
            raise TTError(f"no flag F-{fid}", 404)
        return dict(r)

    def flags(self, to=None, status=None, ref=None, initiative=None, limit=100):
        sql, args = "SELECT * FROM flags WHERE 1=1", []
        if to:
            sql += " AND to_name=?"; args.append(to)
        if status:
            st = list(FLAG_OPEN) if status == "open" else status.split(",")
            sql += f" AND status IN ({','.join('?' * len(st))})"; args += st
        if ref:
            sql += " AND ref=?"; args.append(self.get(ref)["ref"])
        if initiative:
            sql += " AND initiative=?"; args.append(initiative)
        sql += " ORDER BY id DESC LIMIT ?"; args.append(min(int(limit or 100), 500))
        return [dict(r) for r in self.db.execute(sql, args)]

    def set_flag(self, fid, actor, user, is_agent, status, note=""):
        """Move a flag along. Delivery states come from the target's person (their adapter);
        the target itself or its person acknowledges; anyone can close one."""
        if status not in FLAG_STATES:
            raise TTError(f"status must be one of {', '.join(FLAG_STATES)}")
        with self.tx():
            f = self._flag(fid)
            target_principal = self.principal_of(f["to_name"])
            if status in ("delivered", "failed", "escalated") and (is_agent or user != target_principal):
                raise TTError(f"only {target_principal} (or their adapter) reports delivery of F-{f['id']}", 403)
            if status == "acked" and actor != f["to_name"] and user != target_principal:
                raise TTError(f"F-{f['id']} is for {f['to_name']}", 403)
            stamp = {"delivered": "delivered_at", "acked": "acked_at", "escalated": "escalated_at"}.get(status)
            sets = {"status": status}
            if stamp:
                sets[stamp] = now_iso()
            if note:
                sets["note"] = str(note).strip()[:1000]
            cols = ", ".join(f"{k}=?" for k in sets)
            self.db.execute(f"UPDATE flags SET {cols} WHERE id=?", (*sets.values(), f["id"]))
            if f["ref"] and status in ("acked", "closed"):
                it = self.get(f["ref"])
                self._log(it, actor, "acknowledged" if status == "acked" else "closed a flag",
                          f"F-{f['id']}" + (f": {note}" if note else ""))
            self._bump()
        return self._flag(fid)

    # ---- directives ("my person told me to")
    def directive(self, actor, principal, quote, ref="", what=""):
        quote = " ".join(str(quote or "").split())
        if not quote:
            return None
        with self.tx():
            cur = self.db.execute("INSERT INTO directives (actor, principal, ref, what, quote, at) VALUES (?,?,?,?,?,?)",
                                  (actor, principal or "", ref or "", str(what)[:200], quote[:1000], now_iso()))
            self._bump()
        return dict(self.db.execute("SELECT * FROM directives WHERE id=?", (cur.lastrowid,)).fetchone())

    def directives(self, ref=None, unchecked=False, limit=100):
        sql, args = "SELECT * FROM directives WHERE 1=1", []
        if ref:
            sql += " AND ref=?"; args.append(self.get(ref)["ref"])
        if unchecked:
            sql += " AND verified IS NULL"
        sql += " ORDER BY id DESC LIMIT ?"; args.append(min(int(limit or 100), 500))
        return [dict(r) for r in self.db.execute(sql, args)]

    def check_directive(self, did, user, verified):
        with self.tx():
            r = self.db.execute("SELECT * FROM directives WHERE id=?", (int(did),)).fetchone()
            if not r:
                raise TTError(f"no directive {did}", 404)
            if r["principal"] and r["principal"] != user:
                raise TTError(f"only {r['principal']} can check that directive", 403)
            self.db.execute("UPDATE directives SET verified=?, checked_at=? WHERE id=?",
                            (1 if verified else 0, now_iso(), r["id"]))
            self._bump()
        return dict(self.db.execute("SELECT * FROM directives WHERE id=?", (int(did),)).fetchone())

    def projects(self):
        rows = self.db.execute(
            "SELECT project, SUM(status != 'done') AS open, COUNT(*) AS total FROM items"
            " GROUP BY project ORDER BY project")
        return [dict(r) for r in rows]

    def assignees(self):
        """Everyone items can be assigned to: current assignees plus anyone recently active."""
        rows = self.db.execute(
            "SELECT assignee FROM items WHERE assignee != '' UNION "
            "SELECT actor FROM (SELECT actor FROM events ORDER BY id DESC LIMIT 500) ORDER BY 1")
        return [r[0] for r in rows]


# ---------------------------------------------------------------- agent identity

def agent_name():
    """The agent this process acts as: TIANTASKS_AGENT if set; inside Claude Code, the tmux
    session it runs in (so each long-running chat has its own name), else plain 'claude'.
    '' means a person is at the keyboard."""
    explicit = (os.environ.get("TIANTASKS_AGENT") or "").strip().lower()
    if explicit:
        return explicit
    if not os.environ.get("CLAUDECODE"):
        return ""
    if os.environ.get("TMUX") and os.environ.get("TMUX_PANE"):
        try:
            r = subprocess.run(["tmux", "display-message", "-p", "-t", os.environ["TMUX_PANE"], "#S"],
                               capture_output=True, text=True, timeout=3)
            name = re.sub(r"[^a-z0-9_.-]+", "-", r.stdout.strip().lower()).strip("-._")[:64]
            if r.returncode == 0 and AGENT_NAME.fullmatch(name or "-"):
                return name
        except (OSError, subprocess.SubprocessError):
            pass
    return "claude"


def directive_quote(args=None):
    """--directive "…": the instruction from this agent's person that a change carries out."""
    return (getattr(args, "directive", None) or os.environ.get("TIANTASKS_DIRECTIVE") or "").strip()


# ---------------------------------------------------------------- remote board

def load_config():
    """Return {url, token} for a shared board, or None to use the local database."""
    if os.environ.get("TIANTASKS_URL"):
        return {"url": os.environ["TIANTASKS_URL"], "token": os.environ.get("TIANTASKS_TOKEN", "")}
    if os.environ.get("TIANTASKS_DB"):
        return None  # an explicitly chosen database always wins over the saved shared board
    try:
        cfg = json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return None
    return cfg if cfg.get("url") else None


def ssl_context():
    # python.org builds of Python on macOS ship without CA certificates, so also trust the
    # system bundle; otherwise every HTTPS call fails with CERTIFICATE_VERIFY_FAILED.
    ctx = ssl.create_default_context()
    for bundle in ("/etc/ssl/cert.pem", "/opt/homebrew/etc/ca-certificates/cert.pem"):
        if os.path.exists(bundle):
            ctx.load_verify_locations(bundle)
    return ctx


class RemoteStore:
    """Same interface as Store, backed by a shared board's HTTP API."""

    def __init__(self, url, token):
        self.url, self.token, self._me = url.rstrip("/"), token, None
        self.path = self.url
        self.directive = ""

    def _req(self, method, path, body=None, params=None, upload=None, raw=False):
        """upload=(bytes, content_type) sends a file as-is; raw=True returns bytes instead of JSON."""
        if params:
            path += "?" + urlencode({k: v for k, v in params.items() if v is not None})
        # Cloudflare's bot check blocks Python's default User-Agent (error 1010), so name ourselves.
        headers = {"Authorization": f"Bearer {self.token}", "X-Tiantasks": "1",
                   "Content-Type": "application/json", "User-Agent": f"tiantasks-cli/{VERSION}"}
        agent = agent_name()
        if agent:
            headers["X-Tiantasks-Agent"] = agent
        if self.directive and method != "GET":
            headers["X-Tiantasks-Directive"] = quote(self.directive)
        data = json.dumps(body).encode() if body is not None else None
        if upload:
            data, headers["Content-Type"] = upload
        req = urllib.request.Request(self.url + path, data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=60, context=ssl_context()) as r:
                return r.read() if raw else json.load(r)
        except urllib.error.HTTPError as e:
            try:
                msg = json.load(e).get("error")
            except Exception:
                msg = None
            if e.code == 401:
                msg = "the shared board rejected your token; run `tt login` again"
            raise TTError(msg or f"{self.url} returned HTTP {e.code}", e.code)
        except urllib.error.URLError as e:
            raise TTError(f"can't reach {self.url}: {e.reason}")

    def _item(self, ref):
        return f"/api/items/{quote(str(ref).strip().lstrip('#'))}"

    def me(self):
        if self._me is None:
            self._me = self._req("GET", "/api/me")
        return self._me

    def get(self, ref):
        return self._req("GET", self._item(ref))

    def create(self, kind, title, project, actor, body="", priority="", tags=(), assignee=""):
        return self._req("POST", "/api/items", {
            "kind": kind, "title": title, "project": project, "body": body,
            "priority": priority, "tags": list(tags), "assignee": assignee})

    def update(self, ref, actor, **ch):
        return self._req("PATCH", self._item(ref), ch)

    def comment(self, ref, actor, text, parent_id=None):
        return self._req("POST", self._item(ref) + "/comment", {"text": text, "parent_id": parent_id})

    def comments(self, ref):
        return self._req("GET", self._item(ref) + "/comments")

    def delete_comment(self, cid, actor, is_admin=None):
        return self._req("DELETE", f"/api/comments/{int(cid)}")

    def delete(self, ref, actor):
        return self._req("DELETE", self._item(ref))

    def list(self, project=None, statuses=None, kind=None, assignee=None, grep=None):
        return self._req("GET", "/api/items", params={
            "project": project, "status": ",".join(statuses) if statuses else None,
            "kind": kind, "assignee": assignee, "grep": grep})

    def events(self, limit=40, project=None, item_id=None):
        return self._req("GET", "/api/events",
                         params={"limit": limit, "project": project, "item_id": item_id})

    def projects(self):
        return self._req("GET", "/api/projects")

    def version(self):
        return self._req("GET", "/api/version")["v"]

    def attach(self, ref, actor, name, mime, data):
        return self._req("POST", self._item(ref) + "/attachments", params={"name": name}, upload=(data, mime))

    def attachments(self, ref):
        return self._req("GET", self._item(ref) + "/attachments")

    def attachment_bytes(self, att_id):
        return self._req("GET", f"/api/attachments/{int(att_id)}", raw=True)

    def set_fields(self, ref, actor, fields):
        return self._req("PATCH", self._item(ref), {"fields": fields})

    def agents(self):
        return self._req("GET", "/api/agents")

    def report_agent(self, name, principal, info):
        return self._req("PUT", f"/api/agents/{quote(name)}", info)

    def initiatives(self):
        return self._req("GET", "/api/initiatives")

    def put_initiative(self, slug, principal, info):
        return self._req("PUT", f"/api/initiatives/{quote(slug, safe='/')}", info)

    def checkpoint(self, actor, principal, text, ref="", initiative="", link="", attachment=None, source=None):
        return self._req("POST", "/api/checkpoints", {"text": text, "ref": ref, "initiative": initiative,
                                                      "link": link, "attachment": attachment, "source": source})

    def checkpoints(self, ref=None, initiative=None, limit=100):
        return self._req("GET", "/api/checkpoints", params={"ref": ref, "initiative": initiative, "limit": limit})

    def flag(self, actor, principal, text, ref="", initiative="", to="", urgent=False, kind="flag"):
        return self._req("POST", "/api/flags", {"text": text, "ref": ref, "initiative": initiative,
                                                "to": to, "urgent": urgent, "kind": kind})

    def flags(self, to=None, status=None, ref=None, initiative=None, limit=100):
        return self._req("GET", "/api/flags", params={"to": to, "status": status, "ref": ref,
                                                      "initiative": initiative, "limit": limit})

    def set_flag(self, fid, actor, user=None, is_agent=None, status="acked", note=""):
        if status == "acked":
            return self._req("POST", f"/api/flags/{int(fid)}/ack", {"note": note})
        return self._req("PATCH", f"/api/flags/{int(fid)}", {"status": status, "note": note})

    def directives(self, ref=None, unchecked=False, limit=100):
        return self._req("GET", "/api/directives", params={"ref": ref, "unchecked": "1" if unchecked else None,
                                                           "limit": limit})

    def check_directive(self, did, user, verified):
        return self._req("PATCH", f"/api/directives/{int(did)}", {"verified": bool(verified)})

    def close(self):
        pass


# ---------------------------------------------------------------- context

def current_actor(args=None):
    store = getattr(args, "store", None)
    if isinstance(store, RemoteStore):
        return store.me()["actor"]  # the server decides who you are from your token
    if args is not None and getattr(args, "actor", None):
        return args.actor
    if os.environ.get("TIANTASKS_ACTOR"):
        return os.environ["TIANTASKS_ACTOR"]
    return agent_name() or getpass.getuser()


def current_project(args=None):
    if args is not None and getattr(args, "project", None):
        return args.project
    if os.environ.get("TIANTASKS_PROJECT"):
        return os.environ["TIANTASKS_PROJECT"]
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return Path(r.stdout.strip()).name if r.returncode == 0 else Path.cwd().name


# ---------------------------------------------------------------- terminal output

COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def _c(code):
    return lambda s: f"\033[{code}m{s}\033[0m" if COLOR else s


dim, bold, green, red, yellow, cyan, strike = map(_c, ("2", "1", "32", "31", "33", "36", "9"))
PRIO_COLOR = {"crit": red, "high": red, "med": yellow, "low": dim}


def die(msg, code=1):
    print(red(f"tiantasks: {msg}"), file=sys.stderr)
    sys.exit(code)


def show_ts(s):
    """Timestamps from a hosted board are UTC ('...Z'); show them in local time."""
    if s and s.endswith("Z"):
        s = (dt.datetime.fromisoformat(s[:-1] + "+00:00").astimezone()
             .replace(tzinfo=None).isoformat(timespec="seconds"))
    return (s or "").replace("T", " ")


def fmt(it, show_project=False):
    box = {"done": green("[x]"), "doing": yellow("[~]"), "open": "[ ]"}[it["status"]]
    ref = (red if it["kind"] == "issue" else cyan)(it["ref"].ljust(5))
    title = strike(dim(it["title"])) if it["status"] == "done" else it["title"]
    extras = []
    if it["status"] == "doing":
        extras.append(yellow("in progress"))
    if it["priority"]:
        extras.append(PRIO_COLOR[it["priority"]](it["priority"]))
    if it["assignee"]:
        extras.append(cyan("@" + it["assignee"]))
    extras += [dim("#" + t) for t in it["tags"]]
    if it.get("attachments"):
        extras.append(dim(f"📎{len(it['attachments'])}"))
    if show_project:
        extras.append(dim(f"[{it['project']}]"))
    if it["status"] == "done":
        extras.append(dim(f"resolved {show_ts(it['resolved_at'])[:10]}" + (f": {it['note']}" if it["note"] else "")))
    return f"{box} {ref} {title}" + ("  " + " ".join(extras) if extras else "")


def emit(args, item, verb, color=green):
    if getattr(args, "json", False):
        print(json.dumps(item, indent=2))
    else:
        print(f"{color(verb)} {fmt(item)}")


# ---------------------------------------------------------------- commands

def cmd_add(args, kind=None):
    kind = kind or ("issue" if args.issue else "task")
    assignee = args.to
    if assignee == "me":
        assignee = current_actor(args)
    it = args.store.create(kind, " ".join(args.text), current_project(args), current_actor(args),
                           body=args.desc or "", priority=args.priority or "",
                           tags=args.tag or [], assignee=assignee or "")
    fields = dict(parse_field(f) for f in args.field or [])
    if args.initiative:
        fields["initiative"] = args.initiative
    if fields:
        it = args.store.set_fields(it["ref"], current_actor(args), fields)
    for path in args.file or []:
        attach_file(args, it["ref"], path)
    if args.file:
        it = args.store.get(it["ref"])
    emit(args, it, "added")


def attach_file(args, ref, path):
    p = Path(path).expanduser()
    try:
        data = p.read_bytes()
    except OSError as e:
        raise TTError(f"can't read {path}: {e.strerror}")
    mime = mimetypes.guess_type(p.name)[0] or "application/octet-stream"
    return args.store.attach(ref, current_actor(args), p.name, mime, data)


def cmd_attach(args):
    for path in args.files:
        a = attach_file(args, args.id, path)
        if getattr(args, "json", False):
            print(json.dumps(a, indent=2))
            continue
        info = dim("(#%s, %s)" % (a["id"], human_size(a["size"])))
        print(f"{cyan('attached')} {a['name']} {info} to {args.id.upper()}")


def cmd_files(args):
    """List an item's screenshots; --save downloads them (how Claude looks at them)."""
    files = args.store.attachments(args.id)
    if args.save:
        out = Path(args.save).expanduser()
        out.mkdir(parents=True, exist_ok=True)
        for a in files:
            dest = out / f"{a['id']}-{a['name']}"
            dest.write_bytes(args.store.attachment_bytes(a["id"]))
            a["path"] = str(dest)
    if args.json:
