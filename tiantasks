.comments { display: grid; gap: 8px; }
.comments h3, .detail h3 { margin: 0; font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
.thread { display: grid; gap: 6px; }
.cmt .cacts { float: right; display: flex; gap: 2px; opacity: .6; }
.cmt:hover .cacts, .cmt:focus-within .cacts { opacity: 1; }
.cmt.deleted { font-style: italic; color: var(--muted); }
.fold { justify-self: start; display: flex; align-items: center; gap: 6px; margin-left: 12px; padding: 0 6px 2px 0;
  border: 0; background: none; color: var(--accent); font-size: 12px; }
.fold .fline { width: 14px; height: 12px; margin-top: -10px; border-left: 2px solid var(--line);
  border-bottom: 2px solid var(--line); border-bottom-left-radius: 7px; }
.fold:hover .fline { border-color: var(--accent); }
.replies { display: grid; gap: 6px; margin-left: 12px; padding-left: 14px; border-left: 2px solid var(--line); }
.replybox { margin-left: 26px; }
.icon { padding: 4px 10px; min-width: 36px; }
.cmt { background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 7px 10px; font-size: 13px; }
.cmt .by { font-size: 12px; color: var(--muted); margin-bottom: 2px; }
.cmt .by b { color: var(--ink); font-weight: 600; }
.cmt .txt { white-space: pre-wrap; overflow-wrap: anywhere; }
.hist { font-size: 12px; color: var(--muted); display: grid; gap: 3px; max-height: 220px; overflow: auto; }
.hist b { color: var(--ink); font-weight: 600; }

details.resolved > summary { list-style: none; cursor: pointer; padding: 10px 16px; border-top: 1px solid var(--line);
  color: var(--muted); font-size: 13px; }
details.resolved > summary::-webkit-details-marker { display: none; }
details.resolved > summary::before { content: "▸ "; }
details.resolved[open] > summary::before { content: "▾ "; }

aside h2 { font-size: 15px; margin: 0; padding: 14px 16px 10px; }
.ev { border-top: 1px solid var(--line); padding: 8px 16px; font-size: 13px; overflow-wrap: anywhere; }
.ev .t { color: var(--muted); font-size: 12px; }
.ev b { font-weight: 600; }
.ev .claude { color: var(--accent); }
.hint { padding: 12px 16px 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); }
#acct a { color: inherit; }
code { font: 12px ui-monospace, SFMono-Regular, Menlo, monospace; background: var(--chip); padding: 1px 5px; border-radius: 4px; }

/* ---------- views: Queues | Board, and the ticket modal */
[hidden] { display: none !important; }
:root { --panel-2: #faf9f6; --faint: #a4a3a0; --line-2: #eeece6; --ai1: #6f5cff; --ai2: #1fa6e8;
  --shadow-2: 0 1px 2px rgba(20,20,30,.05), 0 6px 18px rgba(20,20,30,.07); --shadow-3: 0 30px 80px rgba(20,20,30,.22), 0 4px 14px rgba(20,20,30,.08);
  --ring: color-mix(in srgb, var(--accent) 40%, transparent); --mono: ui-monospace, SFMono-Regular, Menlo, monospace; }
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) { --panel-2: #161722; --faint: #5a6080; --line-2: #222434; --ai1: #a393ff; --ai2: #5cc8ff;
    --shadow-2: 0 6px 18px rgba(0,0,0,.35); --shadow-3: 0 30px 80px rgba(0,0,0,.6); }
}
:root[data-theme="dark"] { --panel-2: #161722; --faint: #5a6080; --line-2: #222434; --ai1: #a393ff; --ai2: #5cc8ff;
  --shadow-2: 0 6px 18px rgba(0,0,0,.35); --shadow-3: 0 30px 80px rgba(0,0,0,.6); }
.i { width: 16px; height: 16px; flex: none; vertical-align: -3px; }
.grow { flex: 1; }
kbd { font: 11px var(--mono); border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 4px; padding: 0 4px; color: var(--muted); background: var(--panel); }
.views { display: inline-flex; padding: 3px; gap: 2px; background: var(--chip); border-radius: 10px; }
.views button { border: 0; background: none; border-radius: 7px; padding: 5px 12px; display: inline-flex; gap: 6px; align-items: center; color: var(--muted); font-weight: 500; }
.views button.on { background: var(--panel); color: var(--ink); box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 0 0 1px var(--line); }
.views .n { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }
.item .title { cursor: pointer; }
.pane { max-width: 1320px; margin: 0 auto; padding: 18px 20px 40px; }
@media (max-width: 720px) { .pane { padding: 14px 16px 32px; } }
.btool { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 12px; }
.chip { border-radius: 999px; padding: 4px 11px; font-size: 13px; color: var(--muted); background: none; }
.chip.on { background: var(--ink); color: var(--panel); border-color: var(--ink); }
.board { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; align-items: start; }
.col { background: color-mix(in srgb, var(--chip) 55%, transparent); border: 1px solid var(--line); border-radius: 14px;
  display: flex; flex-direction: column; min-height: 200px; max-height: calc(100vh - 150px); min-width: 0; }
.col-h { display: flex; align-items: center; gap: 8px; padding: 10px 10px 8px 14px; }
.col-h h2 { font-size: 13px; margin: 0; font-weight: 600; }
.col-body { padding: 2px 8px 10px; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; flex: 1; min-height: 60px;
  border-radius: 0 0 14px 14px; transition: background .12s, box-shadow .12s; }
.col-body.over { background: color-mix(in srgb, var(--accent) 8%, transparent); box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 35%, transparent); }
.col-empty { color: var(--faint); font-size: 13px; text-align: center; padding: 22px 8px; border: 1.5px dashed var(--line); border-radius: 10px; }
.icon-btn { display: inline-grid; place-items: center; width: 30px; height: 30px; padding: 0; border-color: transparent; background: none; color: var(--muted); }
.icon-btn:hover { background: var(--chip); color: var(--ink); border-color: transparent; }
.si { width: 15px; height: 15px; flex: none; }
.si-open { color: var(--faint); } .si-doing { color: var(--warn); } .si-done { color: var(--ok); }
.pi { width: 15px; height: 15px; flex: none; color: var(--ink); } .pi-crit { color: var(--issue); }
.av { width: 22px; height: 22px; border-radius: 50%; display: inline-grid; place-items: center; flex: none;
  font-size: 10px; font-weight: 700; color: #fff; user-select: none; }
.av.lg { width: 26px; height: 26px; font-size: 11px; }
.av.none { border: 1.5px dashed var(--faint); background: none; }
.av.ai { background: linear-gradient(135deg, var(--ai1), var(--ai2)); }
.av.ai .i { width: 13px; height: 13px; fill: #fff; stroke: none; }
.kind-dot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
.kind-dot.task { background: var(--task); } .kind-dot.issue { background: var(--issue); }
.kcard { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 10px 11px; box-shadow: var(--shadow);
  cursor: pointer; display: grid; gap: 7px; position: relative; transition: box-shadow .15s, transform .15s, border-color .15s; }
.kcard:hover { box-shadow: var(--shadow-2); border-color: color-mix(in srgb, var(--muted) 40%, var(--line)); }
.kcard.dragging { opacity: .45; transform: rotate(1.5deg) scale(.98); }
.kcard .cover { display: block; width: calc(100% + 22px); margin: -10px -11px 0; height: 128px; object-fit: cover; object-position: top;
  border-radius: 9px 9px 0 0; border-bottom: 1px solid var(--line); background: var(--chip); }
.kc-top { display: flex; align-items: center; gap: 7px; min-width: 0; }
.kc-title { font-size: 14px; line-height: 1.35; overflow-wrap: anywhere; font-weight: 500; }
.kcard.done .kc-title { color: var(--muted); }
.kc-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; min-width: 0; }
.kc-meta .tag { font-size: 11px; color: var(--muted); background: var(--chip); border-radius: 5px; padding: 0 6px; }
.kc-meta .age { font-size: 11px; color: var(--faint); margin-left: auto; }
.kc-note { font-size: 12px; color: var(--muted); border-left: 2px solid var(--ok); padding-left: 7px; overflow-wrap: anywhere; }
.cnt { display: inline-flex; align-items: center; gap: 3px; color: var(--muted); font-size: 12px; }
.cnt .i { width: 13px; height: 13px; }
.kcard.live::before { content: ""; position: absolute; inset: -1px; border-radius: 11px; padding: 1.5px; pointer-events: none;
  background: linear-gradient(120deg, var(--ai1), var(--ai2), var(--ai1)); background-size: 200% 100%;
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
  animation: flow 3s linear infinite; }
@keyframes flow { to { background-position: 200% 0; } }
@media (prefers-reduced-motion: reduce) { .kcard.live::before { animation: none; } }
.working { font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; color: var(--ai1); }
.working .i { fill: var(--ai1); stroke: none; width: 12px; height: 12px; }
.more { background: none; border: 1px dashed var(--line); color: var(--muted); font-size: 12px; }
@media (max-width: 900px) {
  .board { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin: 0 -20px; padding: 0 20px 8px; scrollbar-width: none; }
  .board::-webkit-scrollbar { display: none; }
  .col { flex: 0 0 min(86vw, 380px); scroll-snap-align: center; max-height: none; }
}
@media (max-width: 720px) { .board { margin: 0 -16px; padding: 0 16px 8px; } }

#tkt { border: 0; padding: 0; background: none; color: var(--ink); max-width: none; max-height: none; }
#tkt::backdrop { background: rgba(15, 15, 20, .42); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); }
#tkt[open] { animation: pop .16s ease-out; }
@keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.985); } }
.m-wrap { position: relative; width: min(1040px, calc(100vw - 32px)); height: min(820px, calc(100vh - 48px)); background: var(--panel);
  border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow-3); display: flex; flex-direction: column; overflow: hidden; }
.m-head { display: flex; align-items: center; gap: 8px; padding: 10px 12px 10px 18px; border-bottom: 1px solid var(--line); flex: none; }
.kind-badge { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; padding: 2px 7px; border-radius: 5px; }
.kind-badge.task { color: var(--task); background: color-mix(in srgb, var(--task) 12%, transparent); }
.kind-badge.issue { color: var(--issue); background: color-mix(in srgb, var(--issue) 12%, transparent); }
.crumb { color: var(--muted); font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.m-titlebar { padding: 14px 26px 2px 20px; flex: none; }
textarea.m-title { width: 100%; border: 0; background: none; font-size: 22px; font-weight: 650; letter-spacing: -0.015em; line-height: 1.25;
  padding: 4px 6px; margin: 0; resize: none; overflow: hidden; border-radius: 8px; }
textarea.m-title:hover, textarea.m-title:focus { background: var(--panel-2); outline: none; }
.m-body { display: grid; grid-template-columns: minmax(0, 1fr) 290px; flex: 1; min-height: 0; }
.m-main { overflow-y: auto; padding: 6px 26px 28px; min-width: 0; }
.m-side { overflow-y: auto; border-left: 1px solid var(--line); background: var(--panel-2); padding: 16px; display: grid; gap: 16px; align-content: start; }
.sec { margin-top: 22px; }
.sec-h { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 8px; }
.md { font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; border-radius: 8px; padding: 6px 8px; margin: 0 -8px; cursor: text; min-height: 34px; }
.md:hover { background: var(--panel-2); }
.md.placeholder { color: var(--faint); }
.md p, .md ul, .md ol, .md pre, .md blockquote, .md h4 { margin: 0 0 .6em; }
.md > :last-child { margin-bottom: 0; }
.md h4 { font-size: 15px; }
.md ul, .md ol { padding-left: 1.4em; }
.md pre { background: var(--chip); padding: 10px 12px; border-radius: 8px; overflow-x: auto; }
.md pre code { background: none; padding: 0; }
.md blockquote { border-left: 3px solid var(--line); padding-left: 10px; color: var(--muted); }
.md a { color: var(--accent); }
.editor { display: grid; gap: 8px; }
.editor textarea { width: 100%; min-height: 160px; line-height: 1.55; background: var(--panel); font: inherit; resize: vertical; }
.editor .bar2 { display: flex; gap: 8px; align-items: center; }
.help { font-size: 12px; color: var(--faint); }
.gal { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
.gtile { position: relative; min-width: 0; }
.gshot { display: block; width: 100%; aspect-ratio: 4 / 3; padding: 0; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--chip); }
.gshot img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; transition: transform .25s; }
.gshot:hover img { transform: scale(1.03); }
.gtile .del { position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; border-radius: 7px; padding: 0; display: grid; place-items: center;
  background: rgba(0,0,0,.55); color: #fff; border: 0; opacity: 0; transition: opacity .15s; }
.gtile .del .i { width: 13px; height: 13px; }
.gtile:hover .del, .gtile:focus-within .del { opacity: 1; }
@media (hover: none) { .gtile .del { opacity: 1; } }
.gadd { border: 1.5px dashed var(--line); border-radius: 10px; display: grid; place-items: center; text-align: center; gap: 4px; padding: 14px;
  color: var(--muted); font-size: 12px; cursor: pointer; aspect-ratio: 4 / 3; background: none; width: 100%; }
.gadd:hover { border-color: var(--accent); color: var(--accent); }
.gadd.wide { aspect-ratio: auto; padding: 18px; grid-auto-flow: column; gap: 8px; }
.gup { display: grid; place-items: center; aspect-ratio: 4 / 3; border-radius: 10px; background: var(--chip); color: var(--muted); font-size: 12px; animation: pulse 1.2s ease-in-out infinite; }
@keyframes pulse { 50% { opacity: .55; } }
.m-wrap.dropping::after { content: "Drop to attach"; position: absolute; inset: 8px; border: 2px dashed var(--accent); border-radius: 12px;
  display: grid; place-items: center; font-size: 18px; font-weight: 600; color: var(--accent); background: color-mix(in srgb, var(--panel) 80%, transparent); pointer-events: none; }
.composer { display: flex; gap: 10px; margin-top: 10px; }
.composer .box { flex: 1; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); overflow: hidden; }
.composer .box:focus-within { box-shadow: 0 0 0 3px var(--ring); }
.composer textarea { width: 100%; border: 0; min-height: 64px; resize: none; background: none; padding: 10px 12px 4px; font: inherit; }
.composer textarea:focus { outline: none; }
.composer .bar2 { display: flex; align-items: center; gap: 6px; padding: 4px 6px 6px 10px; }
details.hist-d { margin-top: 18px; }
details.hist-d > summary { cursor: pointer; font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
.tl { display: grid; gap: 2px; margin-top: 8px; }
.tl-ev { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; color: var(--muted); padding: 4px 0; }
.tl-ev .bul { width: 18px; display: grid; place-items: center; flex: none; padding-top: 2px; }
.tl-ev .bul i { width: 7px; height: 7px; border-radius: 50%; background: var(--line); display: block; margin-top: 4px; }
.tl-ev b { color: var(--ink); font-weight: 600; }
.tl-ev .quote { display: block; color: var(--ink); margin-top: 2px; }
.prop { display: grid; gap: 6px; }
.prop > label, .prop > .lbl { font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
.prop select, .prop input, .prop textarea { width: 100%; background: var(--panel); font: inherit; }
.stseg { display: grid; grid-template-columns: repeat(3, 1fr); background: var(--chip); padding: 3px; border-radius: 10px; gap: 2px; }
.stseg button { border: 0; background: none; border-radius: 7px; padding: 6px 2px; font-size: 12px; display: grid; justify-items: center; gap: 3px; color: var(--muted); }
.stseg button.on { background: var(--panel); color: var(--ink); box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 0 0 1px var(--line); font-weight: 600; }
.resolve-row { display: flex; gap: 6px; }
.resolve-row input { flex: 1; }
.facts { font-size: 12px; color: var(--muted); display: grid; gap: 3px; }
.facts b { color: var(--ink); font-weight: 500; }
.agent { border-radius: 12px; padding: 12px; display: grid; gap: 8px; background: var(--panel); border: 1px solid color-mix(in srgb, var(--ai1) 30%, var(--line)); }
.agent-h { display: flex; align-items: center; gap: 6px; font-weight: 600; font-size: 13px; }
.agent-h .i { fill: var(--ai1); stroke: none; }
.agent p { margin: 0; font-size: 12px; color: var(--muted); }
.agent .btns { display: flex; gap: 6px; flex-wrap: wrap; }
.agent .btns button { font-size: 12px; padding: 5px 9px; }
.agent button.ai-btn { background: linear-gradient(135deg, var(--ai1), var(--ai2)); color: #fff; border: 0; font-weight: 600; }
.agent code { display: block; overflow-x: auto; white-space: nowrap; padding: 5px 7px; }
@media (max-width: 820px) {
  #tkt { margin: 0; width: 100%; height: 100%; }
  .m-wrap { width: 100vw; height: 100dvh; border-radius: 0; border: 0; display: block; overflow-y: auto; overscroll-behavior: contain; }
  .m-head { padding-top: max(10px, env(safe-area-inset-top)); position: sticky; top: 0; z-index: 2; background: var(--panel); }
  .m-titlebar { padding: 12px 16px 8px 10px; }
  .m-body { display: flex; flex-direction: column; }
  .m-main { overflow: visible; padding: 16px 16px 28px; order: 2; }
  .m-side { overflow: visible; border-left: 0; border-bottom: 1px solid var(--line); order: 1; grid-template-columns: 1fr 1fr; padding: 14px 16px; }
  .m-side .full { grid-column: 1 / -1; }
  .agent p { display: none; }
  textarea.m-title { font-size: 19px; }
}
#toasts { position: fixed; bottom: max(16px, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); display: grid; gap: 8px; z-index: 50; justify-items: center; pointer-events: none; }
.toast { background: var(--ink); color: var(--panel); padding: 8px 14px; border-radius: 10px; font-size: 13px; box-shadow: var(--shadow-2); animation: pop .16s ease-out; }
.toast.err { background: var(--issue); color: #fff; }

/* ---------- team: people, their agents, initiatives, flags */
#fWho, #fProject { max-width: 170px; }
.sdot { width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--faint); display: inline-block; }
.sdot.s-working { background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent); animation: breathe 2s ease-in-out infinite; }
.sdot.s-waiting { background: var(--warn); }
.sdot.s-idle { background: color-mix(in srgb, var(--muted) 70%, transparent); }
.sdot.s-offline { background: none; border: 1.5px solid var(--faint); }
@keyframes breathe { 50% { box-shadow: 0 0 0 5px color-mix(in srgb, var(--ok) 8%, transparent); } }
@media (prefers-reduced-motion: reduce) { .sdot.s-working { animation: none; } }
.alert { background: var(--issue); color: #fff; border-radius: 999px; padding: 0 6px; font-size: 11px; font-weight: 700; }
.team-h { display: flex; align-items: center; gap: 10px; margin: 26px 0 10px; }
.team-h h2 { margin: 0; font-size: 15px; display: flex; align-items: center; gap: 8px; }
.team-h:first-child { margin-top: 0; }
.needs { border: 1px solid color-mix(in srgb, var(--warn) 45%, var(--line)); background: color-mix(in srgb, var(--warn) 6%, var(--panel));
  border-radius: 14px; padding: 4px 14px 8px; }
.need { padding: 10px 0; border-top: 1px solid var(--line); display: grid; gap: 6px; }
.need:first-of-type { border-top: 0; }
.need-h { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: 13px; color: var(--muted); }
.need-h b { color: var(--ink); }
.need .md { cursor: auto; margin: 0; padding: 0; min-height: 0; }
.need .md:hover { background: none; }
.need-a { display: flex; gap: 6px; }
.need-a input { flex: 1; background: var(--panel); }
.urgent { font-size: 11px; font-weight: 700; color: #fff; background: var(--issue); border-radius: 5px; padding: 0 6px; }
.agents { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 10px; }
.acard { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 11px 12px; display: grid; gap: 6px; align-content: start; min-width: 0; }
.acard.s-working { border-color: color-mix(in srgb, var(--ok) 40%, var(--line)); }
.acard.s-waiting { border-color: color-mix(in srgb, var(--warn) 45%, var(--line)); }
.ac-top { display: flex; align-items: center; gap: 7px; min-width: 0; }
.ac-top .help { white-space: nowrap; }
.ac-name { font-weight: 600; font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--mono); }
.akind { font-size: 10px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); background: var(--chip); border-radius: 4px; padding: 0 5px; flex: none; }
.ichip { font-size: 12px; color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); border-radius: 6px; padding: 1px 7px; display: inline-block;
  max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ac-doing { font-size: 13px; color: var(--muted); overflow-wrap: anywhere; }
.ac-cp { font-size: 13px; border-left: 2px solid var(--accent); padding-left: 8px; overflow-wrap: anywhere; }
.ac-cp a { color: var(--accent); }
.ac-foot { display: flex; align-items: center; gap: 8px; }
.ac-foot button { font-size: 12px; padding: 3px 9px; }
.flagbox { display: grid; gap: 6px; }
.flagbox textarea { width: 100%; background: var(--panel); font: inherit; resize: vertical; min-height: 56px; }
.flagbox .bar2 { display: flex; align-items: center; gap: 8px; }
.chk { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; color: var(--muted); }
details.offline { margin-top: 10px; }
details.offline > summary { cursor: pointer; font-size: 12px; color: var(--muted); }
.inits { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 10px; }
.icard { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; display: grid; gap: 8px; min-width: 0; }
.ic-top { display: flex; align-items: baseline; gap: 8px; }
.ic-top h3 { margin: 0; font-size: 15px; }
.owner { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); flex-wrap: wrap; }
.owner b { color: var(--ink); font-weight: 600; }
.steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; }
.steps li { font-size: 12px; color: var(--muted); display: flex; gap: 6px; }
.steps li::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--line); margin-top: 6px; flex: none; }
.steps li.auto::before { background: color-mix(in srgb, var(--accent) 45%, var(--line)); }
.ic-tix { display: flex; gap: 6px; flex-wrap: wrap; }
.ic-tix a { font: 12px var(--mono); color: var(--muted); text-decoration: none; border: 1px solid var(--line); border-radius: 6px; padding: 0 6px; }
.ic-tix a:hover { color: var(--accent); border-color: var(--accent); }
.pcard { border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; display: grid; gap: 8px; margin: 4px 0 6px; background: var(--panel-2); }
.pc-latest { font-size: 15px; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.pc-latest a { color: var(--accent); font-weight: 500; font-size: 13px; }
.pc-latest.none { font-weight: 400; color: var(--muted); font-size: 13px; }
.flags-l { display: grid; gap: 6px; }
.fl { border: 1px solid var(--line); border-radius: 10px; padding: 7px 9px; font-size: 12px; background: var(--panel); display: grid; gap: 3px; }
.fl-t { font-size: 13px; overflow-wrap: anywhere; }
.rcpt { display: flex; gap: 4px; align-items: center; flex-wrap: wrap; color: var(--faint); }
.rcpt .on { color: var(--ok); font-weight: 600; }
.rcpt .bad { color: var(--issue); font-weight: 600; }
.fl-note { color: var(--ink); border-left: 2px solid var(--ok); padding-left: 6px; }
.dir { color: var(--ink); }
.dir .v { font-size: 11px; border-radius: 4px; padding: 0 5px; margin-left: 4px; }
.dir .v.ok { color: var(--ok); background: color-mix(in srgb, var(--ok) 14%, transparent); }
.dir .v.no { color: var(--issue); background: color-mix(in srgb, var(--issue) 12%, transparent); }
.dir .v.pending { color: var(--muted); background: var(--chip); }
.kc-cp { font-size: 12px; color: var(--muted); border-left: 2px solid var(--accent); padding-left: 7px; overflow-wrap: anywhere;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.kc-flag { font-size: 11px; font-weight: 600; color: var(--warn); }
.empty-team { color: var(--muted); font-size: 13px; padding: 18px; border: 1.5px dashed var(--line); border-radius: 12px; }
</style>
</head>
<body>
<header><div class="bar">
  <h1>Tiantasks <span class="dot" id="dot" title="Live"></span></h1>
  <nav class="views" role="tablist" aria-label="View" id="views"></nav>
  <label class="f">Project <select id="fProject"></select></label>
  <label class="f">Assigned to <select id="fWho"></select></label>
  <span class="spacer"></span>
  <span class="stats" id="stats"></span>
  <span class="stats" id="acct"></span>
  <button class="icon" id="themeBtn" title="Theme" aria-label="Theme"></button>
  <button class="primary" id="newBtn" title="Add a task or issue (N)">+ Add</button>
</div></header>

<main id="vQueues">
  <section class="card" id="qIssue"></section>
  <section class="card" id="qTask"></section>

  <aside class="card">
    <h2>Activity</h2>
    <div id="events"></div>
    <div class="hint">Changes from Claude Code show up here live. Assign items to a Claude
      (<b>claude</b>, or <b>claude-name</b> on a shared board), then in that repo ask it to
      “work through your Tiantasks queue”.</div>
  </aside>
</main>

<section class="pane" id="vBoard" hidden>
  <div class="btool"><div class="chips" id="kindChips" role="group" aria-label="Type"></div><span class="grow"></span><span class="stats" id="boardHint"></span></div>
  <div class="board" id="board"></div>
</section>

<section class="pane" id="vTeam" hidden><div id="team"></div></section>

<dialog id="tkt" aria-label="Ticket"><div class="m-wrap" id="mwrap"></div></dialog>
<div id="toasts" aria-live="polite"></div>

<dialog id="newDlg" aria-labelledby="newTitle">
  <form id="add" autocomplete="off" novalidate>
    <div class="dlg-head">
      <h2 id="newTitle">New task</h2>
      <div class="seg" role="group" aria-label="Kind">
        <button type="button" data-kind="task" class="on">Task</button>
        <button type="button" data-kind="issue">Issue</button>
      </div>
    </div>
    <label class="fld">Title <input name="title" maxlength="300" placeholder="What needs doing?"></label>
    <label class="fld">Description <textarea name="body" rows="5" placeholder="Details, steps to reproduce, links…"></textarea></label>
    <div class="fld">Screenshots
      <div class="drop" id="drop">
        <div class="thumbs" id="shots"></div>
        <p>Paste with ⌘V, drag images here, or <button type="button" class="link" id="pick">choose files</button></p>
      </div>
    </div>
    <div class="row4">
      <label class="fld">Priority
        <select name="priority"><option value="">None</option><option value="crit">crit</option>
          <option value="high">high</option><option value="med">med</option><option value="low">low</option></select></label>
      <label class="fld">Assignee <select name="assignee"></select></label>
      <label class="fld">Tags <input name="tags" placeholder="ui, auth"></label>
      <label class="fld">Project <input name="project" list="projList"></label>
    </div>
    <datalist id="projList"></datalist>
    <p class="err" id="addErr" role="alert"></p>
    <div class="dlg-foot">
      <span class="kbd">⌘↵ to add · Esc to cancel</span>
      <button type="button" id="cancel">Cancel</button>
      <button type="submit" class="primary" id="submit">Add task</button>
    </div>
  </form>
</dialog>
<dialog id="lightbox" aria-label="Screenshot"><img alt=""></dialog>
<input type="file" id="filePick" accept="image/png,image/jpeg,image/webp,image/gif" multiple hidden>

<script>
const $ = (s, el = document) => el.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const PR = {crit: 0, high: 1, med: 2, low: 3};
const saved = {
  get(k, d) { try { return localStorage.getItem('tt.' + k) ?? d; } catch { return d; } },
  set(k, v) { try { localStorage.setItem('tt.' + k, v); } catch {} },
};

let S = null, lastText = '', kind = 'task';
let project = saved.get('project', ''), who = saved.get('who', '');

async function api(method, path, body, quiet) {
  const r = await fetch(path, {method, headers: {'Content-Type': 'application/json', 'X-Tiantasks': '1'},
    body: body ? JSON.stringify(body) : undefined});
  const data = await r.json().catch(() => ({}));
  if (!r.ok) {
    const msg = data.error || ('Error ' + r.status);
    if (!quiet) alert(msg);
    throw new Error(msg);
  }
  return data;
}

function typing() {
  const a = document.activeElement;
  return !!(a && a.closest && a.closest('.item, #tkt, #vTeam') && ['INPUT', 'SELECT', 'TEXTAREA'].includes(a.tagName)) || dragId !== null;
}

// ---- screenshots: shrink big images in the browser so each fits the database's ~2 MB limit
const IMAGE_TYPES = ['image/png', 'image/jpeg', 'image/webp', 'image/gif'];
const MAX_BYTES = 1900000;
const EXT = {'image/png': 'png', 'image/jpeg': 'jpg', 'image/webp': 'webp', 'image/gif': 'gif'};
const canvasBlob = (c, type, q) => new Promise(r => c.toBlob(r, type, q));

async function prepareImage(file) {
  let bmp;
  try { bmp = await createImageBitmap(file); }
  catch { throw new Error(`${file.name || 'That file'} isn't an image this browser can read.`); }
  const longest = Math.max(bmp.width, bmp.height);
  if (IMAGE_TYPES.includes(file.type) && longest <= 1920 && file.size <= 600000) return file;
  const scale = Math.min(1, 1920 / longest);
  const c = document.createElement('canvas');
  c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
  const g = c.getContext('2d');
  g.fillStyle = '#fff'; g.fillRect(0, 0, c.width, c.height);
  g.drawImage(bmp, 0, 0, c.width, c.height);
  for (const q of [0.9, 0.8, 0.65, 0.5, 0.35]) {
    let b = await canvasBlob(c, 'image/webp', q);
    if (!b || b.type !== 'image/webp') b = await canvasBlob(c, 'image/jpeg', q);  // Safari can't encode WebP
    if (b && b.size <= MAX_BYTES) return b;
  }
  throw new Error(`${file.name || 'That image'} is too large, even after shrinking it.`);
}

async function uploadImage(itemId, file) {
  const blob = await prepareImage(file);
  const base = (file.name || `screenshot-${new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-')}`).replace(/\.[^.]+$/, '');
  const name = `${base}.${EXT[blob.type] || 'png'}`;
  const r = await fetch(`/api/items/${itemId}/attachments?name=${encodeURIComponent(name)}`,
    {method: 'POST', headers: {'Content-Type': blob.type, 'X-Tiantasks': '1'}, body: blob});
  if (!r.ok) throw new Error((await r.json().catch(() => ({}))).error || `Upload failed (${r.status})`);
}

const imagesFrom = list => [...(list || [])].filter(f => f.type.startsWith('image/'));

// Every write bumps a version number, so polling it is one tiny query. The full board is
// only fetched when something changed, and nothing is polled while the tab is hidden.
let lastVersion = null;
async function tick() {
  if (document.hidden || typing()) return;
  try {
    const r = await fetch('/api/version');
    if (r.status === 401) { location.reload(); return; }
    const {v, build} = await r.json();
    $('#dot').classList.remove('off');
    // A new release went live: reload onto it, but never out from under an open ticket or dialog.
    if (build && pageBuild && build !== pageBuild && !M && !dlg.open) { location.reload(); return; }
    pageBuild = pageBuild || build;
    if (v !== lastVersion) { lastVersion = v; await refresh(true); if (M) loadModal(); }
  } catch { $('#dot').classList.add('off'); }
}

async function refresh(force) {
  try {
    const r = await fetch('/api/state?project=' + encodeURIComponent(project));
    if (r.status === 401) { location.reload(); return; }
    const text = await r.text();
    $('#dot').classList.remove('off');
    if (!force && text === lastText) return;
    lastText = text; S = JSON.parse(text);
    if (project && !S.projects.some(p => p.project === project)) { project = ''; return refresh(true); }
    render();
  } catch { $('#dot').classList.add('off'); }
}

function ago(iso) {
  const s = (Date.now() - new Date(iso).getTime()) / 1000;
  if (s < 60) return 'just now';
  if (s < 3600) return Math.floor(s / 60) + 'm ago';
  if (s < 86400) return Math.floor(s / 3600) + 'h ago';
  if (s < 86400 * 7) return Math.floor(s / 86400) + 'd ago';
  return iso.slice(0, 10);
}

const byQueue = (a, b) => (a.status === 'doing' ? 0 : 1) - (b.status === 'doing' ? 0 : 1)
  || (PR[a.priority] ?? 9) - (PR[b.priority] ?? 9) || a.created_at.localeCompare(b.created_at);

function options(list, sel) {
  return list.map(([v, l]) => `<option value="${esc(v)}"${v === sel ? ' selected' : ''}>${esc(l)}</option>`).join('');
}
function assigneeOptions(sel) {
  return options([['', 'Unassigned'], ...S.assignees.map(n => [n, n === S.me ? `${n} (you)` : n])], sel);
}

function itemHTML(it) {
  const done = it.status === 'done';
  const meta = [];
  if (it.status === 'doing') meta.push(`<span class="pill st">In progress</span>`);
  if (it.priority) meta.push(`<span class="pill p-${it.priority}">${it.priority}</span>`);
  if (!project) meta.push(`<span class="pill">${esc(it.project)}</span>`);
  it.tags.forEach(t => meta.push(`<span class="pill">#${esc(t)}</span>`));
  const shots = it.attachments || [];
  if (shots.length) meta.push(`<span class="pill" title="${shots.length} screenshot${shots.length > 1 ? 's' : ''}">📎 ${shots.length}</span>`);
  if (done) {
    if (it.assignee) meta.push(`<span class="pill who">@${esc(it.assignee)}</span>`);
    meta.push(`<span class="pill">resolved ${ago(it.resolved_at)}</span>`);
  } else {
    meta.push(`<select data-act="assign" aria-label="Assignee">${assigneeOptions(it.assignee)}</select>`);
    meta.push(it.status === 'doing'
      ? `<button class="link" data-act="pause">Pause</button>`
      : `<button class="link" data-act="start">Start</button>`);
  }
  return `<div class="item ${it.status}" data-id="${it.id}">
    <div class="row">
      <button class="check" data-act="toggle" title="${done ? 'Reopen' : 'Resolve'}" aria-label="${done ? 'Reopen' : 'Resolve'} ${it.ref}">${done ? '✓' : ''}</button>
      <span class="ref">${it.ref}</span>
      <span class="title" data-act="open" title="Open ${it.ref}">${esc(it.title)}</span>
    </div>
    <div class="meta">${meta.join('')}</div>
    ${done && it.note ? `<div class="note">${esc(it.note)}</div>` : ''}
  </div>`;
}

const COMMENT_ACTIONS = ['commented', 'added a comment', 'replied', 'deleted a comment'];
const openThreads = new Set();   // top-level comment ids whose replies are expanded
const replyingTo = new Map();    // item id -> comment id being replied to
let focusReply = false;

function commentHTML(c, isReply) {
  if (c.deleted) return `<div class="cmt deleted">${isReply ? 'Reply' : 'Comment'} deleted</div>`;
  return `<div class="cmt" data-cid="${c.id}">
    <div class="by"><b>${esc(c.author)}</b> · ${ago(c.at)}
      <span class="cacts"><button class="link" data-act="reply" data-cid="${c.parent_id || c.id}">Reply</button>${
        S.admin ? `<button class="link danger" data-act="delComment" data-cid="${c.id}">Delete</button>` : ''}</span></div>
    <div class="txt">${esc(c.body)}</div></div>`;
}

function threadsHTML(itemId, comments) {
  const kids = {};
  comments.filter(c => c.parent_id).forEach(c => (kids[c.parent_id] ||= []).push(c));
  const tops = comments.filter(c => !c.parent_id && !(c.deleted && !(kids[c.id] || []).length));
  if (!tops.length) return '<div class="count">No comments yet.</div>';
  return tops.map(c => {
    const replies = kids[c.id] || [];
    const open = openThreads.has(c.id);
    const n = `${replies.length} ${replies.length === 1 ? 'reply' : 'replies'}`;
    return `<div class="thread">${commentHTML(c)}
      ${replies.length ? `<button class="fold" data-act="fold" data-cid="${c.id}" aria-expanded="${open}">
        <span class="fline"></span>${open ? `Hide ${n}` : n} ${open ? '▾' : '▸'}</button>` : ''}
      ${replies.length && open ? `<div class="replies">${replies.map(r => commentHTML(r, true)).join('')}</div>` : ''}
      ${replyingTo.get(itemId) === c.id ? `<div class="inline replybox">
        <input data-f="reply" data-parent="${c.id}" placeholder="Reply to ${esc(c.deleted ? 'thread' : c.author)}… (Enter to post)" aria-label="Reply">
        <button data-act="sendReply" data-cid="${c.id}">Reply</button><button class="link" data-act="cancelReply">Cancel</button></div>` : ''}
    </div>`;
  }).join('');
}


function queueHTML(title, color, items, emptyMsg) {
  const active = items.filter(i => i.status !== 'done').sort(byQueue);
  const done = items.filter(i => i.status === 'done').sort((a, b) => b.resolved_at.localeCompare(a.resolved_at));
  const doing = active.filter(i => i.status === 'doing').length;
  return `<div class="qh"><span class="sw" style="background:${color}"></span><h2>${title}</h2>
      <span class="count">${active.length} open${doing ? ` · ${doing} in progress` : ''}</span></div>
    ${active.length ? active.map(itemHTML).join('') : `<div class="empty">${emptyMsg}</div>`}
    ${done.length ? `<details class="resolved" data-q="${title}"${saved.get('open.' + title) === '1' ? ' open' : ''}>
      <summary>Resolved (${done.length})</summary>${done.slice(0, 100).map(itemHTML).join('')}</details>` : ''}`;
}

function render() {
  const projects = S.projects.map(p => [p.project, `${p.project} (${p.open})`]);
  $('#fProject').innerHTML = options([['', 'All projects'], ...projects], project);
  $('#fWho').innerHTML = options([['', 'Anyone'], ['__none', 'Unassigned'], ...S.assignees.map(n => [n, n === S.me ? `${n} (you)` : n])], who);
  $('#projList').innerHTML = S.projects.map(p => `<option value="${esc(p.project)}">`).join('');

  let items = S.items;
  if (who === '__none') items = items.filter(i => !i.assignee);
  else if (who) items = items.filter(i => i.assignee === who);
  $('#qIssue').innerHTML = queueHTML('Issues', 'var(--issue)', items.filter(i => i.kind === 'issue'), 'No open issues.');
  $('#qTask').innerHTML = queueHTML('Tasks', 'var(--task)', items.filter(i => i.kind === 'task'), 'No open tasks.');

  const open = S.items.filter(i => i.status !== 'done');
  const forClaude = open.filter(i => i.assignee === 'claude' || i.assignee.startsWith('claude-')).length;
  $('#stats').textContent = `${open.length} open · ${forClaude} queued for Claude`;
  $('#acct').innerHTML = S.shared ? `· ${esc(S.me)} · <a href="/logout">Sign out</a>` : '';

  $('#events').innerHTML = S.events.length ? S.events.map(e => `<div class="ev">
      <b class="${e.actor === 'claude' ? 'claude' : ''}">${esc(e.actor)}</b> ${esc(e.action)}
      <span class="ref">${esc(e.ref)}</span> ${esc(e.title)}${e.detail ? ` <span class="t">— ${esc(e.detail)}</span>` : ''}
      <div class="t">${ago(e.at)}${project ? '' : ' · ' + esc(e.project)}</div></div>`).join('')
    : '<div class="empty">No activity yet.</div>';
  renderViews();
}

document.addEventListener('click', async e => {
  const el = e.target.closest('[data-act]');
  if (!el || el.tagName === 'SELECT') return;
  const item = el.closest('.item'); const id = item && +item.dataset.id;
  const it = id && S.items.find(i => i.id === id);
  if (!it) return;
  const act = el.dataset.act;
  if (act === 'open') return openItem(it.ref);
  if (act === 'toggle') await api('PATCH', `/api/items/${id}`, {status: it.status === 'done' ? 'open' : 'done'});
  if (act === 'start') await api('PATCH', `/api/items/${id}`, {status: 'doing', ...(it.assignee ? {} : {assignee: S.me})});
  if (act === 'pause') await api('PATCH', `/api/items/${id}`, {status: 'open'});
  refresh(true);
});

document.addEventListener('change', async e => {
  const el = e.target;
  if (el.id === 'fProject') { project = el.value; saved.set('project', project); return refresh(true); }
  if (el.id === 'fWho') { who = el.value; saved.set('who', who); return render(); }
  const item = el.closest('.item'); if (!item) return;
  if (el.dataset.act === 'assign') await api('PATCH', `/api/items/${item.dataset.id}`, {assignee: el.value});
  refresh(true);
});

document.addEventListener('toggle', e => {
  if (e.target.matches && e.target.matches('details.resolved')) saved.set('open.' + e.target.dataset.q, e.target.open ? '1' : '0');
}, true);

// ---- "+ Add" dialog
const dlg = $('#newDlg'), form = $('#add');
let pending = [];          // screenshots waiting to be uploaded with the new item
let pickTarget = null;     // null = the dialog; 'tkt' = the open ticket
let newStatus = 'open';    // a board column's + adds straight into that column

function setKind(k) {
  kind = k;
  document.querySelectorAll('.seg button').forEach(x => x.classList.toggle('on', x.dataset.kind === k));
  $('#newTitle').textContent = k === 'task' ? 'New task' : 'New issue';
  $('#submit').textContent = k === 'task' ? 'Add task' : 'Add issue';
  form.title.placeholder = k === 'task' ? 'What needs doing?' : "What's wrong?";
}

function renderPending() {
  $('#shots').innerHTML = pending.map((p, i) => `<figure class="thumb"><img src="${p.url}" alt="${esc(p.file.name || 'screenshot')}">
    <button type="button" class="x" data-rm="${i}" aria-label="Remove">×</button></figure>`).join('');
}

function addPending(files) {
  for (const f of imagesFrom(files)) pending.push({file: f, url: URL.createObjectURL(f)});
  renderPending();
}

function clearPending() {
  pending.forEach(p => URL.revokeObjectURL(p.url));
  pending = []; renderPending();
}

function openNew(preset) {
  if (!S || dlg.open) return;
  newStatus = (preset && preset.status) || 'open';
  form.reset(); clearPending(); setKind(kind);
  $('#addErr').textContent = '';
  form.assignee.innerHTML = assigneeOptions('');
  form.project.value = project || (S.projects[0] && S.projects[0].project) || 'general';
  $('#submit').disabled = false;
  dlg.showModal();
  form.title.focus();
}

$('#newBtn').addEventListener('click', () => openNew());
$('#cancel').addEventListener('click', () => dlg.close());
dlg.addEventListener('close', clearPending);
document.querySelectorAll('.seg button').forEach(b => b.addEventListener('click', () => { setKind(b.dataset.kind); form.title.focus(); }));
$('#shots').addEventListener('click', e => {
  const b = e.target.closest('[data-rm]'); if (!b) return;
  URL.revokeObjectURL(pending[+b.dataset.rm].url); pending.splice(+b.dataset.rm, 1); renderPending();
});
$('#pick').addEventListener('click', () => { pickTarget = null; $('#filePick').click(); });
$('#lightbox').addEventListener('click', () => $('#lightbox').close());

const drop = $('#drop');
drop.addEventListener('dragover', e => { e.preventDefault(); drop.classList.add('over'); });
drop.addEventListener('dragleave', () => drop.classList.remove('over'));
drop.addEventListener('drop', e => { e.preventDefault(); drop.classList.remove('over'); addPending(e.dataTransfer.files); });

$('#filePick').addEventListener('change', e => {
