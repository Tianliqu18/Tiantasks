      ${live ? `<span class="working">${sparkIc()} working</span>` : ''}<span class="grow"></span>${avatar(it.assignee)}</div>
    <div class="kc-title">${esc(it.title)}</div>
    ${cp ? `<div class="kc-cp" title="${esc(cp.text)}">${esc(cp.text)}</div>` : ''}
    ${flagsOpen ? `<div class="kc-flag">⚑ ${flagsOpen} open flag${flagsOpen > 1 ? 's' : ''}</div>` : ''}
    ${it.status === 'done' && it.note ? `<div class="kc-note">${esc(it.note)}</div>` : ''}
    <div class="kc-meta">${bits.join('')}<span class="age">${when}</span></div>
  </article>`;
}

function renderBoard() {
  $('#kindChips').innerHTML = [['all', 'All'], ['task', 'Tasks'], ['issue', 'Issues']].map(([k, l]) =>
    `<button class="chip ${kindF === k ? 'on' : ''}" data-kind-f="${k}" aria-pressed="${kindF === k}">${l}</button>`).join('');
  $('#boardHint').innerHTML = matchMedia('(hover: hover)').matches ? 'Drag cards between columns · <kbd>N</kbd> new' : 'Swipe between columns';
  let items = S.items;
  if (who === '__none') items = items.filter(i => !i.assignee);
  else if (who) items = items.filter(i => i.assignee === who);
  if (kindF !== 'all') items = items.filter(i => i.kind === kindF);
  const empty = {open: 'Nothing waiting.', doing: 'Nothing in progress.', done: 'Nothing complete yet.'};
  $('#board').innerHTML = Object.entries(STATUS).map(([st, label]) => {
    const list = items.filter(i => i.status === st)
      .sort(st === 'done' ? (a, b) => (b.resolved_at || '').localeCompare(a.resolved_at || '') : byQueue);
    const lim = st === 'done' ? doneLimit : Infinity;
    return `<section class="col" data-status="${st}" aria-label="${label}">
      <header class="col-h">${statusIcon(st)}<h2>${label}</h2><span class="count">${list.length}</span><span class="grow"></span>
        <button class="icon-btn" data-col-add="${st}" title="Add to ${label}" aria-label="Add to ${label}">${ic('plus')}</button></header>
      <div class="col-body" data-drop="${st}">
        ${list.slice(0, lim).map(cardHTML).join('') || `<div class="col-empty">${empty[st]}</div>`}
        ${list.length > lim ? `<button class="more" data-more="1">Show ${Math.min(40, list.length - lim)} more</button>` : ''}
      </div></section>`;
  }).join('');
}

