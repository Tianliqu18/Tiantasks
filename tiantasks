// ---- files
async function shrink(file) {
  if (!/^image\/(png|jpeg|webp)$/.test(file.type)) return file;
  let bmp;
  try { bmp = await createImageBitmap(file); } catch { return file; }
  const big = Math.max(bmp.width, bmp.height);
  if (file.size <= 1200000 && big <= 2600) return file;
  let scale = Math.min(1, 2400 / big);
  for (let tries = 0; tries < 5; tries++) {
    const c = document.createElement('canvas');
    c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
    c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
    const png = await new Promise(r => c.toBlob(r, 'image/png'));
    if (png && png.size <= MAX_FILE) return png;
    const jpg = await new Promise(r => c.toBlob(r, 'image/jpeg', 0.86));
    if (jpg && jpg.size <= MAX_FILE) return jpg;
    scale *= 0.75;
  }
  return file;
}
const b64 = blob => new Promise((res, rej) => {
  const r = new FileReader();
  r.onload = () => res(String(r.result).split(',')[1] || '');
  r.onerror = rej;
  r.readAsDataURL(blob);
});
function fileName(f, blob) {
  let n = f.name && f.name !== 'image.png' ? f.name : `screenshot-${new Date().toISOString().slice(0, 19).replace(/[-:T]/g, '')}.png`;
  if (blob.type === 'image/jpeg' && !/\.jpe?g$/i.test(n)) n = n.replace(/\.[a-z0-9]+$/i, '') + '.jpg';
  return n;
}
async function uploadFiles(files) {
  if (!M || !M.item || !files.length) return;
  const ref = M.item.ref;
  M.uploading += files.length; renderModal();
  let ok = 0;
  for (const f of files) {
    try {
      const blob = await shrink(f);
      if (blob.size > MAX_FILE) { toast(`${f.name} is ${size(blob.size)}; the limit is 1.5 MB`, 'err'); continue; }
      await api('POST', `/api/items/${ref}/attachments`, {name: fileName(f, blob), mime: blob.type || 'application/octet-stream', data: await b64(blob)});
      ok++;
    } catch {} finally { if (M) M.uploading--; }
  }
  if (ok) toast(ok === 1 ? 'Attached' : `Attached ${ok} files`);
  await loadModal();
  if (M && !typing()) renderModal();
  refresh(true);
}

// ---- lightbox
let LB = null;
function openLightbox(id) {
  const imgs = (M.files || []).filter(f => f.mime.startsWith('image/'));
  LB = {imgs, i: Math.max(0, imgs.findIndex(f => f.id === id))};
  renderLightbox();
  const d = $('#lightbox');
  if (!d.open) d.showModal();
}
function renderLightbox() {
  const f = LB.imgs[LB.i];
  $('#lightbox').innerHTML = `<div class="lb">
    <div class="lb-bar"><span>${esc(f.name)}</span><span style="opacity:.6">${size(f.size)} · ${esc(f.created_by)} · ${ago(f.created_at)}</span>
      <span class="grow"></span>${LB.imgs.length > 1 ? `<span style="opacity:.6">${LB.i + 1} / ${LB.imgs.length}</span>` : ''}
      <a class="icon-btn" href="${f.url}" download="${esc(f.name)}" title="Download" aria-label="Download">${ic('download')}</a>
      <button class="icon-btn" data-lb="close" aria-label="Close">${ic('x')}</button></div>
    <div class="lb-stage" data-lb="stage">
      ${LB.imgs.length > 1 ? `<button class="lb-nav prev" data-lb="prev" aria-label="Previous">${ic('left')}</button><button class="lb-nav next" data-lb="next" aria-label="Next">${ic('right')}</button>` : ''}
      <img src="${f.url}" alt="${esc(f.name)}"></div></div>`;
}
function lbStep(d) { if (!LB || LB.imgs.length < 2) return; LB.i = (LB.i + d + LB.imgs.length) % LB.imgs.length; renderLightbox(); }

async function copyText(text, msg) {
  try { await navigator.clipboard.writeText(text); }
  catch {
    const t = document.createElement('textarea');
    t.value = text; t.style.position = 'fixed'; t.style.opacity = '0';
    ($('#modal').open ? $('#modal') : document.body).append(t); t.select();
    document.execCommand('copy'); t.remove();
  }
  toast(msg || 'Copied');
}

// ---------------------------------------------------------------- routing
function setView(v) {
  view = v; saved.set('view', v);
  history.replaceState(null, '', '#' + v + (M ? '/' + M.ref : ''));
