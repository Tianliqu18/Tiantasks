}
function route() {
  const [v, ref] = location.hash.replace(/^#\/?/, '').split('/');
  if ((v === 'board' || v === 'queues') && v !== view) { view = v; saved.set('view', v); render(); }
  if (ref && /^[TI]-\d+$/i.test(ref)) { if (!M || M.ref !== ref.toUpperCase()) { modalPushed = false; openItem(ref); } }
  else if (M) { modalPushed = false; closeModal(); }
}
