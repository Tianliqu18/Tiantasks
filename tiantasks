def print_threads(comments, indent="  "):
    """Comments as threads: each top-level comment, then its replies indented under it."""
    replies = {}
    for c in comments:
        if c["parent_id"]:
            replies.setdefault(c["parent_id"], []).append(c)
    for c in (c for c in comments if not c["parent_id"]):
        kids = replies.get(c["id"], [])
        if c["deleted"] and not kids:
            continue
        head = dim("comment deleted") if c["deleted"] else f"{bold(c['author'])} {dim(show_ts(c['at']))}"
        print(f"{indent}" + dim(f"c{c['id']}") + f" {head}")
        if not c["deleted"]:
            print(f"{indent}    " + c["body"].replace("\n", f"\n{indent}    "))
        for r in kids:
            if r["deleted"]:
                print(f"{indent}  ╰ {dim('reply deleted')}")
                continue
            print(f"{indent}  ╰ " + dim(f"c{r['id']}") + f" {bold(r['author'])} {dim(show_ts(r['at']))}")
            print(f"{indent}      " + r["body"].replace("\n", f"\n{indent}      "))


