function cardHTML(it) {
  const live = it.status === 'doing' && isAgent(it.assignee) && agentState(agentOf(it.assignee)) !== 'offline';
  const shots = it.attachments || [];
  const cp = it.status === 'doing' ? cpsFor('ref', it.ref)[0] : null;
  const flagsOpen = (S.flags || []).filter(f => f.ref === it.ref && openFlag(f)).length;
  const bits = it.tags.slice(0, 3).map(t => `<span class="tag">#${esc(t)}</span>`);
  if (!project) bits.push(`<span class="tag">${esc(it.project)}</span>`);
  if (shots.length) bits.push(`<span class="cnt">${ic('clip')}${shots.length}</span>`);
  const when = it.status === 'done' ? ago(it.resolved_at) : ago(it.updated_at);
  return `<article class="kcard ${it.status}${live ? ' live' : ''}" draggable="true" data-id="${it.id}" data-ref="${it.ref}" tabindex="0" aria-label="${it.ref} ${esc(it.title)}">
    ${shots.length ? `<img class="cover" src="/api/attachments/${shots[0].id}" alt="" loading="lazy" draggable="false">` : ''}
