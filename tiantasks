form.add { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; padding: 10px; align-items: center; }
form.add input[name=title] { flex: 1 1 260px; }
form.add input[name=tags] { width: 130px; }
form.add input[name=project] { width: 150px; }
.seg { display: inline-flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; flex: none; }
.seg button { border: 0; border-radius: 0; padding: 6px 12px; background: transparent; }
.seg button.on[data-kind=task] { background: var(--task); color: #fff; }
.seg button.on[data-kind=issue] { background: var(--issue); color: #fff; }

.qh { display: flex; align-items: center; gap: 8px; padding: 14px 16px 10px; }
.qh h2 { font-size: 15px; margin: 0; }
.qh .sw { width: 10px; height: 10px; border-radius: 3px; }
.count { color: var(--muted); font-size: 13px; }
.empty { padding: 18px 16px 22px; color: var(--muted); border-top: 1px solid var(--line); }

.item { border-top: 1px solid var(--line); padding: 10px 14px 10px 16px; }
.item.doing { background: var(--doing); box-shadow: inset 3px 0 0 var(--warn); }
.row { display: flex; gap: 10px; align-items: flex-start; }
.check { width: 18px; height: 18px; flex: none; margin-top: 1px; padding: 0; border: 1.5px solid var(--muted);
  border-radius: 5px; background: none; display: grid; place-items: center; font-size: 12px; line-height: 1; color: #fff; }
.check:hover { border-color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent); }
.done .check { background: var(--ok); border-color: var(--ok); }
.ref { font: 12px ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--muted); flex: none; margin-top: 2px; }
.title { flex: 1; min-width: 0; cursor: pointer; overflow-wrap: anywhere; }
.title:hover { color: var(--accent); }
.done .title { text-decoration: line-through; color: var(--muted); }
.meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 6px 0 0 28px; }
.pill { font-size: 12px; padding: 1px 8px; border-radius: 999px; background: var(--chip); color: var(--muted); white-space: nowrap; }
.pill.p-crit { background: var(--issue); color: #fff; }
.pill.p-high { background: color-mix(in srgb, var(--issue) 16%, transparent); color: var(--issue); }
.pill.p-med { background: color-mix(in srgb, var(--warn) 16%, transparent); color: var(--warn); }
.pill.st { background: color-mix(in srgb, var(--warn) 18%, transparent); color: var(--warn); font-weight: 600; }
.pill.who { background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); }
.meta select { font-size: 12px; padding: 1px 6px; border-radius: 999px; }
.note { margin: 6px 0 0 28px; font-size: 13px; color: var(--muted); }
.note::before { content: "✓ "; color: var(--ok); }

.detail { margin: 10px 0 2px 28px; display: grid; gap: 10px; }
.detail .body { white-space: pre-wrap; font-size: 13px; }
.detail .inline { display: flex; gap: 6px; flex-wrap: wrap; }
.detail .inline input { flex: 1 1 180px; }
.hist { font-size: 12px; color: var(--muted); display: grid; gap: 3px; max-height: 220px; overflow: auto; }
.hist b { color: var(--ink); font-weight: 600; }

details.resolved > summary { list-style: none; cursor: pointer; padding: 10px 16px; border-top: 1px solid var(--line);
  color: var(--muted); font-size: 13px; }
details.resolved > summary::-webkit-details-marker { display: none; }
details.resolved > summary::before { content: "▸ "; }
details.resolved[open] > summary::before { content: "▾ "; }

aside h2 { font-size: 15px; margin: 0; padding: 14px 16px 10px; }
.ev { border-top: 1px solid var(--line); padding: 8px 16px; font-size: 13px; overflow-wrap: anywhere; }
.ev .t { color: var(--muted); font-size: 12px; }
.ev b { font-weight: 600; }
.ev .claude { color: var(--accent); }
.hint { padding: 12px 16px 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); }
#acct a { color: inherit; }
code { font: 12px ui-monospace, SFMono-Regular, Menlo, monospace; background: var(--chip); padding: 1px 5px; border-radius: 4px; }
</style>
</head>
<body>
<header><div class="bar">
  <h1>Tiantasks <span class="dot" id="dot" title="Live"></span></h1>
  <label class="f">Project <select id="fProject"></select></label>
  <label class="f">Assigned to <select id="fWho"></select></label>
  <span class="spacer"></span>
  <span class="stats" id="stats"></span>
  <span class="stats" id="acct"></span>
</div></header>

<main>
  <form class="add card" id="add" autocomplete="off">
    <div class="seg" role="group" aria-label="Kind">
      <button type="button" data-kind="task" class="on">Task</button>
      <button type="button" data-kind="issue">Issue</button>
    </div>
    <input name="title" placeholder="Add a task… (press Enter)" aria-label="Title" required>
    <select name="priority" aria-label="Priority">
      <option value="">No priority</option><option value="crit">crit</option><option value="high">high</option>
      <option value="med">med</option><option value="low">low</option>
    </select>
    <select name="assignee" aria-label="Assignee"></select>
    <input name="tags" placeholder="tags" aria-label="Tags">
    <input name="project" placeholder="project" aria-label="Project" list="projList" required>
    <datalist id="projList"></datalist>
    <button class="primary">Add</button>
  </form>

  <section class="card" id="qIssue"></section>
  <section class="card" id="qTask"></section>

  <aside class="card">
    <h2>Activity</h2>
    <div id="events"></div>
    <div class="hint">Changes from Claude Code show up here live. Assign items to a Claude
      (<b>claude</b>, or <b>claude-name</b> on a shared board), then in that repo ask it to
      “work through your Tiantasks queue”.</div>
  </aside>
</main>

<script>
const $ = (s, el = document) => el.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const PR = {crit: 0, high: 1, med: 2, low: 3};
const saved = {
  get(k, d) { try { return localStorage.getItem('tt.' + k) ?? d; } catch { return d; } },
  set(k, v) { try { localStorage.setItem('tt.' + k, v); } catch {} },
};

let S = null, lastText = '', kind = 'task';
let project = saved.get('project', ''), who = saved.get('who', '');
const expanded = new Set();

async function api(method, path, body) {
  const r = await fetch(path, {method, headers: {'Content-Type': 'application/json', 'X-Tiantasks': '1'},
    body: body ? JSON.stringify(body) : undefined});
  const data = await r.json().catch(() => ({}));
  if (!r.ok) { alert(data.error || ('Error ' + r.status)); throw new Error(data.error); }
  return data;
}

function typing() {
  const a = document.activeElement;
  return a && a.closest && a.closest('.item') && (a.tagName === 'INPUT' || a.tagName === 'SELECT');
}

// Every write bumps a version number, so polling it is one tiny query. The full board is
// only fetched when something changed, and nothing is polled while the tab is hidden.
let lastVersion = null;
async function tick() {
  if (document.hidden || typing()) return;
  try {
    const r = await fetch('/api/version');
    if (r.status === 401) { location.reload(); return; }
    const {v} = await r.json();
    $('#dot').classList.remove('off');
    if (v !== lastVersion) { lastVersion = v; await refresh(true); }
  } catch { $('#dot').classList.add('off'); }
}

async function refresh(force) {
  try {
    const r = await fetch('/api/state?project=' + encodeURIComponent(project));
    if (r.status === 401) { location.reload(); return; }
    const text = await r.text();
    $('#dot').classList.remove('off');
    if (!force && text === lastText) return;
    lastText = text; S = JSON.parse(text);
    if (project && !S.projects.some(p => p.project === project)) { project = ''; return refresh(true); }
    render();
  } catch { $('#dot').classList.add('off'); }
}

function ago(iso) {
  const s = (Date.now() - new Date(iso).getTime()) / 1000;
  if (s < 60) return 'just now';
  if (s < 3600) return Math.floor(s / 60) + 'm ago';
  if (s < 86400) return Math.floor(s / 3600) + 'h ago';
  if (s < 86400 * 7) return Math.floor(s / 86400) + 'd ago';
  return iso.slice(0, 10);
}

const byQueue = (a, b) => (a.status === 'doing' ? 0 : 1) - (b.status === 'doing' ? 0 : 1)
  || (PR[a.priority] ?? 9) - (PR[b.priority] ?? 9) || a.created_at.localeCompare(b.created_at);

function options(list, sel) {
  return list.map(([v, l]) => `<option value="${esc(v)}"${v === sel ? ' selected' : ''}>${esc(l)}</option>`).join('');
}
function assigneeOptions(sel) {
  return options([['', 'Unassigned'], ...S.assignees.map(n => [n, n === S.me ? `${n} (you)` : n])], sel);
}

function itemHTML(it) {
  const done = it.status === 'done';
  const meta = [];
  if (it.status === 'doing') meta.push(`<span class="pill st">In progress</span>`);
  if (it.priority) meta.push(`<span class="pill p-${it.priority}">${it.priority}</span>`);
  if (!project) meta.push(`<span class="pill">${esc(it.project)}</span>`);
  it.tags.forEach(t => meta.push(`<span class="pill">#${esc(t)}</span>`));
  if (done) {
    if (it.assignee) meta.push(`<span class="pill who">@${esc(it.assignee)}</span>`);
    meta.push(`<span class="pill">resolved ${ago(it.resolved_at)}</span>`);
  } else {
    meta.push(`<select data-act="assign" aria-label="Assignee">${assigneeOptions(it.assignee)}</select>`);
    meta.push(it.status === 'doing'
      ? `<button class="link" data-act="pause">Pause</button>`
      : `<button class="link" data-act="start">Start</button>`);
  }
  let detail = '';
  if (expanded.has(it.id)) {
    detail = `<div class="detail">
      ${it.body ? `<div class="body">${esc(it.body)}</div>` : ''}
      ${done ? '' : `<div class="inline"><input data-f="note" placeholder="Resolution note (optional)">
        <button data-act="resolveNote">Resolve</button></div>`}
      <div class="inline"><select data-act="priority" aria-label="Priority">${options([['', 'No priority'], ...Object.keys(PR).map(p => [p, p])], it.priority)}</select>
        <input data-f="comment" placeholder="Add a comment"><button data-act="comment">Comment</button></div>
      <div class="hist" id="hist-${it.id}">Loading history…</div>
      <div><button class="link danger" data-act="delete">Delete ${it.ref}</button></div>
    </div>`;
    loadHistory(it.id);
  }
  return `<div class="item ${it.status}" data-id="${it.id}">
    <div class="row">
      <button class="check" data-act="toggle" title="${done ? 'Reopen' : 'Resolve'}" aria-label="${done ? 'Reopen' : 'Resolve'} ${it.ref}">${done ? '✓' : ''}</button>
      <span class="ref">${it.ref}</span>
      <span class="title" data-act="expand" title="Show details">${esc(it.title)}</span>
    </div>
    <div class="meta">${meta.join('')}</div>
    ${done && it.note ? `<div class="note">${esc(it.note)}</div>` : ''}
    ${detail}
  </div>`;
}

async function loadHistory(id) {
  const evs = await fetch(`/api/items/${id}/events`).then(r => r.json());
  const el = document.getElementById('hist-' + id);
  if (el) el.innerHTML = evs.map(e => `<div>${ago(e.at)} · <b>${esc(e.actor)}</b> ${esc(e.action)}${e.detail ? ': ' + esc(e.detail) : ''}</div>`).join('');
}

function queueHTML(title, color, items, emptyMsg) {
  const active = items.filter(i => i.status !== 'done').sort(byQueue);
  const done = items.filter(i => i.status === 'done').sort((a, b) => b.resolved_at.localeCompare(a.resolved_at));
  const doing = active.filter(i => i.status === 'doing').length;
  return `<div class="qh"><span class="sw" style="background:${color}"></span><h2>${title}</h2>
      <span class="count">${active.length} open${doing ? ` · ${doing} in progress` : ''}</span></div>
    ${active.length ? active.map(itemHTML).join('') : `<div class="empty">${emptyMsg}</div>`}
    ${done.length ? `<details class="resolved" data-q="${title}"${saved.get('open.' + title) === '1' ? ' open' : ''}>
      <summary>Resolved (${done.length})</summary>${done.slice(0, 100).map(itemHTML).join('')}</details>` : ''}`;
}

function render() {
  const projects = S.projects.map(p => [p.project, `${p.project} (${p.open})`]);
  $('#fProject').innerHTML = options([['', 'All projects'], ...projects], project);
  $('#fWho').innerHTML = options([['', 'Anyone'], ['__none', 'Unassigned'], ...S.assignees.map(n => [n, n === S.me ? `${n} (you)` : n])], who);
  $('#projList').innerHTML = S.projects.map(p => `<option value="${esc(p.project)}">`).join('');
  const f = $('#add');
  f.assignee.innerHTML = assigneeOptions(f.assignee.value);
  if (!f.project.value) f.project.value = project || (S.projects[0] && S.projects[0].project) || 'general';

  let items = S.items;
  if (who === '__none') items = items.filter(i => !i.assignee);
  else if (who) items = items.filter(i => i.assignee === who);
  $('#qIssue').innerHTML = queueHTML('Issues', 'var(--issue)', items.filter(i => i.kind === 'issue'), 'No open issues.');
  $('#qTask').innerHTML = queueHTML('Tasks', 'var(--task)', items.filter(i => i.kind === 'task'), 'No open tasks.');

  const open = S.items.filter(i => i.status !== 'done');
  const forClaude = open.filter(i => i.assignee === 'claude' || i.assignee.startsWith('claude-')).length;
  $('#stats').textContent = `${open.length} open · ${forClaude} queued for Claude`;
  $('#acct').innerHTML = S.shared ? `· ${esc(S.me)} · <a href="/logout">Sign out</a>` : '';

  $('#events').innerHTML = S.events.length ? S.events.map(e => `<div class="ev">
      <b class="${e.actor === 'claude' ? 'claude' : ''}">${esc(e.actor)}</b> ${esc(e.action)}
      <span class="ref">${esc(e.ref)}</span> ${esc(e.title)}${e.detail ? ` <span class="t">— ${esc(e.detail)}</span>` : ''}
      <div class="t">${ago(e.at)}${project ? '' : ' · ' + esc(e.project)}</div></div>`).join('')
    : '<div class="empty">No activity yet.</div>';
}

document.addEventListener('click', async e => {
  const el = e.target.closest('[data-act]');
  if (!el || el.tagName === 'SELECT') return;
  const item = el.closest('.item'); const id = item && +item.dataset.id;
  const it = id && S.items.find(i => i.id === id);
  if (!it) return;
  const act = el.dataset.act;
  if (act === 'expand') { expanded.has(id) ? expanded.delete(id) : expanded.add(id); render(); return; }
  if (act === 'toggle') await api('PATCH', `/api/items/${id}`, {status: it.status === 'done' ? 'open' : 'done'});
  if (act === 'start') await api('PATCH', `/api/items/${id}`, {status: 'doing', ...(it.assignee ? {} : {assignee: S.me})});
  if (act === 'pause') await api('PATCH', `/api/items/${id}`, {status: 'open'});
  if (act === 'resolveNote') await api('PATCH', `/api/items/${id}`, {status: 'done', note: $('[data-f=note]', item).value});
  if (act === 'comment') { const v = $('[data-f=comment]', item).value.trim(); if (!v) return; await api('POST', `/api/items/${id}/comment`, {text: v}); }
  if (act === 'delete') { if (!confirm(`Delete ${it.ref} “${it.title}”? This can't be undone.`)) return; expanded.delete(id); await api('DELETE', `/api/items/${id}`); }
  refresh(true);
});

document.addEventListener('change', async e => {
  const el = e.target;
  if (el.id === 'fProject') { project = el.value; saved.set('project', project); if (project) $('#add').project.value = project; return refresh(true); }
  if (el.id === 'fWho') { who = el.value; saved.set('who', who); return render(); }
  const item = el.closest('.item'); if (!item) return;
  if (el.dataset.act === 'assign') await api('PATCH', `/api/items/${item.dataset.id}`, {assignee: el.value});
  if (el.dataset.act === 'priority') await api('PATCH', `/api/items/${item.dataset.id}`, {priority: el.value});
  refresh(true);
});

document.addEventListener('toggle', e => {
  if (e.target.matches && e.target.matches('details.resolved')) saved.set('open.' + e.target.dataset.q, e.target.open ? '1' : '0');
}, true);

document.querySelectorAll('.seg button').forEach(b => b.addEventListener('click', () => {
  kind = b.dataset.kind;
  document.querySelectorAll('.seg button').forEach(x => x.classList.toggle('on', x === b));
  $('#add').title.placeholder = `Add ${kind === 'task' ? 'a task' : 'an issue'}… (press Enter)`;
  $('#add').title.focus();
}));

$('#add').addEventListener('submit', async e => {
  e.preventDefault();
  const f = e.target;
  await api('POST', '/api/items', {kind, title: f.title.value, priority: f.priority.value,
    assignee: f.assignee.value, tags: f.tags.value, project: f.project.value.trim()});
  f.title.value = ''; f.tags.value = ''; f.title.focus();
  refresh(true);
});

setInterval(tick, 4000);
setInterval(() => { if (S && !document.hidden && !typing()) render(); }, 60000);  // keep "5m ago" fresh
document.addEventListener('visibilitychange', tick);
tick();
</script>
</body>
</html>
"""


