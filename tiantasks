// ---------------------------------------------------------------- events
document.addEventListener('click', async e => {
  const x = e.target.closest('a.xref');
  if (x) { e.preventDefault(); openItem(x.dataset.ref); return; }
  const tab = e.target.closest('[data-view]');
  if (tab) return setView(tab.dataset.view);
  const qt = e.target.closest('[data-qtab]');
  if (qt) { qtab = qt.dataset.qtab; saved.set('qtab', qtab); return render(); }
  const kf = e.target.closest('[data-kind-f]');
  if (kf) { kindF = kf.dataset.kindF; saved.set('kind', kindF); return render(); }
  const ev = e.target.closest('.ev[data-ref]');
  if (ev) { if (S.items.some(i => i.ref === ev.dataset.ref)) openItem(ev.dataset.ref); else toast(`${ev.dataset.ref} was deleted`); return; }

  const el = e.target.closest('[data-act]');
  if (!el) return;
  const act = el.dataset.act;

  // board chrome
  if (act === 'col-add') { addCol = el.dataset.status; return renderBoard(); }
  if (act === 'col-cancel') { addCol = null; return renderBoard(); }
  if (act === 'more') { doneLimit += 40; return renderBoard(); }

  // modal
  if (el.closest('#modal')) return modalClick(el, act, e);

  // queue rows and cards
  const host = el.closest('[data-id]');
  const it = host && S.items.find(i => i.id === +host.dataset.id);
  if (!it) return;
  if (act === 'open') return openItem(it.ref);
  e.stopPropagation();
  if (act === 'toggle') await patch(it.ref, {status: it.status === 'done' ? 'open' : 'done'});
  if (act === 'start') await patch(it.ref, {status: 'doing', ...(it.assignee ? {} : {assignee: S.me})});
  if (act === 'pause') await patch(it.ref, {status: 'open'});
  refresh(true);
});

async function modalClick(el, act, e) {
  const it = M && M.item;
  if (act === 'close') return closeModal();
  if (!it) return;
  if (act === 'edit-desc') { if (e.target.closest('a')) return; M.editDesc = true; return renderModal(); }
  if (act === 'cancel-desc') { M.editDesc = false; return renderModal(); }
  if (act === 'save-desc') { const v = $('#modal [data-f=body]').value; M.editDesc = false; return modalSave({body: v}); }
  if (act === 'status') {
    const st = el.dataset.status;
    if (st === it.status) return;
    return modalSave({status: st, ...(st === 'doing' && !it.assignee ? {assignee: S.me} : {})}, true);
  }
  if (act === 'resolve') return modalSave({status: 'done', note: $('#modal [data-f=resolve]').value}, true);
  if (act === 'comment') {
    const t = $('#modal [data-f=comment]'); const v = t.value.trim();
    if (!v) { t.focus(); return; }
    await api('POST', `/api/items/${it.ref}/comment`, {text: v});
    M.draft = ''; t.value = '';
    await loadModal(); refresh(true); return;
  }
  if (act === 'pick') { $('#filePick').click(); return; }
  if (act === 'zoom') return openLightbox(+el.dataset.file);
  if (act === 'detach') {
    const f = M.files.find(x => x.id === +el.dataset.file);
    if (!f || !confirm(`Remove ${f.name}?`)) return;
    await api('DELETE', `/api/attachments/${f.id}`);
    await loadModal(); refresh(true); return;
  }
  if (act === 'copy-link') return copyText(`${location.origin}${location.pathname}#${view}/${it.ref}`, 'Link copied');
  if (act === 'copy-prompt') return copyText(agentPrompt(it), 'Prompt copied — paste it into Claude Code');
  if (act === 'to-agent') {   // copy first: Safari only allows clipboard writes inside the click itself
    copyText(agentPrompt(it), `Assigned to ${myAgent()} · prompt copied`);
    return modalSave({assignee: myAgent()}, true);
  }
  if (act === 'delete') {
    if (!confirm(`Delete ${it.ref} “${it.title}”? This can't be undone.`)) return;
    await api('DELETE', `/api/items/${it.ref}`);
    closeModal(); toast(`Deleted ${it.ref}`); refresh(true);
  }
}

document.addEventListener('keydown', e => {
  const t = e.target;
  // queue rows / cards open with Enter
