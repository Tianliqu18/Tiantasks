document.addEventListener('drop', async e => {
  const col = dragId !== null && e.target.closest && e.target.closest('[data-drop]');
  if (!col) return;
  e.preventDefault();
  const it = S.items.find(i => i.id === dragId);
  const st = col.dataset.drop;
  dragId = null;
  if (!it || it.status === st) return renderBoard();
  const ch = {status: st, ...(st === 'doing' && !it.assignee ? {assignee: S.me} : {})};
  Object.assign(it, ch, st === 'done' ? {resolved_at: new Date().toISOString()} : {});   // move it now, save behind
  renderBoard();
  try { await api('PATCH', `/api/items/${it.ref}`, ch, true); if (st === 'done') toast(`${it.ref} complete`); }
  catch (err) { toast(err.message, 'err'); }
  finally { refresh(true); }
});

// ---------------------------------------------------------------- ticket modal
let M = null, modalPushed = false;   // M: {ref, item, events, comments, editDesc, draft, uploading}
const tkt = $('#tkt');

async function getJSON(path) {
  const r = await fetch(path);
  if (r.status === 401) { location.reload(); throw new Error('signed out'); }
  if (!r.ok) throw Object.assign(new Error('HTTP ' + r.status), {status: r.status});
  return r.json();
}

async function openItem(ref) {
  ref = String(ref).toUpperCase();
  if (M && M.ref === ref) return;
  M = {ref, item: S && S.items.find(i => i.ref === ref), events: null, comments: null, editDesc: false, draft: '', uploading: 0};
  const target = `#${view}/${ref}`;
  if (location.hash !== target) { history.pushState(null, '', target); modalPushed = true; }
  if (!tkt.open) tkt.showModal();
  renderModal();
  await loadModal();
}

async function loadModal() {
  if (!M) return;
  const ref = M.ref;
  try {
    const [item, events, comments, checkpoints, flags, directives] = await Promise.all([
      getJSON(`/api/items/${ref}`), getJSON(`/api/items/${ref}/events`), getJSON(`/api/items/${ref}/comments`),
      getJSON(`/api/checkpoints?ref=${ref}&limit=20`), getJSON(`/api/flags?ref=${ref}&limit=20`),
      getJSON(`/api/directives?ref=${ref}&limit=50`)]);
    if (!M || M.ref !== ref) return;
    Object.assign(M, {item, events, comments, checkpoints, flags, directives});
    const a = document.activeElement;
    if (!(a && a.closest('#tkt') && ['INPUT', 'TEXTAREA'].includes(a.tagName))) renderModal();
  } catch (err) {
    if (err.status === 404) { toast(`${ref} no longer exists`, 'err'); tkt.close(); }
  }
}

tkt.addEventListener('close', () => {
  M = null;
  if (/\/[TI]-\d+$/i.test(location.hash)) {
    if (modalPushed) history.back(); else history.replaceState(null, '', '#' + view);
  }
  modalPushed = false;
});
tkt.addEventListener('click', e => { if (e.target === tkt) tkt.close(); });   // backdrop
tkt.addEventListener('cancel', e => { if (M && M.editDesc) { e.preventDefault(); M.editDesc = false; renderModal(); } });

function route() {
  const [v, ref] = location.hash.replace(/^#\/?/, '').split('/');
  if (['board', 'queues', 'team'].includes(v) && v !== view) { view = v; saved.set('view', v); if (S) renderViews(); }
  if (ref && /^[TI]-\d+$/i.test(ref)) { if (!M || M.ref !== ref.toUpperCase()) { modalPushed = false; openItem(ref); } }
  else if (M) { modalPushed = false; tkt.close(); }
}
window.addEventListener('popstate', route);

const PHRASE = {
  opened: d => `created this${d ? ' ' + esc(d) : ''}`, started: () => `moved this to <b>In progress</b>`,
  paused: () => `moved this back to <b>Not started</b>`, reopened: () => `reopened this`,
  resolved: () => `marked this <b>Complete</b>`, assigned: d => `assigned this ${esc(d)}`,
  reprioritized: d => `set priority to <b>${esc(d)}</b>`, renamed: d => `renamed this ${esc(d)}`,
  edited: () => `edited the description`, tagged: d => `set tags to ${esc(d)}`, moved: d => `moved this ${esc(d)}`,
  noted: () => `updated the resolution note`,
  checkpoint: d => `posted progress: <b>${esc(d)}</b>`, flagged: d => `flagged ${esc(d)}`, asked: d => `asked ${esc(d)}`,
  acknowledged: d => `acknowledged ${esc(d)}`, 'set field': d => `set ${esc(d)}`, 'cleared field': d => `cleared ${esc(d)}`,
};

function historyHTML() {
  const dirs = (M.directives || []).map(d => ({at: d.at, actor: d.actor, action: 'directive', detail: d.quote, verified: d.verified, principal: d.principal}));
  const evs = [...(M.events || []).filter(e => !COMMENT_ACTIONS.includes(e.action)), ...dirs]
    .sort((a, b) => (b.at || '').localeCompare(a.at || ''));
  if (!evs.length) return '';
  return `<details class="hist-d"><summary>History (${evs.length})</summary><div class="tl">${[...evs].reverse().map(e => {
    const bul = {started: statusIcon('doing'), paused: statusIcon('open'), reopened: statusIcon('open'), resolved: statusIcon('done')}[e.action] || '<i></i>';
    const quote = (e.action === 'resolved' || e.action === 'noted') && e.detail ? `<span class="quote">“${esc(e.detail)}”</span>` : '';
    if (e.action === 'directive') {
      const v = e.verified === 1 ? '<span class="v ok">verified in their chat</span>' : e.verified === 0 ? '<span class="v no">not found in their chat</span>' : '<span class="v pending">unverified</span>';
      return `<div class="tl-ev dir"><span class="bul">${sparkIc()}</span><span>${whoTag(e.actor)} acted on <b>${esc(personName(e.principal))}</b>'s instruction:
        <span class="quote">“${esc(e.detail)}”${v}</span><span class="help"> · ${ago(e.at)}</span></span></div>`;
    }
    const say = PHRASE[e.action] || (d => esc(e.action) + (d ? ': ' + esc(d) : ''));
    return `<div class="tl-ev"><span class="bul">${bul}</span><span>${whoTag(e.actor)} ${say(e.detail || '')}
      <span class="help" title="${esc(fullDate(e.at))}">· ${ago(e.at)}</span>${quote}</span></div>`;
  }).join('')}</div></details>`;
}

function shotsHTML(it) {
  const shots = it.attachments || [];
  const tiles = shots.map(a => `<div class="gtile"><button class="gshot" data-t="zoom" data-src="/api/attachments/${a.id}" aria-label="View ${esc(a.name)}" title="${esc(a.name)}">
      <img src="/api/attachments/${a.id}" alt="${esc(a.name)}" loading="lazy"></button>
      <button class="del" data-t="delShot" data-att="${a.id}" title="Remove" aria-label="Remove ${esc(a.name)}">${ic('x')}</button></div>`);
  for (let i = 0; i < M.uploading; i++) tiles.push('<div class="gup">Uploading…</div>');
  if (!tiles.length) return `<button class="gadd wide" data-t="pick">${ic('image')}<span>Paste a screenshot (<kbd>⌘V</kbd>), drop images here, or click to choose</span></button>`;
  tiles.push(`<button class="gadd" data-t="pick">${ic('plus')}<span>Add</span></button>`);
  return `<div class="gal">${tiles.join('')}</div>`;
}

function agentPrompt(it) {
