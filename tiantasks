// ---- queues
function rowHTML(it) {
  const done = it.status === 'done';
  const meta = [];
  if (it.status === 'doing') meta.push(`<span class="pill st">In progress</span>`);
  if (it.priority) meta.push(prioIcon(it.priority));
  if (!project) meta.push(`<span class="pill">${esc(it.project)}</span>`);
  it.tags.slice(0, 3).forEach(t => meta.push(`<span class="pill">#${esc(t)}</span>`));
  if (it.files) meta.push(`<span class="cnt" title="${it.files} file(s)">${ic('clip')}${it.files}</span>`);
  if (it.comments) meta.push(`<span class="cnt" title="${it.comments} comment(s)">${ic('chat')}${it.comments}</span>`);
  if (done) meta.push(`<span class="cnt">completed ${ago(it.resolved_at)}</span>`);
  const quick = done ? '' : it.status === 'doing'
    ? `<button class="link quick" data-act="pause">Pause</button>`
    : `<button class="link quick" data-act="start">Start</button>`;
  return `<div class="item ${it.status}" data-id="${it.id}" data-ref="${it.ref}" data-act="open" tabindex="0">
    <button class="check" data-act="toggle" title="${done ? 'Reopen' : 'Complete'}" aria-label="${done ? 'Reopen' : 'Complete'} ${it.ref}">${done ? ic('check') : ''}</button>
    <span class="ref">${it.ref}</span>
    <span class="title">${esc(it.title)}</span>
    <span class="row-end">${quick}${avatar(it.assignee)}</span>
    ${meta.length ? `<span class="row-meta">${meta.join('')}</span>` : ''}
    ${done && it.note ? `<div class="note">${esc(it.note)}</div>` : ''}
  </div>`;
}

const QTABS = [['active', 'Active', i => i.status !== 'done'], ['doing', 'In progress', i => i.status === 'doing'],
               ['done', 'Resolved', i => i.status === 'done'], ['all', 'All', () => true]];

function queueHTML(title, color, items, emptyMsg) {
  const doing = items.filter(i => i.status === 'doing').length;
  const act = items.filter(i => i.status !== 'done').sort(byQueue);
  const done = items.filter(i => i.status === 'done').sort(byResolved);
  const list = [...act, ...done.slice(0, 200)];
  const label = qtab === 'done' ? `${done.length} resolved` : `${act.length} open${doing ? ` · ${doing} in progress` : ''}`;
  return `<div class="qh"><span class="sw" style="background:${color}"></span><h2>${title}</h2><span class="count">${label}</span></div>
    ${list.length ? list.map(rowHTML).join('') : `<div class="empty">${emptyMsg}</div>`}`;
}

function renderQueues() {
  const items = visible(S.items);
  $('#qtabs').innerHTML = QTABS.map(([k, l, f]) =>
    `<button class="tab ${qtab === k ? 'on' : ''}" role="tab" aria-selected="${qtab === k}" data-qtab="${k}">${l}<span class="n">${items.filter(f).length}</span></button>`).join('');
  const f = QTABS.find(t => t[0] === qtab)[2];
  const shown = items.filter(f);
  const none = {active: 'Nothing open.', doing: 'Nothing in progress.', done: 'Nothing resolved yet.', all: 'Nothing here.'}[qtab];
  $('#qIssue').innerHTML = queueHTML('Issues', 'var(--issue)', shown.filter(i => i.kind === 'issue'), none.replace('Nothing', 'No issues').replace('No issues here', 'No issues'));
  $('#qTask').innerHTML = queueHTML('Tasks', 'var(--task)', shown.filter(i => i.kind === 'task'), none.replace('Nothing', 'No tasks').replace('No tasks here', 'No tasks'));
  $('#events').innerHTML = S.events.length ? S.events.map(e => `<div class="ev" data-ref="${esc(e.ref)}">
      <b class="${isAgent(e.actor) ? 'ai' : ''}">${esc(e.actor)}</b> ${esc(e.action)}
      <span class="ref">${esc(e.ref)}</span> ${esc(e.title)}${e.detail ? ` <span class="t">— ${esc(e.detail)}</span>` : ''}
      <div class="t">${ago(e.at)}${project ? '' : ' · ' + esc(e.project)}</div></div>`).join('')
    : '<div class="empty">No activity yet.</div>';
}

// ---- board
function cardHTML(it) {
  const live = it.status === 'doing' && isAgent(it.assignee);
  const tags = it.tags.slice(0, 3).map(t => `<span class="tag">#${esc(t)}</span>`).join('');
  const bits = [];
  if (!project) bits.push(`<span class="tag">${esc(it.project)}</span>`);
  if (it.comments) bits.push(`<span class="cnt">${ic('chat')}${it.comments}</span>`);
  if (it.files) bits.push(`<span class="cnt">${ic('clip')}${it.files}</span>`);
  const when = it.status === 'done' ? ago(it.resolved_at) : ago(it.updated_at);
  return `<article class="kcard ${it.status}${live ? ' live' : ''}" draggable="true" data-id="${it.id}" data-ref="${it.ref}" data-act="open" tabindex="0" aria-label="${it.ref} ${esc(it.title)}">
    ${it.cover ? `<img class="cover" src="/api/attachments/${it.cover}" alt="" loading="lazy" draggable="false">` : ''}
    <div class="kc-top"><span class="kind-dot ${it.kind}" title="${it.kind}"></span><span class="ref">${it.ref}</span>${prioIcon(it.priority)}
      ${live ? `<span class="working">${sparkIc()} working</span>` : ''}<span class="grow"></span>${avatar(it.assignee)}</div>
    <div class="kc-title">${esc(it.title)}</div>
    ${it.status === 'done' && it.note ? `<div class="kc-note">${esc(it.note)}</div>` : ''}
    ${tags || bits.length || when ? `<div class="kc-meta">${tags}${bits.join('')}<span class="age">${when}</span></div>` : ''}
  </article>`;
}

function renderBoard() {
  $('#kindChips').innerHTML = [['all', 'All'], ['task', 'Tasks'], ['issue', 'Issues']].map(([k, l]) =>
    `<button class="chip ${kindF === k ? 'on' : ''}" data-kind-f="${k}" aria-pressed="${kindF === k}">${l}</button>`).join('');
  $('#boardHint').innerHTML = matchMedia('(hover: hover)').matches ? 'Drag cards between columns · <kbd>C</kbd> new · <kbd>/</kbd> search' : 'Swipe between columns';
  let items = visible(S.items);
  if (kindF !== 'all') items = items.filter(i => i.kind === kindF);
  const empty = {open: 'Nothing waiting.', doing: 'Nothing in progress.', done: 'Nothing complete yet.'};
  $('#board').innerHTML = Object.entries(STATUS).map(([st, label]) => {
    const list = items.filter(i => i.status === st).sort(st === 'done' ? byResolved : byQueue);
    const lim = st === 'done' ? doneLimit : Infinity;
    const form = addCol === st ? `<form class="col-add" data-status="${st}">
        <textarea name="title" rows="2" placeholder="Title for a new ${kindF === 'issue' ? 'issue' : 'task'}…" aria-label="Title"></textarea>
        <div class="row"><button type="button" class="ghost" data-act="col-cancel">Cancel</button><button class="primary">Add</button></div></form>` : '';
    return `<section class="col" data-status="${st}" aria-label="${label}">
      <header class="col-h">${statusIcon(st)}<h2>${label}</h2><span class="count">${list.length}</span><span class="grow"></span>
        <button class="icon-btn" data-act="col-add" data-status="${st}" title="Add to ${label}" aria-label="Add to ${label}">${ic('plus')}</button></header>
      <div class="col-body" data-drop="${st}">${form}
        ${list.slice(0, lim).map(cardHTML).join('') || (form ? '' : `<div class="col-empty">${empty[st]}</div>`)}
        ${list.length > lim ? `<button class="more" data-act="more">Show ${Math.min(40, list.length - lim)} more</button>` : ''}
      </div></section>`;
  }).join('');
  const ta = $('form.col-add textarea');
  if (ta) ta.focus();
}

// ---------------------------------------------------------------- ticket modal
async function openItem(ref) {
  ref = ref.toUpperCase();
  if (M && M.ref === ref) return;
  M = {ref, item: S && S.items.find(i => i.ref === ref), events: null, files: null, editDesc: false, draft: '', uploading: 0};
  const target = `#${view}/${ref}`;
  if (location.hash !== target) { history.pushState(null, '', target); modalPushed = true; }
  const d = $('#modal');
  if (!d.open) d.showModal();
  renderModal();
  await loadModal();
  if (M && !M.item) return;
  const title = $('#modal textarea.m-title');
  if (title) autosize(title);
}

async function loadModal() {
  if (!M) return;
  const ref = M.ref;
  try {
    const [item, events, files] = await Promise.all([
      getJSON(`/api/items/${ref}`), getJSON(`/api/items/${ref}/events`), getJSON(`/api/items/${ref}/attachments`)]);
    if (!M || M.ref !== ref) return;
    Object.assign(M, {item, events, files});
    if (!typing() || document.activeElement.tagName === 'SELECT') renderModal();
  } catch (e) {
    if (e.status === 404) { toast(`${ref} no longer exists`, 'err'); closeModal(); }
  }
}

function closeModal() {
  const d = $('#modal');
  if (d.open) d.close();
}

function onModalClosed() {
  M = null;
  if (/\/[TI]-\d+$/i.test(location.hash)) {
    if (modalPushed) history.back(); else history.replaceState(null, '', '#' + view);
  }
  modalPushed = false;
}

const PHRASE = {
  opened: d => `created this${d ? ' ' + esc(d) : ''}`, started: () => `moved this to <b>In progress</b>`,
  paused: () => `moved this back to <b>Not started</b>`, reopened: () => `reopened this`,
  resolved: () => `marked this <b>Complete</b>`, assigned: d => `assigned this ${esc(d)}`,
  reprioritized: d => `set priority to <b>${esc(d)}</b>`, renamed: d => `renamed this ${esc(d)}`,
  edited: () => `edited the description`, tagged: d => `set tags to ${esc(d)}`, moved: d => `moved this ${esc(d)}`,
  noted: () => `updated the resolution note`, attached: d => `attached ${esc(d.replace(/\s*\(#\d+\)$/, ''))}`,
  detached: d => `removed ${esc(d.replace(/\s*\(#\d+\)$/, ''))}`, deleted: () => 'deleted this',
};

function timelineHTML() {
  if (!M.events) return '<div class="tl-ev">Loading…</div>';
  const images = new Map((M.files || []).filter(f => f.mime.startsWith('image/')).map(f => [f.id, f]));
  return [...M.events].reverse().map(e => {
    const agent = isAgent(e.actor);
    if (e.action === 'commented') return `<div class="cmt${agent ? ' ai' : ''}">${avatar(e.actor, true)}
      <div class="bubble"><div class="who"><b>${esc(e.actor)}</b><span class="when" title="${esc(fullDate(e.at))}">${ago(e.at)}</span></div>
      <div class="md">${md(e.detail)}</div></div></div>`;
    const f = e.action === 'attached' && images.get(+((e.detail.match(/\(#(\d+)\)$/) || [])[1]));
    const quote = (e.action === 'resolved' || e.action === 'noted') && e.detail ? `<span class="quote">“${esc(e.detail)}”</span>` : '';
    const bul = {started: statusIcon('doing'), paused: statusIcon('open'), reopened: statusIcon('open'), resolved: statusIcon('done')}[e.action]
      || (e.action === 'attached' ? ic('clip') : '<i></i>');
    return `<div class="tl-ev"><span class="bul">${bul}</span><span><b>${esc(e.actor)}</b> ${(PHRASE[e.action] || (d => esc(e.action) + (d ? ': ' + esc(d) : '')))(e.detail || '')}
      <span class="when" title="${esc(fullDate(e.at))}">· ${ago(e.at)}</span>${quote}
      ${f ? `<button class="tl-shot" data-act="zoom" data-file="${f.id}" aria-label="View ${esc(f.name)}"><img src="${f.url}" alt="${esc(f.name)}" loading="lazy"></button>` : ''}</span></div>`;
  }).join('');
}

function filesHTML() {
  if (!M.files) return '';
