def parse_users(spec):
    """TIANTASKS_USERS="tianli:<token>,oliver:<token>" -> {token: name}."""
    users = {}
    for part in filter(None, (p.strip() for p in (spec or "").split(","))):
        name, _, token = part.partition(":")
        if not re.fullmatch(r"[a-z0-9_.]+", name or "") or len(token) < 20:
            raise SystemExit(f"bad TIANTASKS_USERS entry {name!r}: need lowercase-name:token (20+ chars)")
        users[token] = name
    return users


def make_handler(db_path, me, users=None):
    """`users` is None for a private local board, or {token: name} for a shared one."""

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code, body, ctype="application/json", headers=()):
            data = body if isinstance(body, bytes) else json.dumps(body).encode()
            self.sent_code = code
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            if not any(k == "Cache-Control" for k, _ in headers):
                self.send_header("Cache-Control", "no-store")
            for k, v in headers:
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)

        def _body(self):
            n = int(self.headers.get("Content-Length") or 0)
            return json.loads(self.rfile.read(n)) if n else {}

        def _user_for(self, token):
            for known, name in users.items():
                if token and hmac.compare_digest(token.encode(), known.encode()):
                    return name
            return None

        def _authed_user(self):
            auth = self.headers.get("Authorization", "")
            if auth.startswith("Bearer "):
                return self._user_for(auth[7:].strip())
            cookie = SimpleCookie(self.headers.get("Cookie", ""))
            return self._user_for(cookie["tt_token"].value) if "tt_token" in cookie else None

        def _cookie(self, value, max_age):
            secure = "; Secure" if self.headers.get("X-Forwarded-Proto") == "https" else ""
            return ("Set-Cookie", f"tt_token={value}; Path=/; Max-Age={max_age}; HttpOnly; "
                                  f"SameSite=Strict{secure}")

        def _login(self, method, path):
            if path == "/logout":
                return self._send(303, b"", headers=[("Location", "/"), self._cookie("", 0)])
            if method == "POST":
                n = int(self.headers.get("Content-Length") or 0)
                token = parse_qs(self.rfile.read(n).decode()).get("token", [""])[0].strip()
                if self._user_for(token):
                    return self._send(303, b"", headers=[("Location", "/"),
                                                         self._cookie(token, 60 * 60 * 24 * 365)])
                return self._send(401, LOGIN_PAGE.replace("<!--err-->", "That token isn't valid.").encode(),
                                  "text/html; charset=utf-8")
            return self._send(200, LOGIN_PAGE.encode(), "text/html; charset=utf-8")

        def _handle(self, method):
            url = urlparse(self.path)
            if url.path == "/api/ping":
                return self._send(200, {"app": "tiantasks", "version": VERSION})
            if url.path == "/llms.txt":  # how agents drive the board over HTTP
                return self._send(200, AGENT_GUIDE.encode(), "text/plain; charset=utf-8")
            if url.path == "/tiantasks":  # the CLI itself, so teammates can install it from here
                return self._send(200, Path(os.path.realpath(__file__)).read_bytes(),
                                  "text/x-python; charset=utf-8")
            if users is None:
                # Private board: only answer same-machine requests (blocks DNS rebinding).
                host = (self.headers.get("Host") or "").rsplit(":", 1)[0]
                if host not in ("127.0.0.1", "localhost"):
                    return self._send(403, {"error": "forbidden host"})
                user = me
            else:
                if url.path in ("/login", "/logout"):
                    return self._login(method, url.path)
                user = self._authed_user()
                if not user:
                    if method == "GET" and url.path == "/":
                        return self._login("GET", "/login")
                    return self._send(401, {"error": "not signed in"})
            # Writes need a custom header, which other websites can't send cross-origin.
            if method != "GET" and self.headers.get("X-Tiantasks") != "1":
                return self._send(403, {"error": "missing X-Tiantasks header"})
            actor = user
            agent = (self.headers.get("X-Tiantasks-Agent") or "").strip().lower()
            admins = {a.strip() for a in os.environ.get("TIANTASKS_ADMINS", "").split(",") if a.strip()}
            # Admins can delete comments. On a private board that's you; agents never are.
            is_admin = not agent and (users is None or user in admins)
            if agent == "claude":
                actor = "claude" if users is None else f"claude-{user}"
            elif agent:
                # Named agents (TIANTASKS_AGENT=builder-1) act under their own name, but can't
                # pose as another person on a shared board.
                if not AGENT_NAME.fullmatch(agent):
                    return self._send(400, {"error": "agent names use lowercase letters, numbers, - _ ."})
                if users is not None and agent in users.values() and agent != user:
                    return self._send(403, {"error": f"'{agent}' is another person's name"})
                actor = agent
            q = {k: v[0] for k, v in parse_qs(url.query, keep_blank_values=True).items()}
            store = Store(db_path)
            try:
                self.agent, self.agent_header = (actor if agent else ""), agent
                if agent:  # every agent write is attributed to its person
                    actor = store.touch_agent(actor, user)
                self.sent_code, self.touched_ref = 0, ""
                self._route(method, url.path, q, store, user, actor, is_admin)
                # "My person told me to": recorded next to the change it justified.
                quote = self.headers.get("X-Tiantasks-Directive")
                if quote and agent and method != "GET" and 200 <= self.sent_code < 300:
                    mi = re.fullmatch(r"/api/items/([A-Za-z]?-?\d+).*", url.path)
                    ref = self.touched_ref or (mi.group(1) if mi and method != "DELETE" else "")
                    ref = store.get(ref)["ref"] if ref else ""
                    store.directive(actor, user, unquote(quote), ref, f"{method} {url.path}")
                return
            except TTError as e:
                return self._send(e.status, {"error": str(e)})
            except (ValueError, KeyError, TypeError) as e:
                return self._send(400, {"error": str(e)})
            finally:
                store.close()

        def _route(self, method, path, q, store, user, actor, is_admin=False):
            is_agent = bool(self.agent)
            # ---- agents, initiatives, checkpoints, flags, directives
            mg = re.fullmatch(r"/api/agents/([^/]+)", path)
            if method == "GET" and path == "/api/agents":
                return self._send(200, store.agents())
            if method == "PUT" and mg:
                name = unquote(mg.group(1)).lower()
                if is_agent and name not in (actor, self.agent_header):
                    raise TTError("an agent can only report on itself", 403)
                return self._send(200, store.report_agent(name, user, self._body()))
            if method == "DELETE" and mg:
                if is_agent:
                    raise TTError("only a person can remove an agent", 403)
                return self._send(200, store.remove_agent(unquote(mg.group(1)).lower(), user))
            mi = re.fullmatch(r"/api/initiatives/(.+)", path)
            if method == "GET" and path == "/api/initiatives":
                return self._send(200, store.initiatives())
            if method == "GET" and mi:
                return self._send(200, store.initiative(unquote(mi.group(1))))
            if method == "DELETE" and mi:
                if is_agent:
                    raise TTError("only a person can remove an initiative", 403)
                return self._send(200, store.remove_initiative(unquote(mi.group(1)), user))
            if method == "PUT" and mi:
                return self._send(200, store.put_initiative(unquote(mi.group(1)), user, self._body()))
            if method == "GET" and path == "/api/checkpoints":
                return self._send(200, store.checkpoints(q.get("ref"), q.get("initiative"), q.get("limit") or 100))
            if method == "POST" and path == "/api/checkpoints":
                b = self._body()
                self.touched_ref = b.get("ref") or ""
                return self._send(201, store.checkpoint(actor, user, b.get("text"), b.get("ref") or "",
                                                        b.get("initiative") or "", b.get("link") or "",
                                                        b.get("attachment"), b.get("source") or ("agent" if is_agent else "person")))
            mfl = re.fullmatch(r"/api/flags/(\d+)(/ack)?", path)
            if method == "GET" and path == "/api/flags":
                to = actor if q.get("to") == "me" else q.get("to")
                return self._send(200, store.flags(to, q.get("status"), q.get("ref"), q.get("initiative"),
                                                   q.get("limit") or 100))
            if method == "POST" and path == "/api/flags":
                b = self._body()
                self.touched_ref = b.get("ref") or ""
                return self._send(201, store.flag(actor, user, b.get("text"), b.get("ref") or "",
                                                  b.get("initiative") or "", b.get("to") or "",
                                                  bool(b.get("urgent")), b.get("kind") or "flag"))
            if method == "POST" and mfl and mfl.group(2):
                return self._send(200, store.set_flag(mfl.group(1), actor, user, is_agent, "acked",
                                                      self._body().get("note", "")))
            if method == "PATCH" and mfl:
                b = self._body()
                return self._send(200, store.set_flag(mfl.group(1), actor, user, is_agent, b.get("status"),
                                                      b.get("note", "")))
            md = re.fullmatch(r"/api/directives/(\d+)", path)
            if method == "GET" and path == "/api/directives":
                return self._send(200, store.directives(q.get("ref"), q.get("unchecked") == "1", q.get("limit") or 100))
            if method == "PATCH" and md:
                if is_agent:
                    raise TTError("agents can't check directives", 403)
                return self._send(200, store.check_directive(md.group(1), user, bool(self._body().get("verified"))))
            ma = re.fullmatch(r"/api/items/([A-Za-z]?-?\d+)/attachments", path)
            if method == "GET" and ma:
                return self._send(200, store.attachments(ma.group(1)))
            if method == "POST" and ma:
                n = int(self.headers.get("Content-Length") or 0)
                if n > MAX_ATTACHMENT:
                    self.close_connection = True
                    raise TTError(f"the image is {human_size(n)}; the limit is {human_size(MAX_ATTACHMENT)}", 413)
                mime = (self.headers.get("Content-Type") or "").split(";")[0].strip().lower()
                return self._send(201, store.attach(ma.group(1), actor, q.get("name"), mime, self.rfile.read(n)))
            mf = re.fullmatch(r"/api/attachments/(\d+)", path)
            if method == "GET" and mf:
                a = store.attachment(int(mf.group(1)))
                return self._send(200, a["data"], a["mime"], headers=[
                    ("Cache-Control", "private, max-age=31536000, immutable"),
                    ("Content-Security-Policy", "default-src 'none'"),
                    ("X-Content-Type-Options", "nosniff")])
            if method == "DELETE" and mf:
                return self._send(200, store.delete_attachment(int(mf.group(1)), actor))
            mc = re.fullmatch(r"/api/comments/(\d+)", path)
            if method == "DELETE" and mc:
                return self._send(200, store.delete_comment(int(mc.group(1)), actor, is_admin))
            m = re.fullmatch(r"/api/items/([A-Za-z]?-?\d+)(/events|/comments?)?", path)
            if method == "GET" and path == "/":
                return self._send(200, PAGE.encode(), "text/html; charset=utf-8")
            if method == "GET" and path == "/api/version":
                return self._send(200, {"v": store.version(), "build": PAGE_BUILD})
            if method == "GET" and path == "/api/me":
                return self._send(200, {"user": user, "actor": actor, "shared": users is not None,
                                        "admin": is_admin})
            if method == "GET" and path == "/api/state":
                project = q.get("project") or None
                people = set(users.values()) if users is not None else {me}
                agents = {f"claude-{p}" for p in people} if users is not None else {"claude"}
                return self._send(200, {
                    "me": user, "shared": users is not None, "admin": is_admin,
                    "items": store.list(project),
                    "events": store.events(40, project),
                    "agents": store.agents(),
                    "initiatives": store.initiatives(),
                    "checkpoints": store.checkpoints(limit=300),
                    "flags": store.flags(limit=200),
                    "projects": store.projects(),
                    "assignees": sorted(set(store.assignees()) | people | agents),
                    "people": sorted(people),
                })
            if method == "GET" and path == "/api/items":
                st = q.get("status")
                return self._send(200, store.list(
                    q.get("project") or None, st.split(",") if st else None, q.get("kind") or None,
                    q["assignee"] if "assignee" in q else None, q.get("grep") or None))
            if method == "GET" and path == "/api/events":
                item_id = int(q["item_id"]) if q.get("item_id") else None
                return self._send(200, store.events(int(q.get("limit") or 40),
                                                    q.get("project") or None, item_id))
            if method == "GET" and path == "/api/projects":
                return self._send(200, store.projects())
            if method == "GET" and m and not m.group(2):
                return self._send(200, store.get(m.group(1)))
            if method == "GET" and m and m.group(2) == "/events":
                return self._send(200, store.events(200, ref=store.get(m.group(1))["ref"]))
            if method == "POST" and path == "/api/items":
                b = self._body()
                it = store.create(
                    b.get("kind", "task"), b.get("title", ""), b.get("project") or "general", actor,
                    body=b.get("body", ""), priority=b.get("priority", ""),
                    tags=b.get("tags", []), assignee=b.get("assignee", ""))
                if b.get("fields"):
                    it = store.set_fields(it["id"], actor, b["fields"])
                return self._send(201, it)
            if method == "GET" and m and m.group(2) == "/comments":
                return self._send(200, store.comments(m.group(1)))
            if method == "POST" and m and m.group(2) == "/comment":
                b = self._body()
                return self._send(200, store.comment(m.group(1), actor, b.get("text", ""), b.get("parent_id")))
            if method == "PATCH" and m and not m.group(2):
                allowed = {"status", "note", "assignee", "priority", "title", "body", "tags", "project",
                           "if_status", "if_assignee", "fields"}
                ch = {k: v for k, v in self._body().items() if k in allowed}
                return self._send(200, store.update(m.group(1), actor, **ch))
            if method == "DELETE" and m and not m.group(2):
                return self._send(200, store.delete(m.group(1), actor))
            if method == "POST" and path == "/api/shutdown" and users is None:
                self._send(200, {"ok": True})
                threading.Thread(target=self.server.shutdown, daemon=True).start()
                return
            return self._send(404, {"error": "not found"})

        def do_GET(self):
            self._handle("GET")

        def do_POST(self):
            self._handle("POST")

        def do_PATCH(self):
            self._handle("PATCH")

        def do_DELETE(self):
            self._handle("DELETE")

        def do_PUT(self):
            self._handle("PUT")

    return Handler


def cmd_serve(args):
    db_path = args.store.path
    args.store.close()
    users = parse_users(os.environ.get("TIANTASKS_USERS")) or None
    if users is None and args.host not in ("127.0.0.1", "localhost"):
        die("refusing to serve on a public address without logins; set TIANTASKS_USERS")
    handler = make_handler(db_path, current_actor(args), users)
    srv = ThreadingHTTPServer((args.host, args.port), handler)
    mode = f"shared, {len(users)} users" if users else "private"
    print(f"Tiantasks on http://{args.host}:{args.port} ({mode}, db: {db_path})  Ctrl-C to stop",
          flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


def cmd_login(args):
    url = args.url.rstrip("/")
    if not re.match(r"https?://", url):
        url = "https://" + url
    if url.startswith("http://") and not re.match(r"http://(127\.0\.0\.1|localhost)[:/]", url + "/"):
        die("use an https:// URL so your token isn't sent in the clear")
    token = os.environ.get("TIANTASKS_TOKEN") or getpass.getpass("Token (input hidden): ").strip()
    me = RemoteStore(url, token).me()
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.touch(mode=0o600)
    CONFIG.write_text(json.dumps({"url": url, "token": token}, indent=2))
    os.chmod(CONFIG, 0o600)
    print(green(f"signed in to {url} as {me['user']}"))
    print(dim(f"`tt` now uses this shared board. Your Claude Code sessions act as claude-{me['user']}."))


def cmd_logout(args):
    if CONFIG.exists():
        CONFIG.unlink()
        print("signed out; `tt` is back to your local board")
    else:
        print(dim("not signed in to a shared board"))


def cmd_whoami(args):
    if isinstance(args.store, RemoteStore):
        me = args.store.me()
        print(f"{me['actor']}  (signed in as {me['user']} on shared board {args.store.url})")
    else:
        print(f"{current_actor(args)}  (local board {args.store.path})")


def ensure_local_server(store, port):
    """Start the private board's web server in the background if it isn't running."""
    if server_up(port):
        return
    log = open(store.path.parent / "server.log", "a")
    env = {**os.environ, "TIANTASKS_DB": str(store.path)}
    for var in ("CLAUDECODE", "TIANTASKS_ACTOR", "TIANTASKS_AGENT"):
        env.pop(var, None)  # edits made on the page are yours, not an agent's
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "serve", "--port", str(port)],
                     stdout=log, stderr=log, stdin=subprocess.DEVNULL, env=env, start_new_session=True)
    for _ in range(50):
        if server_up(port):
            return
        time.sleep(0.1)
    die(f"server didn't start; see {log.name}")


BOARD_JS = Path.home() / ".tiantasks" / "board.mjs"


def cmd_board(args):
    """The terminal kanban (React + Ink, bundled into one file that runs on Node 18+)."""
    node = shutil.which("node")
    if not node:
        die("`tt board` needs Node.js 18 or newer: https://nodejs.org (or `brew install node`)")
    major = subprocess.run([node, "--version"], capture_output=True, text=True).stdout.strip().lstrip("v")
    if int(major.split(".")[0] or 0) < 18:
        die(f"`tt board` needs Node.js 18 or newer (you have {major})")
    dev = Path(os.path.realpath(__file__)).parent / "board" / "dist" / "board.mjs"
    script = dev if dev.exists() else BOARD_JS
    if isinstance(args.store, RemoteStore):
        url, token = args.store.url, args.store.token
        # Keep the board app in step with the shared board's version.
        stamp = BOARD_JS.with_suffix(".version")
        remote_version = args.store._req("GET", "/api/ping")["version"]
        if script == BOARD_JS and (not BOARD_JS.exists() or args.update or
                                   (stamp.read_text().strip() if stamp.exists() else "") != remote_version):
            print(dim("downloading the board app…"), file=sys.stderr)
            BOARD_JS.parent.mkdir(parents=True, exist_ok=True)
            req = urllib.request.Request(url + "/board.mjs", headers={"User-Agent": f"tiantasks-cli/{VERSION}"})
            with urllib.request.urlopen(req, timeout=30, context=ssl_context()) as r:
                BOARD_JS.write_bytes(r.read())
            stamp.write_text(remote_version)
    else:
        ensure_local_server(args.store, args.port)
        url, token = f"http://127.0.0.1:{args.port}", ""
    if not script.exists():
        die("the board app isn't installed; run install.sh from the Tiantasks repo")
    env = {**os.environ, "TT_URL": url, "TT_TOKEN": token, "TT_PROJECT": current_project(args)}
    for var in ("CLAUDECODE", "TIANTASKS_AGENT"):
        env.pop(var, None)
    os.execve(node, [node, str(script)], env)


def cmd_ui(args):
    if isinstance(args.store, RemoteStore):
        print(f"Shared board: {args.store.url}")
        if not args.no_open:
            webbrowser.open(args.store.url)
        return
    url = f"http://127.0.0.1:{args.port}"
    if args.stop:
        if not server_up(args.port):
            print(dim("not running"))
            return
        req = urllib.request.Request(url + "/api/shutdown", method="POST", headers={"X-Tiantasks": "1"})
        urllib.request.urlopen(req, timeout=2).read()
        print("stopped")
        return
    ensure_local_server(args.store, args.port)
    print(f"Tiantasks is running at {url}")
    if not args.no_open:
        webbrowser.open(url)


