// Small, safe Markdown: code, bold, italics, links, lists, quotes, headings, and T-3 / I-12 cross-links.
function md(src) {
  src = String(src || '');
  if (!src.trim()) return '';
  const blocks = [];
  src = src.replace(/```[^\n]*\n([\s\S]*?)```/g, (_, code) => {
    blocks.push(`<pre><code>${esc(code.replace(/\n$/, ''))}</code></pre>`);
    return `\u0000${blocks.length - 1}\u0000`;
  });
  const inline = s => esc(s)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/(^|[\s(])[*_]([^*_\s][^*_]*?)[*_](?=[\s).,!?:;]|$)/g, '$1<em>$2</em>')
    .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
    .replace(/(^|[\s(])(https?:\/\/[^\s<]+[^\s<.,)])/g, '$1<a href="$2" target="_blank" rel="noopener">$2</a>')
    .replace(/(^|[^\w\/-])([TI]-\d+)\b/g, '$1<a href="#" class="xref" data-ref="$2">$2</a>');
  const out = [];
  let para = [], list = null;
  const flushP = () => { if (para.length) out.push(`<p>${para.map(inline).join('<br>')}</p>`); para = []; };
  const flushL = () => { if (list) out.push(`<${list.t}>${list.items.map(x => `<li>${x}</li>`).join('')}</${list.t}>`); list = null; };
  for (const line of src.split('\n')) {
    let m;
    if ((m = line.match(/^\u0000(\d+)\u0000\s*$/))) { flushP(); flushL(); out.push(blocks[m[1]]); }
    else if (!line.trim()) { flushP(); flushL(); }
    else if ((m = line.match(/^#{1,4}\s+(.*)/))) { flushP(); flushL(); out.push(`<h4>${inline(m[1])}</h4>`); }
    else if ((m = line.match(/^>\s?(.*)/))) { flushP(); flushL(); out.push(`<blockquote>${inline(m[1])}</blockquote>`); }
    else if ((m = line.match(/^\s*(?:([-*+])|(\d+)[.)])\s+(.*)/))) {
      flushP();
      const t = m[1] ? 'ul' : 'ol';
      if (!list || list.t !== t) { flushL(); list = {t, items: []}; }
      list.items.push(inline(m[3]).replace(/^\[( |x|X)\]\s*/, (_, c) => c === ' ' ? '☐ ' : '☑ '));
    }
    else { flushL(); para.push(line); }
  }
  flushP(); flushL();
  return out.join('').replace(/\u0000(\d+)\u0000/g, (_, i) => blocks[i]);
}

// ---------------------------------------------------------------- state
let S = null, lastText = '', kind = 'task', lastVersion = null;
let view = saved.get('view', 'queues'), qtab = saved.get('qtab', 'active'), kindF = saved.get('kind', 'all');
let project = saved.get('project', ''), who = saved.get('who', ''), query = '';
let dragId = null, addCol = null, doneLimit = 40;
let M = null;            // open ticket: {ref, item, events, files, editDesc, draft, uploading}
let modalPushed = false;
{ const v = location.hash.replace(/^#\/?/, '').split('/')[0]; if (v === 'board' || v === 'queues') view = v; }

function toast(msg, cls = '') {
  const t = document.createElement('div');
  t.className = 'toast ' + cls; t.textContent = msg;
  $('#toasts').append(t);
  setTimeout(() => t.remove(), cls === 'err' ? 5000 : 2200);
}

async function api(method, path, body) {
  const r = await fetch(path, {method, headers: {'Content-Type': 'application/json', 'X-Tiantasks': '1'},
    body: body ? JSON.stringify(body) : undefined});
  const data = await r.json().catch(() => ({}));
  if (!r.ok) { toast(data.error || ('Error ' + r.status), 'err'); throw new Error(data.error); }
  return data;
}
async function getJSON(path) {
  const r = await fetch(path);
  if (r.status === 401) { location.reload(); throw new Error('signed out'); }
  if (!r.ok) throw Object.assign(new Error('HTTP ' + r.status), {status: r.status});
  return r.json();
}
const patch = (ref, ch) => api('PATCH', `/api/items/${ref}`, ch);

function typing() {
  const a = document.activeElement;
  return !!(a && /^(INPUT|TEXTAREA|SELECT)$/.test(a.tagName) && a.closest('#modal, .col-add, .item'));
}

// Every write bumps a version number, so polling it is one tiny query. The full board is
// only fetched when something changed, and nothing is polled while the tab is hidden.
async function tick() {
  if (document.hidden || typing() || dragId !== null) return;
  try {
    const r = await fetch('/api/version');
    if (r.status === 401) { location.reload(); return; }
    const {v} = await r.json();
    $('#dot').classList.remove('off');
    if (v !== lastVersion) { lastVersion = v; await refresh(true); if (M) loadModal(); }
  } catch { $('#dot').classList.add('off'); }
}

async function refresh(force) {
  try {
    const r = await fetch('/api/state?project=' + encodeURIComponent(project));
    if (r.status === 401) { location.reload(); return; }
    const text = await r.text();
    $('#dot').classList.remove('off');
    if (!force && text === lastText) return;
    lastText = text; S = JSON.parse(text);
    if (project && !S.projects.some(p => p.project === project)) { project = ''; return refresh(true); }
    render();
  } catch { $('#dot').classList.add('off'); }
}

const byQueue = (a, b) => (a.status === 'doing' ? 0 : 1) - (b.status === 'doing' ? 0 : 1)
  || (PR[a.priority] ?? 9) - (PR[b.priority] ?? 9) || a.created_at.localeCompare(b.created_at);
const byResolved = (a, b) => (b.resolved_at || '').localeCompare(a.resolved_at || '');

function options(list, sel) {
  return list.map(([v, l]) => `<option value="${esc(v)}"${v === sel ? ' selected' : ''}>${esc(l)}</option>`).join('');
}
function assigneeOptions(sel) {
  const names = [...S.assignees];
  if (sel && !names.includes(sel)) names.push(sel);
  return options([['', 'Unassigned'], ...names.map(n => [n, n === S.me ? `${n} (you)` : n])], sel);
}
const myAgent = () => S.shared ? `claude-${S.me}` : 'claude';

function visible(items) {
  let out = items;
  if (who === '__none') out = out.filter(i => !i.assignee);
  else if (who) out = out.filter(i => i.assignee === who);
  const q = query.trim().toLowerCase();
  if (q) out = out.filter(i => [i.ref, i.title, i.body, i.note, i.assignee, i.project, ...i.tags].join(' ').toLowerCase().includes(q));
  return out;
}

// ---------------------------------------------------------------- render
function render() {
