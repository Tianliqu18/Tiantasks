PATCH  /api/flags/ID                    {status: delivered|failed|escalated|closed, note}
GET    /api/directives?ref=&unchecked=1
PATCH  /api/directives/ID               {verified: true|false}   the agent's person only

priority: crit | high | med | low | ""   status: open | doing | done (a "note" on done is the resolution)

## Working an item
1. Take it without racing other agents: PATCH {status: "doing", assignee: "<you>",
   if_status: "<status you saw>", if_assignee: "<assignee you saw>"}; on 409, pick another item.
2. Read the body, the comments and any screenshots before changing code.
3. Post progress as comments (reply to questions with parent_id); attach screenshots of UI results.
4. Finish: PATCH {status: "done", note: "<one line: what changed>"}.

## Staying in touch without overhead
- Milestones only: POST /api/checkpoints with one concrete line. A handful a day at most.
- Check GET /api/flags?to=me&status=open when you start and between tasks; act, then
  POST /api/flags/ID/ack with one line saying what you'll do.
- Need your person to decide something: POST /api/flags {kind: "ask", text, ref}.
"""

CLAUDE_MD_SNIPPET = """
## Task and issue queues (Tiantasks)

Tasks and issues for this project are tracked with the `tt` CLI (outside the repo).
- Check the queue: `tt list` · take your next item: `tt next --start`
- Log bugs you won't fix now: `tt issue "<summary>" -p high -d "<details>"`
- Close finished work: `tt resolve <ID> -m "<what you did>"`
"""


def cmd_claude_setup(args):
    if args.project_md:
        r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        target = Path(r.stdout.strip() if r.returncode == 0 else Path.cwd()) / "CLAUDE.md"
        existing = target.read_text() if target.exists() else ""
        if "Tiantasks" in existing:
            print(dim(f"{target} already mentions Tiantasks"))
            return
        target.write_text(existing.rstrip() + ("\n" if existing else "") + CLAUDE_MD_SNIPPET)
        print(green(f"added Tiantasks instructions to {target}"))
        return
    skill = Path.home() / ".claude" / "skills" / "tiantasks" / "SKILL.md"
    skill.parent.mkdir(parents=True, exist_ok=True)
    skill.write_text(SKILL_MD)
    print(green(f"installed Claude Code skill at {skill}"))


# ---------------------------------------------------------------- CLI

def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--project", default=argparse.SUPPRESS,
                        help="project name (default: git repo name)")
    common.add_argument("--as", dest="actor", default=argparse.SUPPRESS,
                        help="who is making the change (default: you, or 'claude' in Claude Code)")
    common.add_argument("--directive", default=argparse.SUPPRESS, metavar="QUOTE",
                        help="agents: the instruction from your person this change carries out, quoted")

    p = argparse.ArgumentParser(
        prog="tt",
        description="Tiantasks: task and issue queues with a live local page.",
        epilog="examples:\n"
               "  tt ui                                   open the live page\n"
               "  tt add \"Write onboarding docs\" -t docs\n"
               "  tt issue \"Login crashes on empty password\" -p high --to claude\n"
               "  tt next --start                         take the next item assigned to you\n"
               "  tt resolve I-1 -m \"Validate input before submit\"",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--version", action="version", version=f"tiantasks {VERSION}")
    sub = p.add_subparsers(dest="cmd", metavar="<command>")

    def add_cmd(name, fn, help, aliases=()):
        sp = sub.add_parser(name, parents=[common], help=help, aliases=list(aliases))
        sp.set_defaults(fn=fn)
        return sp

    for name, kind, help, aliases in [("add", None, "add a task", ("task", "new")),
                                      ("issue", "issue", "open an issue", ("bug",))]:
        sp = add_cmd(name, lambda a, k=kind: cmd_add(a, k), help, aliases)
        sp.add_argument("text", nargs="+")
        sp.add_argument("-p", "--priority", choices=PRIORITIES)
        sp.add_argument("-t", "--tag", action="append", help="tag (repeatable)")
        sp.add_argument("-d", "--desc", help="longer description")
        sp.add_argument("--to", help="assignee (a name, 'claude' or 'me')")
        sp.add_argument("-f", "--file", action="append", help="attach a screenshot (repeatable)")
        sp.add_argument("--initiative", metavar="SLUG", help="put it in an initiative (e.g. court/eval-flows)")
        sp.add_argument("--field", action="append", metavar="KEY=VALUE", help="set a custom field")
        sp.add_argument("--json", action="store_true")
        if name == "add":
            sp.add_argument("-i", "--issue", action="store_true", help="make it an issue")

    sp = add_cmd("resolve", cmd_resolve, "check off items", ("done", "close", "fix"))
    sp.add_argument("ids", nargs="+", metavar="ID")
    sp.add_argument("-m", "--message", help="resolution note")
    sp.add_argument("--json", action="store_true")

    for name, status, verb, color, help in [
        ("start", "doing", "started", yellow, "mark in progress (assigns you if unassigned)"),
        ("stop", "open", "paused", dim, "move back to open"),
        ("reopen", "open", "reopened", yellow, "reopen a resolved item"),
    ]:
        sp = add_cmd(name, cmd_status(status, verb, color), help)
        sp.add_argument("ids", nargs="+", metavar="ID")
        sp.add_argument("--json", action="store_true")

    sp = add_cmd("assign", cmd_assign, "assign items to someone ('claude', 'me', 'nobody')")
    sp.add_argument("ids", nargs="+", metavar="ID")
    sp.add_argument("who")
    sp.add_argument("--json", action="store_true")

    sp = add_cmd("edit", cmd_edit, "change title, priority, description or tags")
    sp.add_argument("id", metavar="ID")
    sp.add_argument("text", nargs="*")
    sp.add_argument("-p", "--priority", choices=PRIORITIES + ("none",))
    sp.add_argument("-d", "--desc")
    sp.add_argument("-t", "--tag", action="append")
    sp.add_argument("--untag", action="append")
    sp.add_argument("--move", metavar="PROJECT", help="move to another project")
    sp.add_argument("--field", action="append", metavar="KEY=VALUE", help="set a custom field (empty VALUE removes it)")
    sp.add_argument("--initiative", metavar="SLUG", help="put the item in an initiative ('' to take it out)")
    sp.add_argument("--json", action="store_true")

    sp = add_cmd("progress", cmd_progress, "post a milestone on an item or initiative (short, one line)")
    sp.add_argument("id", metavar="ID", nargs="?", help="item (leave out with --initiative)")
    sp.add_argument("text", nargs="+")
    sp.add_argument("--initiative", metavar="SLUG")
    sp.add_argument("--link", metavar="URL", help="preview, PR or doc this milestone produced")
    sp.add_argument("--shot", metavar="FILE", help="attach a screenshot with it")
    sp.add_argument("--json", action="store_true")

    for name, kind, help in [("flag", "flag", "send a note that must reach whoever runs an item or initiative"),
                             ("ask", "ask", "agents: ask your person for a decision (lands with them, not in a pile)")]:
        sp = add_cmd(name, lambda a, k=kind: cmd_flag(a, k), help)
        sp.add_argument("text", nargs="+")
        sp.add_argument("--on", metavar="ID", help="the item it's about")
        sp.add_argument("--initiative", metavar="SLUG")
        sp.add_argument("--to", metavar="NAME", help="who gets it (default: the item's assignee or initiative owner"
                                                     + ("" if kind == "flag" else "; for ask, your person") + ")")
        sp.add_argument("--urgent", action="store_true", help="also tell their person right away")
        sp.add_argument("--json", action="store_true")

    sp = add_cmd("flags", cmd_flags, "flags and asks waiting for you (or --all)")
    sp.add_argument("--to", metavar="NAME")
    sp.add_argument("--all", action="store_true", help="everyone's open flags")
    sp.add_argument("--on", metavar="ID")
    sp.add_argument("--history", action="store_true", help="include acknowledged and closed ones")
    sp.add_argument("--json", action="store_true")

    sp = add_cmd("ack", cmd_ack, "acknowledge a flag, saying in a line what you'll do")
    sp.add_argument("flag", metavar="F-ID")
    sp.add_argument("note", nargs="*")
    sp.add_argument("--close", action="store_true", help="close it instead (no longer relevant)")

    sp = add_cmd("team", cmd_team, "people, their agents, and what each is working on", ("agents",))
    sp.add_argument("--json", action="store_true")
    sp = add_cmd("initiatives", cmd_initiatives, "initiatives and who runs them")
    sp.add_argument("--json", action="store_true")

    sp = add_cmd("comment", cmd_comment, "comment on an item, reply to a comment, or delete one (admin)")
    sp.add_argument("id", metavar="ID")
    sp.add_argument("text", nargs="*")
    sp.add_argument("-r", "--reply", metavar="CID", type=int, help="reply to comment CID (see `tt show`)")
    sp.add_argument("--delete", metavar="CID", type=int, help="delete comment CID (admins only)")

    sp = add_cmd("remove", cmd_remove, "delete an item", ("rm",))
    sp.add_argument("id", metavar="ID")

    sp = add_cmd("list", cmd_list, "show the queues (open items in this project)", ("ls",))
    sp.add_argument("-a", "--all", action="store_true", help="include resolved")
    sp.add_argument("-r", "--resolved", action="store_true", help="only resolved")
    sp.add_argument("-A", "--all-projects", action="store_true")
    sp.add_argument("--tasks", action="store_true")
    sp.add_argument("--issues", action="store_true")
    sp.add_argument("--for", dest="for_", metavar="NAME", help="assignee ('me', 'claude', 'nobody')")
    sp.add_argument("-g", "--grep")
    sp.add_argument("--json", action="store_true")

    sp = add_cmd("next", cmd_next, "show the top item assigned to you")
    sp.add_argument("--for", dest="for_", metavar="NAME")
    sp.add_argument("--start", action="store_true", help="claim it and mark it in progress")
    sp.add_argument("--any", action="store_true", help="fall back to unassigned items")
    sp.add_argument("--wait", action="store_true", help="if there's nothing, wait until something is assigned")
    sp.add_argument("--timeout", type=int, metavar="SECS", help="with --wait, give up after this long")
    sp.add_argument("--interval", type=int, metavar="SECS", help="with --wait, how often to check")
    sp.add_argument("-A", "--all-projects", action="store_true")
    sp.add_argument("--json", action="store_true")

    sp = add_cmd("attach", cmd_attach, "attach screenshots to an item")
    sp.add_argument("id", metavar="ID")
    sp.add_argument("files", nargs="+", metavar="FILE")
    sp.add_argument("--json", action="store_true")

    sp = add_cmd("files", cmd_files, "list an item's screenshots (--save DIR downloads them)")
    sp.add_argument("id", metavar="ID")
    sp.add_argument("--save", metavar="DIR", help="download them into DIR and print the paths")
    sp.add_argument("--json", action="store_true")

    sp = add_cmd("brief", cmd_brief, "board snapshot for a lead agent: unassigned, queued, in progress, done, team")
    sp.add_argument("-A", "--all-projects", action="store_true")
    sp.add_argument("--done", type=int, default=10, metavar="N", help="how many recently done items (default 10)")
    sp.add_argument("--json", action="store_true")

    sp = add_cmd("board", cmd_board, "terminal kanban: open → in progress → done")
    sp.add_argument("--port", type=int, default=DEFAULT_PORT, help="local board port")
    sp.add_argument("--update", action="store_true", help="re-download the board app from the shared board")

    sp = add_cmd("show", cmd_show, "details and history for one item")
    sp.add_argument("id", metavar="ID")
    sp.add_argument("--json", action="store_true")

    sp = add_cmd("log", cmd_log, "recent activity")
    sp.add_argument("-n", type=int, default=20)
    sp.add_argument("-A", "--all-projects", action="store_true")

    add_cmd("projects", cmd_projects, "list projects")

    sp = add_cmd("ui", cmd_ui, "open the live page (starts the server if needed)")
    sp.add_argument("--port", type=int, default=DEFAULT_PORT)
    sp.add_argument("--no-open", action="store_true")
    sp.add_argument("--stop", action="store_true", help="stop the background server")

    sp = add_cmd("serve", cmd_serve, "run the web server in the foreground")
    sp.add_argument("--port", type=int, default=DEFAULT_PORT)
    sp.add_argument("--host", default="127.0.0.1",
                    help="bind address; anything public requires TIANTASKS_USERS logins")

    sp = add_cmd("login", cmd_login, "use a shared board (prompts for your token)")
    sp.add_argument("url")
    add_cmd("logout", cmd_logout, "go back to your local board")
    add_cmd("whoami", cmd_whoami, "show which board and identity `tt` is using")

    sp = add_cmd("claude-setup", cmd_claude_setup, "install the Claude Code skill")
    sp.add_argument("--repo", action="store_true", dest="project_md",
                    help="add a note to this repo's CLAUDE.md instead")

    add_cmd("help", lambda a: p.print_help(), "show this help")
    return p


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    parser = build_parser()
    args = parser.parse_args(argv or ["list"])
    if not getattr(args, "fn", None):
        parser.print_help()
        return
    try:
        cfg = None if args.cmd in ("serve", "login", "logout") else load_config()
        args.store = RemoteStore(cfg["url"], cfg["token"]) if cfg else Store()
        quote_ = directive_quote(args)
        if quote_ and not agent_name():
            die("--directive is for agents recording their person's instruction")
        if isinstance(args.store, RemoteStore):
            args.store.directive = quote_  # the server records it with each write
        elif agent_name() and args.cmd not in ("serve", "ui", "login", "logout", "help"):
            local_touch(args)  # a shared board learns about agents from their requests; a local one here
        args.fn(args)
        if quote_ and isinstance(args.store, Store):
            ref = getattr(args, "id", None) or (getattr(args, "ids", None) or [""])[0] or getattr(args, "on", "") or ""
            local_touch(args)
            args.store.directive(current_actor(args), whoami_principal(args), quote_,
                                 args.store.get(ref)["ref"] if ref else "", args.cmd)
    except TTError as e:
        die(str(e))


