def pick_next(args, who, project):
    """The top item for `who`: their in-progress work first, then open items by priority.
    With --start, claims it atomically, so parallel agents never grab the same item."""
    items = args.store.list(project, ["open", "doing"], None, who)
    pool = shared_claude_pool(args, who)
    if not items and pool:  # a named chat also takes work queued for its person's Claude
        items = args.store.list(project, ["open", "doing"], None, pool)
        items = [i for i in items if i["status"] == "open"]  # not the ones another chat is doing
    if not items and args.any:
        items = args.store.list(project, ["open"], None, "")
    for it in items:
        if not args.start or it["status"] == "doing":
            return it
        try:
            return args.store.update(it["id"], current_actor(args), status="doing", assignee=who,
                                     if_status=it["status"], if_assignee=it["assignee"])
        except TTError as e:
            if e.status != 409:
                raise  # someone else got it first; try the next one
    return None


def shared_claude_pool(args, who):
    """Chats named after their tmux session still pick up work assigned to 'claude'
    (private board) or 'claude-<person>' (shared board), the queue everyone assigns to."""
    if args.for_ or not agent_name() or os.environ.get("TIANTASKS_AGENT"):
        return ""
    pool = f"claude-{args.store.me()['user']}" if isinstance(args.store, RemoteStore) else "claude"
    return "" if pool == who else pool


def cmd_next(args):
    who = args.for_ or current_actor(args)
    project = None if args.all_projects else current_project(args)
    remote = isinstance(args.store, RemoteStore)
    interval = args.interval or (5 if remote else 2)
    deadline = time.time() + args.timeout if args.timeout else None
    it = pick_next(args, who, project)
    if not it and args.wait:
        print(dim(f"waiting for work for {who} in {project or 'any project'}… (Ctrl-C to stop)"), file=sys.stderr)
        try:
            while not it and (deadline is None or time.time() < deadline):
                seen = args.store.version()  # one tiny read per poll; the list is only re-read on change
                while args.store.version() == seen and (deadline is None or time.time() < deadline):
                    time.sleep(interval)
                it = pick_next(args, who, project)
        except KeyboardInterrupt:
            pass
    if not it:
        print("null" if args.json else dim(f"no open items for {who} in {project or 'any project'}."))
        return
    comments = comments_for(args.store, it)
    if args.json:
        print(json.dumps({**it, "comments": comments}, indent=2))
        return
    print(fmt(it, show_project=project is None))
    if it["body"]:
        print("\n" + it["body"])
    if comments:
        print(dim("\ncomments:"))
        print_threads(comments)
    if it.get("attachments"):
        print(dim(f"\n(screenshots on the board: {', '.join(a['name'] for a in it['attachments'])})"))


def cmd_brief(args):
    """A one-read snapshot of the board, written for a lead agent that hands out work."""
    project = None if args.all_projects else current_project(args)
    items = args.store.list(project)
    events = args.store.events(300, project)
    first_line = lambda t: (t or "").strip().split("\n")[0][:160]
    open_ = [i for i in items if i["status"] == "open"]
    unassigned = [i for i in open_ if not i["assignee"]]
    queued = [i for i in open_ if i["assignee"]]
    doing = [i for i in items if i["status"] == "doing"]
    done = sorted((i for i in items if i["status"] == "done"), key=lambda i: i["resolved_at"], reverse=True)[:args.done]
    last_seen = {}
    for e in events:  # newest first
        last_seen.setdefault(e["actor"], e["at"])
    team = sorted({i["assignee"] for i in queued + doing} | set(last_seen))
    roster = [{"name": n,
               "working_on": [i["ref"] for i in doing if i["assignee"] == n],
               "queued": [i["ref"] for i in queued if i["assignee"] == n],
               "last_active": last_seen.get(n)} for n in team]
    if args.json:
        print(json.dumps({"project": project, "you": current_actor(args), "unassigned": unassigned,
                          "queued": queued, "in_progress": doing, "recently_done": done, "team": roster}, indent=2))
        return

    def line(i, who=True):
        bits = [i["ref"]]
        if i["priority"]:
            bits.append(f"[{i['priority']}]")
        if who and i["assignee"]:
            bits.append(f"@{i['assignee']}")
        bits.append(i["title"])
        extra = first_line(i["body"])
        if i.get("attachments"):
            extra += f" (📎{len(i['attachments'])})"
        return "- " + " ".join(bits) + (f" — {extra}" if extra.strip() else "")

    print(f"# Tiantasks brief · {project or 'all projects'} · you are {current_actor(args)}")
    print(f"\n## Unassigned, ready to hand out ({len(unassigned)})")
    print("\n".join(line(i) for i in unassigned) or "- none")
    print(f"\n## Assigned, not started ({len(queued)})")
    print("\n".join(line(i) for i in queued) or "- none")
    print(f"\n## In progress ({len(doing)})")
    print("\n".join(line(i) + f" (started {show_ts(i['updated_at'])})" for i in doing) or "- none")
    print(f"\n## Recently done ({len(done)})")
    print("\n".join(f"- {i['ref']} @{i['assignee'] or '?'} {i['title']}" + (f" — {i['note']}" if i["note"] else "")
                    for i in done) or "- none")
    print("\n## Team")
    for r in roster:
        status = f"working on {', '.join(r['working_on'])}" if r["working_on"] else "idle"
        q = f", {len(r['queued'])} queued" if r["queued"] else ""
        seen = f", last active {show_ts(r['last_active'])}" if r["last_active"] else ""
        print(f"- {r['name']}: {status}{q}{seen}")
    print("\nUse `tt show ID` for full details and comments.")


