  const tiles = M.files.map(f => f.mime.startsWith('image/')
    ? `<div class="tile"><button class="thumb" data-act="zoom" data-file="${f.id}" aria-label="View ${esc(f.name)}"><img src="${f.url}" alt="${esc(f.name)}" loading="lazy"><span class="cap">${esc(f.name)} · ${size(f.size)}</span></button>${del(f)}</div>`
