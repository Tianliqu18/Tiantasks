def cmd_ui(args):
    if isinstance(args.store, RemoteStore):
        print(f"Shared board: {args.store.url}")
        if not args.no_open:
            webbrowser.open(args.store.url)
        return
    url = f"http://127.0.0.1:{args.port}"
    if args.stop:
        if not server_up(args.port):
            print(dim("not running"))
            return
        req = urllib.request.Request(url + "/api/shutdown", method="POST", headers={"X-Tiantasks": "1"})
        urllib.request.urlopen(req, timeout=2).read()
        print("stopped")
        return
    if not server_up(args.port):
        log = open(args.store.path.parent / "server.log", "a")
        env = {**os.environ, "TIANTASKS_DB": str(args.store.path)}
        env.pop("CLAUDECODE", None)  # edits made on the page are yours, not Claude's
        env.pop("TIANTASKS_ACTOR", None)
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "serve", "--port", str(args.port)],
                         stdout=log, stderr=log, stdin=subprocess.DEVNULL, env=env,
                         start_new_session=True)
        for _ in range(50):
            if server_up(args.port):
                break
            time.sleep(0.1)
        else:
            die(f"server didn't start; see {log.name}")
    print(f"Tiantasks is running at {url}")
    if not args.no_open:
        webbrowser.open(url)


