def cmd_claude_setup(args):
    if args.project_md:
        r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        target = Path(r.stdout.strip() if r.returncode == 0 else Path.cwd()) / "CLAUDE.md"
        existing = target.read_text() if target.exists() else ""
        if "Tiantasks" in existing:
            print(dim(f"{target} already mentions Tiantasks"))
            return
        target.write_text(existing.rstrip() + ("\n" if existing else "") + CLAUDE_MD_SNIPPET)
        print(green(f"added Tiantasks instructions to {target}"))
        return
    skill = Path.home() / ".claude" / "skills" / "tiantasks" / "SKILL.md"
    skill.parent.mkdir(parents=True, exist_ok=True)
