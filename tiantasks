VERSION = "2.2.1"
DEFAULT_DB = Path.home() / ".tiantasks" / "tiantasks.db"
CONFIG = Path.home() / ".tiantasks" / "config.json"
DEFAULT_PORT = int(os.environ.get("TIANTASKS_PORT", 7777))
PRIORITIES = ("crit", "high", "med", "low")
PRANK = {p: i for i, p in enumerate(PRIORITIES)}
STATUSES = ("open", "doing", "done")

SCHEMA = """
CREATE TABLE IF NOT EXISTS items (
  id          INTEGER PRIMARY KEY,
  kind        TEXT NOT NULL CHECK (kind IN ('task', 'issue')),
  num         INTEGER NOT NULL,
  project     TEXT NOT NULL,
  title       TEXT NOT NULL,
  body        TEXT NOT NULL DEFAULT '',
  status      TEXT NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'doing', 'done')),
  priority    TEXT NOT NULL DEFAULT '',
  tags        TEXT NOT NULL DEFAULT '[]',
  assignee    TEXT NOT NULL DEFAULT '',
  note        TEXT NOT NULL DEFAULT '',
  created_by  TEXT NOT NULL DEFAULT '',
  created_at  TEXT NOT NULL,
  updated_at  TEXT NOT NULL,
  resolved_at TEXT,
  UNIQUE (kind, num)
);
CREATE TABLE IF NOT EXISTS events (
  id      INTEGER PRIMARY KEY,
  item_id INTEGER NOT NULL,
  ref     TEXT NOT NULL,
  title   TEXT NOT NULL,
  project TEXT NOT NULL,
  at      TEXT NOT NULL,
  actor   TEXT NOT NULL,
  action  TEXT NOT NULL,
  detail  TEXT NOT NULL DEFAULT ''
);
CREATE INDEX IF NOT EXISTS events_item ON events (item_id);
"""


class TTError(Exception):
    def __init__(self, msg, status=400):
        super().__init__(msg)
        self.status = status


def now_iso():
    return dt.datetime.now().isoformat(timespec="seconds")


def sort_key(it):
    return (0 if it["status"] == "doing" else 1, PRANK.get(it["priority"], 9), it["created_at"])


def parse_ref(ref):
    if isinstance(ref, int) or str(ref).isdigit():
        return None, int(ref)
    m = re.fullmatch(r"#?([TtIi])-?(\d+)", str(ref).strip())
    if not m:
        raise TTError(f"'{ref}' is not a valid id (expected something like T-3 or I-12)")
    return ("task" if m.group(1).upper() == "T" else "issue"), int(m.group(2))


def clean_tags(tags):
    if isinstance(tags, str):
        tags = re.split(r"[,\s]+", tags)
    return [t.lstrip("#").strip() for t in tags if t and t.lstrip("#").strip()]


# ---------------------------------------------------------------- store

class Store:
    def __init__(self, path=None):
        self.path = Path(path or os.environ.get("TIANTASKS_DB") or DEFAULT_DB).expanduser()
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self.db = sqlite3.connect(self.path, timeout=15, isolation_level=None,
                                  check_same_thread=False)
        self.db.row_factory = sqlite3.Row
        self.db.execute("PRAGMA journal_mode=WAL")
        self.db.executescript(SCHEMA)

    def close(self):
        self.db.close()

    @contextmanager
    def tx(self):
        self.db.execute("BEGIN IMMEDIATE")
        try:
            yield
        except BaseException:
            self.db.execute("ROLLBACK")
            raise
        self.db.execute("COMMIT")

    @staticmethod
    def _row(r):
        d = dict(r)
        d["tags"] = json.loads(d["tags"])
        d["ref"] = f"{'T' if d['kind'] == 'task' else 'I'}-{d['num']}"
        return d

    def get(self, ref):
        kind, num = parse_ref(ref)
        if kind is None:
            r = self.db.execute("SELECT * FROM items WHERE id=?", (num,)).fetchone()
        else:
            r = self.db.execute("SELECT * FROM items WHERE kind=? AND num=?", (kind, num)).fetchone()
        if not r:
            raise TTError(f"no item {ref}", 404)
        return self._row(r)

    def _log(self, item, actor, action, detail=""):
        self.db.execute(
            "INSERT INTO events (item_id, ref, title, project, at, actor, action, detail)"
            " VALUES (?,?,?,?,?,?,?,?)",
            (item["id"], item["ref"], item["title"], item["project"], now_iso(), actor, action, detail))

    def create(self, kind, title, project, actor, body="", priority="", tags=(), assignee=""):
        title = " ".join(str(title).split())
        if not title:
            raise TTError("title cannot be empty")
        if kind not in ("task", "issue"):
            raise TTError("kind must be task or issue")
        if priority and priority not in PRIORITIES:
            raise TTError(f"priority must be one of {', '.join(PRIORITIES)}")
        now = now_iso()
        with self.tx():
            num = self.db.execute("SELECT COALESCE(MAX(num), 0) + 1 FROM items WHERE kind=?",
                                  (kind,)).fetchone()[0]
            cur = self.db.execute(
                "INSERT INTO items (kind, num, project, title, body, priority, tags, assignee,"
                " created_by, created_at, updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                (kind, num, project or "general", title, body or "", priority or "",
                 json.dumps(clean_tags(tags)), assignee or "", actor, now, now))
            item = self.get(cur.lastrowid)
            self._log(item, actor, "opened", f"for {assignee}" if assignee else "")
        return item

    def update(self, ref, actor, **ch):
        with self.tx():
            it = self.get(ref)
            sets, events = {}, []
            status = ch.get("status")
            note = ch.get("note")
            if status and status != it["status"]:
                if status not in STATUSES:
                    raise TTError(f"status must be one of {', '.join(STATUSES)}")
                sets["status"] = status
                if status == "done":
                    sets["resolved_at"] = now_iso()
                    sets["note"] = (note or "").strip()
                    events.append(("resolved", sets["note"]))
                    note = None
                elif it["status"] == "done":
                    sets["resolved_at"], sets["note"] = None, ""
                    events.append(("reopened", ""))
                    if status == "doing":
                        events.append(("started", ""))
                else:
                    events.append(("started" if status == "doing" else "paused", ""))
            if note is not None and note.strip() != it["note"]:
                sets["note"] = note.strip()
                events.append(("noted", note.strip()))
            if "assignee" in ch and (ch["assignee"] or "") != it["assignee"]:
                sets["assignee"] = ch["assignee"] or ""
                events.append(("assigned", f"to {ch['assignee']}" if ch["assignee"] else "to nobody"))
            if "priority" in ch and (ch["priority"] or "") != it["priority"]:
                p = ch["priority"] or ""
                if p and p not in PRIORITIES:
                    raise TTError(f"priority must be one of {', '.join(PRIORITIES)}")
                sets["priority"] = p
                events.append(("reprioritized", p or "none"))
            if "title" in ch and ch["title"] and " ".join(ch["title"].split()) != it["title"]:
                sets["title"] = " ".join(ch["title"].split())
                events.append(("renamed", f"from “{it['title']}”"))
            if "body" in ch and (ch["body"] or "") != it["body"]:
                sets["body"] = ch["body"] or ""
                events.append(("edited", "description"))
            if "tags" in ch and clean_tags(ch["tags"]) != it["tags"]:
                sets["tags"] = json.dumps(clean_tags(ch["tags"]))
                events.append(("tagged", ", ".join(clean_tags(ch["tags"])) or "none"))
            if "project" in ch and ch["project"] and ch["project"] != it["project"]:
                sets["project"] = ch["project"]
                events.append(("moved", f"to {ch['project']}"))
            if not sets:
                return it
            sets["updated_at"] = now_iso()
            cols = ", ".join(f"{k}=?" for k in sets)
            self.db.execute(f"UPDATE items SET {cols} WHERE id=?", (*sets.values(), it["id"]))
            it = self.get(it["id"])
            for action, detail in events:
                self._log(it, actor, action, detail)
        return it

    def comment(self, ref, actor, text):
        if not text.strip():
            raise TTError("comment cannot be empty")
        with self.tx():
            it = self.get(ref)
            self._log(it, actor, "commented", text.strip())
        return it

    def delete(self, ref, actor):
        with self.tx():
            it = self.get(ref)
            self.db.execute("DELETE FROM items WHERE id=?", (it["id"],))
            self._log(it, actor, "deleted")
        return it

    def list(self, project=None, statuses=None, kind=None, assignee=None, grep=None):
        sql, args = "SELECT * FROM items WHERE 1=1", []
        if project:
            sql += " AND project=?"; args.append(project)
        if statuses:
            sql += f" AND status IN ({','.join('?' * len(statuses))})"; args += list(statuses)
        if kind:
            sql += " AND kind=?"; args.append(kind)
        if assignee is not None:
            sql += " AND assignee=?"; args.append(assignee)
        if grep:
            sql += " AND (title LIKE ? OR body LIKE ? OR note LIKE ?)"; args += [f"%{grep}%"] * 3
        items = [self._row(r) for r in self.db.execute(sql, args)]
        return sorted(items, key=sort_key)

    def events(self, limit=40, project=None, item_id=None):
        sql, args = "SELECT * FROM events WHERE 1=1", []
        if project:
            sql += " AND project=?"; args.append(project)
        if item_id:
            sql += " AND item_id=?"; args.append(item_id)
        sql += " ORDER BY id DESC LIMIT ?"; args.append(limit)
        return [dict(r) for r in self.db.execute(sql, args)]

    def version(self):
        return self.db.execute("SELECT COALESCE(MAX(id), 0) FROM events").fetchone()[0]

    def projects(self):
        rows = self.db.execute(
            "SELECT project, SUM(status != 'done') AS open, COUNT(*) AS total FROM items"
            " GROUP BY project ORDER BY project")
        return [dict(r) for r in rows]

    def assignees(self):
        return [r[0] for r in self.db.execute(
            "SELECT DISTINCT assignee FROM items WHERE assignee != '' ORDER BY assignee")]


# ---------------------------------------------------------------- remote board

def load_config():
    """Return {url, token} for a shared board, or None to use the local database."""
    if os.environ.get("TIANTASKS_URL"):
        return {"url": os.environ["TIANTASKS_URL"], "token": os.environ.get("TIANTASKS_TOKEN", "")}
    try:
        cfg = json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return None
    return cfg if cfg.get("url") else None


def ssl_context():
    # python.org builds of Python on macOS ship without CA certificates, so also trust the
    # system bundle; otherwise every HTTPS call fails with CERTIFICATE_VERIFY_FAILED.
    ctx = ssl.create_default_context()
    for bundle in ("/etc/ssl/cert.pem", "/opt/homebrew/etc/ca-certificates/cert.pem"):
        if os.path.exists(bundle):
            ctx.load_verify_locations(bundle)
    return ctx


class RemoteStore:
    """Same interface as Store, backed by a shared board's HTTP API."""

    def __init__(self, url, token):
        self.url, self.token, self._me = url.rstrip("/"), token, None
        self.path = self.url

    def _req(self, method, path, body=None, params=None):
        if params:
            path += "?" + urlencode({k: v for k, v in params.items() if v is not None})
        # Cloudflare's bot check blocks Python's default User-Agent (error 1010), so name ourselves.
        headers = {"Authorization": f"Bearer {self.token}", "X-Tiantasks": "1",
                   "Content-Type": "application/json", "User-Agent": f"tiantasks-cli/{VERSION}"}
        if os.environ.get("CLAUDECODE"):
            headers["X-Tiantasks-Agent"] = "claude"
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(self.url + path, data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=20, context=ssl_context()) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            try:
                msg = json.load(e).get("error")
            except Exception:
                msg = None
            if e.code == 401:
                msg = "the shared board rejected your token; run `tt login` again"
            raise TTError(msg or f"{self.url} returned HTTP {e.code}", e.code)
        except urllib.error.URLError as e:
            raise TTError(f"can't reach {self.url}: {e.reason}")

    def _item(self, ref):
        return f"/api/items/{quote(str(ref).strip().lstrip('#'))}"

    def me(self):
        if self._me is None:
            self._me = self._req("GET", "/api/me")
        return self._me

    def get(self, ref):
        return self._req("GET", self._item(ref))

    def create(self, kind, title, project, actor, body="", priority="", tags=(), assignee=""):
        return self._req("POST", "/api/items", {
            "kind": kind, "title": title, "project": project, "body": body,
            "priority": priority, "tags": list(tags), "assignee": assignee})

    def update(self, ref, actor, **ch):
        return self._req("PATCH", self._item(ref), ch)

    def comment(self, ref, actor, text):
        return self._req("POST", self._item(ref) + "/comment", {"text": text})

    def delete(self, ref, actor):
        return self._req("DELETE", self._item(ref))

    def list(self, project=None, statuses=None, kind=None, assignee=None, grep=None):
        return self._req("GET", "/api/items", params={
            "project": project, "status": ",".join(statuses) if statuses else None,
            "kind": kind, "assignee": assignee, "grep": grep})

    def events(self, limit=40, project=None, item_id=None):
        return self._req("GET", "/api/events",
                         params={"limit": limit, "project": project, "item_id": item_id})

    def projects(self):
        return self._req("GET", "/api/projects")

    def close(self):
        pass


# ---------------------------------------------------------------- context

def current_actor(args=None):
    store = getattr(args, "store", None)
    if isinstance(store, RemoteStore):
        return store.me()["actor"]  # the server decides who you are from your token
    if args is not None and getattr(args, "actor", None):
        return args.actor
    if os.environ.get("TIANTASKS_ACTOR"):
        return os.environ["TIANTASKS_ACTOR"]
    if os.environ.get("CLAUDECODE"):
        return "claude"
    return getpass.getuser()


def current_project(args=None):
    if args is not None and getattr(args, "project", None):
        return args.project
    if os.environ.get("TIANTASKS_PROJECT"):
        return os.environ["TIANTASKS_PROJECT"]
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return Path(r.stdout.strip()).name if r.returncode == 0 else Path.cwd().name


# ---------------------------------------------------------------- terminal output

COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def _c(code):
    return lambda s: f"\033[{code}m{s}\033[0m" if COLOR else s


dim, bold, green, red, yellow, cyan, strike = map(_c, ("2", "1", "32", "31", "33", "36", "9"))
PRIO_COLOR = {"crit": red, "high": red, "med": yellow, "low": dim}


def die(msg, code=1):
    print(red(f"tiantasks: {msg}"), file=sys.stderr)
    sys.exit(code)


def show_ts(s):
    """Timestamps from a hosted board are UTC ('...Z'); show them in local time."""
    if s and s.endswith("Z"):
        s = (dt.datetime.fromisoformat(s[:-1] + "+00:00").astimezone()
             .replace(tzinfo=None).isoformat(timespec="seconds"))
    return (s or "").replace("T", " ")


def fmt(it, show_project=False):
    box = {"done": green("[x]"), "doing": yellow("[~]"), "open": "[ ]"}[it["status"]]
    ref = (red if it["kind"] == "issue" else cyan)(it["ref"].ljust(5))
    title = strike(dim(it["title"])) if it["status"] == "done" else it["title"]
    extras = []
    if it["status"] == "doing":
        extras.append(yellow("in progress"))
    if it["priority"]:
        extras.append(PRIO_COLOR[it["priority"]](it["priority"]))
    if it["assignee"]:
        extras.append(cyan("@" + it["assignee"]))
    extras += [dim("#" + t) for t in it["tags"]]
    if show_project:
        extras.append(dim(f"[{it['project']}]"))
    if it["status"] == "done":
        extras.append(dim(f"resolved {show_ts(it['resolved_at'])[:10]}" + (f": {it['note']}" if it["note"] else "")))
    return f"{box} {ref} {title}" + ("  " + " ".join(extras) if extras else "")


def emit(args, item, verb, color=green):
    if getattr(args, "json", False):
        print(json.dumps(item, indent=2))
    else:
        print(f"{color(verb)} {fmt(item)}")


# ---------------------------------------------------------------- commands

def cmd_add(args, kind=None):
    kind = kind or ("issue" if args.issue else "task")
    assignee = args.to
    if assignee == "me":
        assignee = current_actor(args)
    it = args.store.create(kind, " ".join(args.text), current_project(args), current_actor(args),
                           body=args.desc or "", priority=args.priority or "",
                           tags=args.tag or [], assignee=assignee or "")
    emit(args, it, "added")


def cmd_resolve(args):
    for ref in args.ids:
        it = args.store.update(ref, current_actor(args), status="done", note=args.message or "")
        emit(args, it, "resolved")


def cmd_status(status, verb, color):
    def run(args):
        for ref in args.ids:
            ch = {"status": status}
            if status == "doing" and not args.store.get(ref)["assignee"]:
                ch["assignee"] = current_actor(args)
            emit(args, args.store.update(ref, current_actor(args), **ch), verb, color)
    return run


def cmd_assign(args):
    who = "" if args.who in ("nobody", "none", "-") else args.who
    if who == "me":
        who = current_actor(args)
    for ref in args.ids:
        emit(args, args.store.update(ref, current_actor(args), assignee=who), "assigned", cyan)


def cmd_edit(args):
    ch = {}
    if args.text:
        ch["title"] = " ".join(args.text)
    if args.priority is not None:
        ch["priority"] = "" if args.priority == "none" else args.priority
    if args.desc is not None:
        ch["body"] = args.desc
    if args.tag or args.untag:
        tags = args.store.get(args.id)["tags"]
        tags += [t for t in clean_tags(args.tag or []) if t not in tags]
        ch["tags"] = [t for t in tags if t not in clean_tags(args.untag or [])]
    if args.move:
        ch["project"] = args.move
    if not ch:
        die("nothing to change (pass new title, -p, -d, -t, --untag or --move)")
    emit(args, args.store.update(args.id, current_actor(args), **ch), "edited", cyan)


def cmd_comment(args):
    it = args.store.comment(args.id, current_actor(args), " ".join(args.text))
    print(f"{cyan('commented on')} {it['ref']}")


def cmd_remove(args):
    it = args.store.delete(args.id, current_actor(args))
    print(f"{red('removed')} {it['ref']} {it['title']}")


def cmd_list(args):
    statuses = ["done"] if args.resolved else (None if args.all else ["open", "doing"])
    kind = "task" if args.tasks else "issue" if args.issues else None
    assignee = args.for_
    if assignee == "me":
        assignee = current_actor(args)
    elif assignee in ("nobody", "none"):
        assignee = ""
    project = None if args.all_projects else current_project(args)
    items = args.store.list(project, statuses, kind, assignee, args.grep)
    if args.json:
        print(json.dumps(items, indent=2))
        return
    scope = "all projects" if project is None else project
    if not items:
        print(dim(f"nothing here ({scope})."))
        return
    done = sorted((i for i in items if i["status"] == "done"), key=lambda i: i["resolved_at"], reverse=True)
    groups = [("Issue queue", [i for i in items if i["kind"] == "issue" and i["status"] != "done"]),
              ("Task queue", [i for i in items if i["kind"] == "task" and i["status"] != "done"]),
              ("Resolved", done)]
    print(dim(f"— {scope} —"))
    for title, group in groups:
        if group:
            print(bold(f"\n{title} ({len(group)})"))
            for i in group:
                print("  " + fmt(i, show_project=project is None))


def cmd_next(args):
    who = args.for_ or current_actor(args)
    project = None if args.all_projects else current_project(args)
    items = args.store.list(project, ["open", "doing"], None, who)
    if not items and args.any:
        items = args.store.list(project, ["open", "doing"], None, "")
    if not items:
        if args.json:
            print("null")
        else:
            print(dim(f"no open items for {who} in {project or 'any project'}."))
        return
    it = items[0]
    if args.start and it["status"] != "doing":
        it = args.store.update(it["id"], current_actor(args), status="doing", assignee=who)
    if args.json:
        print(json.dumps(it, indent=2))
        return
    print(fmt(it, show_project=project is None))
    if it["body"]:
        print("\n" + it["body"])


def cmd_show(args):
    it = args.store.get(args.id)
    history = args.store.events(100, item_id=it["id"])
    if args.json:
        print(json.dumps({**it, "history": history}, indent=2))
        return
    print(fmt(it))
    print(dim(f"  {it['kind']} · project {it['project']} · opened {show_ts(it['created_at'])}"
              f" by {it['created_by']}"))
    if it["body"]:
        print("\n  " + it["body"].replace("\n", "\n  "))
    print(dim("\n  history:"))
    for e in reversed(history):
        detail = f": {e['detail']}" if e["detail"] else ""
        print(dim(f"    {show_ts(e['at'])}  {e['actor']} {e['action']}{detail}"))


def cmd_log(args):
    project = None if args.all_projects else current_project(args)
    for e in reversed(args.store.events(args.n, project)):
        detail = f": {e['detail']}" if e["detail"] else ""
        print(f"{dim(show_ts(e['at']))}  {e['actor']} {e['action']} "
              f"{e['ref']} {e['title']}{dim(detail)}")


def cmd_projects(args):
    for p in args.store.projects():
        print(f"{p['project']:<30} {p['open']} open / {p['total']} total")


# ---------------------------------------------------------------- web server

def server_up(port):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/ping", timeout=0.5) as r:
            return json.load(r).get("app") == "tiantasks"
    except Exception:
        return False


def parse_users(spec):
    """TIANTASKS_USERS="tianli:<token>,oliver:<token>" -> {token: name}."""
    users = {}
    for part in filter(None, (p.strip() for p in (spec or "").split(","))):
        name, _, token = part.partition(":")
        if not re.fullmatch(r"[a-z0-9_.]+", name or "") or len(token) < 20:
            raise SystemExit(f"bad TIANTASKS_USERS entry {name!r}: need lowercase-name:token (20+ chars)")
        users[token] = name
    return users


def make_handler(db_path, me, users=None):
    """`users` is None for a private local board, or {token: name} for a shared one."""

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code, body, ctype="application/json", headers=()):
            data = body if isinstance(body, bytes) else json.dumps(body).encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            for k, v in headers:
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)

        def _body(self):
            n = int(self.headers.get("Content-Length") or 0)
            return json.loads(self.rfile.read(n)) if n else {}

        def _user_for(self, token):
            for known, name in users.items():
                if token and hmac.compare_digest(token.encode(), known.encode()):
                    return name
            return None

        def _authed_user(self):
            auth = self.headers.get("Authorization", "")
            if auth.startswith("Bearer "):
                return self._user_for(auth[7:].strip())
            cookie = SimpleCookie(self.headers.get("Cookie", ""))
            return self._user_for(cookie["tt_token"].value) if "tt_token" in cookie else None

        def _cookie(self, value, max_age):
            secure = "; Secure" if self.headers.get("X-Forwarded-Proto") == "https" else ""
            return ("Set-Cookie", f"tt_token={value}; Path=/; Max-Age={max_age}; HttpOnly; "
                                  f"SameSite=Strict{secure}")

        def _login(self, method, path):
            if path == "/logout":
                return self._send(303, b"", headers=[("Location", "/"), self._cookie("", 0)])
            if method == "POST":
                n = int(self.headers.get("Content-Length") or 0)
                token = parse_qs(self.rfile.read(n).decode()).get("token", [""])[0].strip()
                if self._user_for(token):
                    return self._send(303, b"", headers=[("Location", "/"),
                                                         self._cookie(token, 60 * 60 * 24 * 365)])
                return self._send(401, LOGIN_PAGE.replace("<!--err-->", "That token isn't valid.").encode(),
                                  "text/html; charset=utf-8")
            return self._send(200, LOGIN_PAGE.encode(), "text/html; charset=utf-8")

        def _handle(self, method):
            url = urlparse(self.path)
            if url.path == "/api/ping":
                return self._send(200, {"app": "tiantasks", "version": VERSION})
            if url.path == "/tiantasks":  # the CLI itself, so teammates can install it from here
                return self._send(200, Path(os.path.realpath(__file__)).read_bytes(),
                                  "text/x-python; charset=utf-8")
            if users is None:
                # Private board: only answer same-machine requests (blocks DNS rebinding).
                host = (self.headers.get("Host") or "").rsplit(":", 1)[0]
                if host not in ("127.0.0.1", "localhost"):
                    return self._send(403, {"error": "forbidden host"})
                user = me
            else:
                if url.path in ("/login", "/logout"):
                    return self._login(method, url.path)
                user = self._authed_user()
                if not user:
                    if method == "GET" and url.path == "/":
                        return self._login("GET", "/login")
                    return self._send(401, {"error": "not signed in"})
            # Writes need a custom header, which other websites can't send cross-origin.
            if method != "GET" and self.headers.get("X-Tiantasks") != "1":
                return self._send(403, {"error": "missing X-Tiantasks header"})
            actor = user
            if self.headers.get("X-Tiantasks-Agent") == "claude":
                actor = "claude" if users is None else f"claude-{user}"
            q = {k: v[0] for k, v in parse_qs(url.query, keep_blank_values=True).items()}
            store = Store(db_path)
            try:
                return self._route(method, url.path, q, store, user, actor)
            except TTError as e:
                return self._send(e.status, {"error": str(e)})
            except (ValueError, KeyError, TypeError) as e:
                return self._send(400, {"error": str(e)})
            finally:
                store.close()

        def _route(self, method, path, q, store, user, actor):
            m = re.fullmatch(r"/api/items/([A-Za-z]?-?\d+)(/events|/comment)?", path)
            if method == "GET" and path == "/":
                return self._send(200, PAGE.encode(), "text/html; charset=utf-8")
            if method == "GET" and path == "/api/version":
                return self._send(200, {"v": store.version()})
            if method == "GET" and path == "/api/me":
                return self._send(200, {"user": user, "actor": actor, "shared": users is not None})
            if method == "GET" and path == "/api/state":
                project = q.get("project") or None
                people = set(users.values()) if users is not None else {me}
                agents = {f"claude-{p}" for p in people} if users is not None else {"claude"}
                return self._send(200, {
                    "me": user, "shared": users is not None,
                    "items": store.list(project),
                    "events": store.events(40, project),
                    "projects": store.projects(),
                    "assignees": sorted(set(store.assignees()) | people | agents),
                })
            if method == "GET" and path == "/api/items":
                st = q.get("status")
                return self._send(200, store.list(
                    q.get("project") or None, st.split(",") if st else None, q.get("kind") or None,
                    q["assignee"] if "assignee" in q else None, q.get("grep") or None))
            if method == "GET" and path == "/api/events":
                item_id = int(q["item_id"]) if q.get("item_id") else None
                return self._send(200, store.events(int(q.get("limit") or 40),
                                                    q.get("project") or None, item_id))
            if method == "GET" and path == "/api/projects":
                return self._send(200, store.projects())
            if method == "GET" and m and not m.group(2):
                return self._send(200, store.get(m.group(1)))
            if method == "GET" and m and m.group(2) == "/events":
                return self._send(200, store.events(200, item_id=store.get(m.group(1))["id"]))
            if method == "POST" and path == "/api/items":
                b = self._body()
                return self._send(201, store.create(
                    b.get("kind", "task"), b.get("title", ""), b.get("project") or "general", actor,
                    body=b.get("body", ""), priority=b.get("priority", ""),
                    tags=b.get("tags", []), assignee=b.get("assignee", "")))
            if method == "POST" and m and m.group(2) == "/comment":
                return self._send(200, store.comment(m.group(1), actor, self._body().get("text", "")))
            if method == "PATCH" and m and not m.group(2):
                allowed = {"status", "note", "assignee", "priority", "title", "body", "tags", "project"}
                ch = {k: v for k, v in self._body().items() if k in allowed}
                return self._send(200, store.update(m.group(1), actor, **ch))
            if method == "DELETE" and m and not m.group(2):
                return self._send(200, store.delete(m.group(1), actor))
            if method == "POST" and path == "/api/shutdown" and users is None:
                self._send(200, {"ok": True})
                threading.Thread(target=self.server.shutdown, daemon=True).start()
                return
            return self._send(404, {"error": "not found"})

        def do_GET(self):
            self._handle("GET")

        def do_POST(self):
            self._handle("POST")

        def do_PATCH(self):
            self._handle("PATCH")

        def do_DELETE(self):
            self._handle("DELETE")

    return Handler


def cmd_serve(args):
    db_path = args.store.path
    args.store.close()
    users = parse_users(os.environ.get("TIANTASKS_USERS")) or None
    if users is None and args.host not in ("127.0.0.1", "localhost"):
        die("refusing to serve on a public address without logins; set TIANTASKS_USERS")
    handler = make_handler(db_path, current_actor(args), users)
    srv = ThreadingHTTPServer((args.host, args.port), handler)
    mode = f"shared, {len(users)} users" if users else "private"
    print(f"Tiantasks on http://{args.host}:{args.port} ({mode}, db: {db_path})  Ctrl-C to stop",
          flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


def cmd_login(args):
    url = args.url.rstrip("/")
    if not re.match(r"https?://", url):
        url = "https://" + url
    if url.startswith("http://") and not re.match(r"http://(127\.0\.0\.1|localhost)[:/]", url + "/"):
        die("use an https:// URL so your token isn't sent in the clear")
    token = os.environ.get("TIANTASKS_TOKEN") or getpass.getpass("Token (input hidden): ").strip()
    me = RemoteStore(url, token).me()
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.touch(mode=0o600)
    CONFIG.write_text(json.dumps({"url": url, "token": token}, indent=2))
    os.chmod(CONFIG, 0o600)
    print(green(f"signed in to {url} as {me['user']}"))
    print(dim(f"`tt` now uses this shared board. Your Claude Code sessions act as claude-{me['user']}."))


def cmd_logout(args):
    if CONFIG.exists():
        CONFIG.unlink()
        print("signed out; `tt` is back to your local board")
    else:
        print(dim("not signed in to a shared board"))


def cmd_whoami(args):
    if isinstance(args.store, RemoteStore):
        me = args.store.me()
        print(f"{me['actor']}  (signed in as {me['user']} on shared board {args.store.url})")
    else:
        print(f"{current_actor(args)}  (local board {args.store.path})")


def cmd_ui(args):
    if isinstance(args.store, RemoteStore):
        print(f"Shared board: {args.store.url}")
        if not args.no_open:
            webbrowser.open(args.store.url)
        return
    url = f"http://127.0.0.1:{args.port}"
    if args.stop:
        if not server_up(args.port):
            print(dim("not running"))
            return
        req = urllib.request.Request(url + "/api/shutdown", method="POST", headers={"X-Tiantasks": "1"})
        urllib.request.urlopen(req, timeout=2).read()
        print("stopped")
        return
    if not server_up(args.port):
        log = open(args.store.path.parent / "server.log", "a")
        env = {**os.environ, "TIANTASKS_DB": str(args.store.path)}
        env.pop("CLAUDECODE", None)  # edits made on the page are yours, not Claude's
        env.pop("TIANTASKS_ACTOR", None)
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "serve", "--port", str(args.port)],
                         stdout=log, stderr=log, stdin=subprocess.DEVNULL, env=env,
                         start_new_session=True)
        for _ in range(50):
            if server_up(args.port):
                break
            time.sleep(0.1)
        else:
            die(f"server didn't start; see {log.name}")
    print(f"Tiantasks is running at {url}")
    if not args.no_open:
        webbrowser.open(url)


