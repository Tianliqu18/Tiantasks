document.addEventListener('keydown', e => {
  if (dlg.open && e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); form.requestSubmit(); return; }
  // Enter in an item's comment / resolution-note box does the same as its button.
  const f = e.target && e.target.dataset && e.target.dataset.f;
  if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && (f === 'comment' || f === 'note' || f === 'reply')) {
    e.preventDefault();
    const sel = {comment: '[data-act=comment]', note: '[data-act=resolveNote]', reply: '[data-act=sendReply]'}[f];
    const box = f === 'reply' ? e.target.closest('.replybox') : e.target.closest('.item');
    const btn = box && box.querySelector(sel);
    if (btn) btn.click();
    return;
  }
  const t = e.target;
  const inField = t && (t.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName));
  if (!inField && !dlg.open && !tkt.open && !e.metaKey && !e.ctrlKey && !e.altKey && e.key.toLowerCase() === 'n') { e.preventDefault(); openNew(); }
});

form.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = $('#submit');
  if (btn.disabled) return;
  const title = form.title.value.trim();
  if (!title) { $('#addErr').textContent = 'Give it a title.'; form.title.focus(); return; }
  btn.disabled = true; $('#addErr').textContent = '';
  let created = null;
  try {
    btn.textContent = 'Adding…';
    created = await api('POST', '/api/items', {kind, title, body: form.body.value, priority: form.priority.value,
      assignee: form.assignee.value, tags: form.tags.value, project: form.project.value.trim()}, true);
    if (newStatus !== 'open') await api('PATCH', `/api/items/${created.ref}`, {status: newStatus}, true);
    for (let i = 0; i < pending.length; i++) {
      btn.textContent = `Uploading ${i + 1} of ${pending.length}…`;
      await uploadImage(created.id, pending[i].file);
    }
    dlg.close();
  } catch (err) {
    if (created) {  // the item exists; don't let a retry create a duplicate
      dlg.close();
      alert(`Added ${created.ref}, but a screenshot didn't upload: ${err.message} Open ${created.ref} to try again.`);
    } else {
      $('#addErr').textContent = err.message;
    }
  } finally {
    btn.disabled = false; setKind(kind);
    refresh(true);
  }
});

