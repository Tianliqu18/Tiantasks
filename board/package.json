{
  "name": "tiantasks-board",
  "private": true,
  "type": "module",
  "description": "Terminal kanban for Tiantasks (React + Ink). Built into one file: dist/board.mjs",
  "scripts": {
    "build": "esbuild src/board.jsx --bundle --platform=node --format=esm --target=node18 --minify --outfile=dist/board.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --define:process.env.NODE_ENV='\"production\"' --alias:react-devtools-core=./src/empty.js"
  },
  "dependencies": {
    "ink": "5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
